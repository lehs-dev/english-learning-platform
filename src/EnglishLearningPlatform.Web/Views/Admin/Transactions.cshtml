@using EnglishLearningPlatform.Application.Administration
@model AdminPage<AdminTransaction>
@{
    ViewData["Title"] = "Quản trị · Giao dịch";
    var selected = ViewData["Status"] as PaymentStatus?;
    static string StatusLabel(PaymentStatus? status) => status switch
    {
        PaymentStatus.Succeeded => "Đã thanh toán",
        PaymentStatus.Failed => "Thất bại",
        PaymentStatus.Cancelled => "Đã hủy",
        _ => "Chờ thanh toán"
    };
}
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="admin-page">
<header class="admin-heading"><div><h1>Giao dịch thanh toán</h1><p>Tra cứu đơn hàng và đối chiếu trạng thái thanh toán.</p></div></header>
<partial name="_AdminNav" />
<section class="admin-surface">
    <div asp-validation-summary="All" class="notice error" role="alert"></div>
<form method="get" asp-action="Transactions" class="admin-filters">
        <div class="admin-search"><label for="search">Tìm giao dịch</label><input id="search" name="search" value="@Model.Search" maxlength="120" placeholder="Email, khóa học hoặc mã đơn…" /></div>
        <div><label for="status">Trạng thái thanh toán</label><select id="status" name="status"><option value="">Tất cả</option>@foreach (var status in Enum.GetValues<PaymentStatus>()) { <option value="@status" selected="@(selected == status)">@StatusLabel(status)</option> }</select></div>
        <div class="admin-date-filter"><label for="fromDate">Ngày tạo giao dịch từ</label><input type="date" id="fromDate" name="fromDate" value="@ViewData["FromDate"]" min="0001-01-02" max="9999-12-30" /></div>
        <div class="admin-date-filter"><label for="toDate">Đến ngày</label><input type="date" id="toDate" name="toDate" value="@ViewData["ToDate"]" min="0001-01-02" max="9999-12-30" /></div>
        <div class="admin-filter-actions"><button class="button" type="submit">Tìm kiếm</button><a asp-action="Transactions">Đặt lại</a></div>
    </form>
    <div class="admin-list-heading"><h2>Đơn hàng <span class="admin-count">@Model.Total</span></h2><span>Thời gian Việt Nam · UTC+7</span></div>
    @if (Model.Items.Count == 0) { <div class="admin-empty"><h3>Chưa có giao dịch phù hợp</h3><p>Thử tìm theo email học viên hoặc đặt lại bộ lọc.</p></div> }
    else
    {
        <div class="admin-table-wrap"><table class="admin-table admin-responsive"><caption class="visually-hidden">Giao dịch thanh toán, trang @Model.Page trên @Model.Pages</caption><thead><tr><th scope="col">Mã đơn</th><th scope="col">Học viên</th><th scope="col">Khóa học</th><th scope="col">Số tiền</th><th scope="col">Ngày tạo</th><th scope="col">Trạng thái</th><th scope="col">Ngày thanh toán</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            <tr><td data-label="Mã đơn"><code class="admin-order-id">@item.OrderId</code></td><td data-label="Học viên">@item.StudentEmail</td><td data-label="Khóa học"><strong>@item.CourseTitle</strong></td><td data-label="Số tiền" class="admin-amount">@item.Amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) @item.Currency</td><td data-label="Ngày tạo">@item.CreatedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td><td data-label="Trạng thái"><span class="admin-badge payment-@((item.Status ?? PaymentStatus.Pending).ToString().ToLowerInvariant())">@StatusLabel(item.Status)</span></td><td data-label="Thanh toán lúc">@(item.PaidAtUtc?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") ?? "—")</td></tr>
        }
        </tbody></table></div>
    }
    <nav class="actions admin-pagination" aria-label="Phân trang giao dịch">
        @if (Model.Page > 1) { <a class="button secondary" asp-route-fromDate="@ViewData["FromDate"]" asp-route-toDate="@ViewData["ToDate"]" asp-route-search="@Model.Search" asp-route-status="@selected" asp-route-page="@(Model.Page - 1)"><svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>Trước</a> }
        <span aria-current="page">Trang @Model.Page / @Model.Pages</span>
        @if (Model.Page < Model.Pages) { <a class="button secondary" asp-route-fromDate="@ViewData["FromDate"]" asp-route-toDate="@ViewData["ToDate"]" asp-route-search="@Model.Search" asp-route-status="@selected" asp-route-page="@(Model.Page + 1)">Sau<svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a> }
    </nav>
</section>
</div>
