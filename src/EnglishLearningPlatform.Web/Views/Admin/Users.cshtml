@using EnglishLearningPlatform.Application.Administration
@model AdminPage<AdminUser>
@{
    ViewData["Title"] = "Quản trị · Tài khoản";
    var selected = ViewData["Status"] as AccountStatus?;
    static string StatusLabel(AccountStatus status) => status switch { AccountStatus.Active => "Đang hoạt động", AccountStatus.Locked => "Đã khóa", _ => "Đã vô hiệu hóa" };
}
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="page-heading"><div><p class="eyebrow">ESTUDY · QUẢN TRỊ</p><h1>Trạng thái tài khoản</h1><p class="muted">Tra cứu tài khoản, vai trò và trạng thái hoạt động.</p></div><a class="button secondary" asp-action="Transactions">Giao dịch thanh toán</a></div>
<section class="panel">
    <form method="get" asp-action="Users" class="admin-filters">
        <div><label for="search">Họ tên hoặc email</label><input id="search" name="search" value="@Model.Search" maxlength="120" /></div>
        <div><label for="status">Trạng thái tài khoản</label><select id="status" name="status"><option value="">Tất cả</option>@foreach (var status in Enum.GetValues<AccountStatus>()) { <option value="@status" selected="@(selected == status)">@StatusLabel(status)</option> }</select></div>
        <button class="button" type="submit">Tra cứu</button><a asp-action="Users">Xóa bộ lọc</a>
    </form>
    <p class="muted">Tìm thấy @Model.Total tài khoản. Thời gian hiển thị theo giờ Việt Nam (UTC+7).</p>
    @if (Model.Items.Count == 0) { <p class="empty">Không có tài khoản phù hợp.</p> }
    else
    {
        <div class="admin-table-wrap"><table class="admin-table"><caption class="visually-hidden">Trạng thái tài khoản, trang @Model.Page trên @Model.Pages</caption><thead><tr><th scope="col">Họ tên</th><th scope="col">Email</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col">Ngày tạo</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            <tr><td>@item.FullName</td><td>@item.Email</td><td>@item.Role</td><td>@StatusLabel(item.Status)</td><td>@item.CreatedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td></tr>
        }
        </tbody></table></div>
    }
    <nav class="actions admin-pagination" aria-label="Phân trang tài khoản">
        @if (Model.Page > 1) { <a class="button secondary" asp-route-search="@Model.Search" asp-route-status="@selected" asp-route-page="@(Model.Page - 1)">← Trước</a> }
        <span aria-current="page">Trang @Model.Page / @Model.Pages</span>
        @if (Model.Page < Model.Pages) { <a class="button secondary" asp-route-search="@Model.Search" asp-route-status="@selected" asp-route-page="@(Model.Page + 1)">Sau →</a> }
    </nav>
</section>
