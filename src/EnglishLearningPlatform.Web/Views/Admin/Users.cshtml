@using EnglishLearningPlatform.Application.Administration
@using EnglishLearningPlatform.Domain.Enums
@model AdminPage<AdminUser>
@{
    ViewData["Title"] = "Quản trị · Tài khoản";
    var selected = ViewData["Status"] as AccountStatus?;
    static string StatusLabel(AccountStatus status) => status switch
    {
        AccountStatus.Active => "Đang hoạt động",
        AccountStatus.Locked => "Đã khóa",
        _ => "Đã vô hiệu hóa"
    };

    // KPI Metrics calculation
    var totalAccounts = Model.Total;
    var activeUsers = Model.Items.Count(u => u.Status == AccountStatus.Active);
    var lockedUsers = Model.Items.Count(u => u.Status == AccountStatus.Locked);
    var disabledUsers = Model.Items.Count(u => u.Status == AccountStatus.Disabled);
    var blockedUsers = lockedUsers + disabledUsers;

    var studentCount = Model.Items.Count(u => u.Role.Contains("Student", StringComparison.OrdinalIgnoreCase));
    var teacherCount = Model.Items.Count(u => u.Role.Contains("Teacher", StringComparison.OrdinalIgnoreCase));
    var adminCount = Model.Items.Count(u => u.Role.Contains("Admin", StringComparison.OrdinalIgnoreCase));
}
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }

<div class="page-heading">
    <div>
        <p class="eyebrow">ESTUDY · QUẢN TRỊ</p>
        <h1>Trạng thái tài khoản</h1>
        <p class="muted">Tra cứu tài khoản, vai trò và phân quyền hoạt động trong hệ thống.</p>
    </div>
    <div class="actions">
        <a class="button secondary" asp-action="Transactions">Giao dịch thanh toán</a>
    </div>
</div>

@* High-Level KPI Summary Cards *@
<section class="admin-kpi-grid" aria-label="Chỉ số tổng quan tài khoản">
    <article class="admin-kpi-card kpi-info">
        <div class="admin-kpi-header">
            <span>Tổng tài khoản</span>
            <span class="kpi-icon" aria-hidden="true">👥</span>
        </div>
        <div class="admin-kpi-value">@totalAccounts</div>
        <div class="admin-kpi-footer">
            <span class="kpi-badge badge-info">Toàn hệ thống</span>
            <span class="muted">Khớp bộ lọc</span>
        </div>
    </article>

    <article class="admin-kpi-card kpi-success">
        <div class="admin-kpi-header">
            <span>Đang hoạt động</span>
            <span class="kpi-icon" aria-hidden="true">✅</span>
        </div>
        <div class="admin-kpi-value">@activeUsers</div>
        <div class="admin-kpi-footer">
            <span class="kpi-badge badge-success">Active</span>
            <span class="muted">@(Model.Pages > 1 ? "trên trang này" : "toàn hệ thống")</span>
        </div>
    </article>

    <article class="admin-kpi-card kpi-danger">
        <div class="admin-kpi-header">
            <span>Bị khóa / Vô hiệu hóa</span>
            <span class="kpi-icon" aria-hidden="true">🔒</span>
        </div>
        <div class="admin-kpi-value">@blockedUsers</div>
        <div class="admin-kpi-footer">
            <span class="kpi-badge badge-danger">@lockedUsers khóa · @disabledUsers vô hiệu hóa</span>
        </div>
    </article>

    <article class="admin-kpi-card kpi-primary">
        <div class="admin-kpi-header">
            <span>Phân bố vai trò</span>
            <span class="kpi-icon" aria-hidden="true">🏷️</span>
        </div>
        <div class="admin-kpi-value admin-kpi-roles">
            <span class="role-stat">🎓 @studentCount</span>
            <span class="role-stat">👨‍🏫 @teacherCount</span>
            <span class="role-stat">🛡️ @adminCount</span>
        </div>
        <div class="admin-kpi-footer">
            <span class="muted">Student: @studentCount · Teacher: @teacherCount · Admin: @adminCount</span>
        </div>
    </article>
</section>

<section class="panel">
    <form method="get" asp-action="Users" class="admin-filters">
        <div>
            <label for="search">Họ tên hoặc email</label>
            <input id="search" name="search" value="@Model.Search" maxlength="120" placeholder="Tìm theo họ tên hoặc email người dùng..." />
        </div>
        <div>
            <label for="status">Trạng thái tài khoản</label>
            <select id="status" name="status">
                <option value="">Tất cả</option>
                @foreach (var status in Enum.GetValues<AccountStatus>())
                {
                    <option value="@status" selected="@(selected == status)">@StatusLabel(status)</option>
                }
            </select>
        </div>
        <button class="button" type="submit">Tra cứu</button>
        <a asp-action="Users" class="button secondary">Xóa bộ lọc</a>
    </form>

    <p class="muted">Tìm thấy @Model.Total tài khoản. Thời gian hiển thị theo giờ Việt Nam (UTC+7).</p>

    @if (Model.Items.Count == 0)
    {
        <p class="empty">Không có tài khoản phù hợp.</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <caption class="visually-hidden">Trạng thái tài khoản, trang @Model.Page trên @Model.Pages</caption>
                <thead>
                    <tr>
                        <th scope="col">Họ tên</th>
                        <th scope="col">Email</th>
                        <th scope="col">Vai trò</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge @(item.Role.Contains("Admin") ? "badge-danger" : item.Role.Contains("Teacher") ? "badge-primary" : "badge-secondary")">
                                    @item.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.Status == AccountStatus.Active ? "badge-success" : "badge-danger")">
                                    @StatusLabel(item.Status)
                                </span>
                            </td>
                            <td>@item.CreatedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <nav class="actions admin-pagination" aria-label="Phân trang tài khoản">
        @if (Model.Page > 1)
        {
            <a class="button secondary" asp-route-search="@Model.Search" asp-route-status="@selected" asp-route-page="@(Model.Page - 1)">← Trước</a>
        }
        <span aria-current="page">Trang @Model.Page / @Model.Pages</span>
        @if (Model.Page < Model.Pages)
        {
            <a class="button secondary" asp-route-search="@Model.Search" asp-route-status="@selected" asp-route-page="@(Model.Page + 1)">Sau →</a>
        }
    </nav>
</section>
