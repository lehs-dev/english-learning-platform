@model EnglishLearningPlatform.Web.Models.Admin.AdminDashboard
@{ ViewData["Title"] = "Tổng quan quản trị"; }
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
<div class="admin-page">
<header class="admin-heading"><div><p class="eyebrow">KHÔNG GIAN QUẢN TRỊ</p><h1>Tổng quan hệ thống</h1><p>Theo dõi tài khoản, giao dịch và các hoạt động quản trị.</p></div><a class="button" asp-action="CreateTeacher">＋ Tạo Teacher</a></header>
<partial name="_AdminNav" />
<div class="admin-summary">
    <article class="admin-stat"><span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span><p>Tổng tài khoản</p><strong>@Model.Users</strong><a asp-action="Users">Xem danh sách →</a></article>
    <article class="admin-stat"><span class="admin-stat-icon amber" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg></span><p>Tài khoản đã khóa</p><strong>@Model.Locked</strong><a asp-action="Users" asp-route-status="Locked">Kiểm tra tài khoản →</a></article>
    <article class="admin-stat"><span class="admin-stat-icon rose" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m6 6 12 12"/></svg></span><p>Đã vô hiệu hóa</p><strong>@Model.Disabled</strong><a asp-action="Users" asp-route-status="Disabled">Xem chi tiết →</a></article>
    <article class="admin-stat"><span class="admin-stat-icon green" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg></span><p>Đơn giao dịch</p><strong>@Model.Transactions</strong><a asp-action="Transactions">Tra cứu giao dịch →</a></article>
</div>
<section class="admin-section"><div class="admin-list-heading"><h2>Công việc quản trị</h2><span>Truy cập nhanh</span></div><div class="admin-shortcuts">
    <a asp-action="Users"><h3>Quản lý người dùng</h3><p>Tìm tài khoản, cập nhật vai trò và trạng thái hoạt động.</p><span>Mở danh sách →</span></a>
    <a asp-action="Transactions"><h3>Giao dịch thanh toán</h3><p>Đối chiếu đơn hàng, số tiền và trạng thái thanh toán.</p><span>Tra cứu đơn hàng →</span></a>
    <a asp-action="Audit"><h3>Nhật ký quản trị</h3><p>Xem người thực hiện và thay đổi trên từng tài khoản.</p><span>Xem nhật ký →</span></a>
</div></section>
</div>
