@model EnglishLearningPlatform.Web.Models.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan quản trị";
    var stats = Model.Summary;
    var monthFrom = Model.Revenue.Report.Dates.FromDate?.ToString("yyyy-MM-dd");
    var monthTo = Model.Today.ToString("yyyy-MM-dd");
    var monthLabel = Model.Today.ToString("MM/yyyy");
    var states = new[] {
        (Status: CourseStatus.Published, Label: "Công khai", Count: stats.PublishedCourses),
        (Status: CourseStatus.Draft, Label: "Bản nháp", Count: stats.DraftCourses),
        (Status: CourseStatus.Unpublished, Label: "Đã ẩn", Count: stats.UnpublishedCourses),
        (Status: CourseStatus.Archived, Label: "Lưu trữ", Count: stats.ArchivedCourses)
    };
}
@section Styles { <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-revenue.js" asp-append-version="true" defer></script> }
<div class="admin-page admin-dashboard">
<header class="admin-heading"><div><h1>Tổng quan hệ thống</h1><p>Các chỉ số toàn bộ hệ thống và doanh thu tháng @monthLabel tính đến @Model.Today.ToString("dd/MM/yyyy") · Giờ Việt Nam.</p></div></header>
@if (Model.Revenue.Report.IncludesSandboxRevenue)
{
    <p class="notice" role="status">Doanh thu tháng có giao dịch Sandbox dùng để kiểm thử.</p>
}
<div class="admin-summary">
    <article class="admin-stat" data-dashboard-tile>
        <span class="admin-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
        <dl><dt>Tổng người dùng <small>Toàn bộ</small></dt><dd>@stats.Users</dd></dl><a asp-action="Users">Xem người dùng →</a>
    </article>
    <article class="admin-stat" data-dashboard-tile>
        <span class="admin-stat-icon amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 9 9-5 9 5-9 5-9-5Zm4 3v5c3 3 7 3 10 0v-5M21 9v7"/></svg></span>
        <dl><dt>Tổng khóa học <small>Toàn bộ</small></dt><dd data-metric="courses">@stats.Courses</dd></dl><div class="admin-metric-action"><a asp-action="Courses">Xem khóa học →</a></div>
    </article>
    <article class="admin-stat" data-dashboard-tile>
        <span class="admin-stat-icon rose" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v4H9zM9 12l2 2 4-4M9 18h6"/></svg></span>
        <dl><dt>Lượt đăng ký <small>Toàn bộ</small></dt><dd data-metric="enrollments">@stats.Enrollments</dd></dl><div class="admin-metric-action"><a asp-action="Enrollments">Xem đăng ký →</a></div>
    </article>
    <article class="admin-stat admin-stat-revenue" data-dashboard-tile>
        <span class="admin-stat-icon green" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg></span>
        <dl><dt>Doanh thu <small>Tháng @monthLabel</small></dt><dd data-month-revenue>@Model.MonthRevenue.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) <small>₫</small></dd></dl>
        <a asp-action="Revenue" asp-route-fromDate="@monthFrom" asp-route-toDate="@monthTo">Xem báo cáo →</a>
    </article>
</div>
<div class="admin-dashboard-main">
<section class="admin-surface" aria-labelledby="dashboard-revenue-title">
    <div class="admin-list-heading"><h2 id="dashboard-revenue-title">Doanh thu tháng @monthLabel</h2><span>@Model.MonthPaidOrders đơn ghi nhận</span></div>
    <p class="admin-dashboard-range">@Model.Revenue.RangeLabel · Theo ngày thanh toán · VND</p>
    @if (Model.Revenue.Series.Count > 0) {
        <div class="admin-revenue-charts"><partial name="_RevenueChart" model="Model.Revenue" /></div>
    } else { <div class="admin-empty"><p>Chưa có thanh toán thành công được ghi nhận trong tháng này.</p></div> }
</section>
<section class="admin-surface" aria-labelledby="dashboard-learning-title">
    <div class="admin-list-heading"><h2 id="dashboard-learning-title">Tiến độ học tập</h2><span>Toàn bộ lượt đăng ký</span></div>
    <dl class="admin-metrics admin-metrics-pair">
        <div data-dashboard-tile><dt>Đã hoàn thành</dt><dd data-metric="completed-enrollments">@stats.CompletedEnrollments</dd><dd class="admin-metric-action"><a asp-action="Enrollments" asp-route-completed="true">Xem hoàn thành →</a></dd></div>
        <div><dt>Chưa hoàn thành</dt><dd>@stats.IncompleteEnrollments</dd><dd class="admin-metric-action"><a asp-action="Enrollments" asp-route-completed="false">Xem đang học →</a></dd></div>
    </dl>
    <div class="admin-completion-summary">
    @if (stats.CompletionRate.HasValue) {
        <div><span>Tỷ lệ hoàn thành</span><strong data-metric="completion-rate">@stats.CompletionRate.Value.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))%</strong></div>
        <progress max="@stats.Enrollments" value="@stats.CompletedEnrollments" aria-label="Tỷ lệ lượt đăng ký đã hoàn thành"></progress>
    } else { <p>Chưa có lượt đăng ký để tính tỷ lệ hoàn thành.</p> }
    </div>
</section>
</div>
<div class="admin-overview-grid">
<section class="admin-surface" aria-labelledby="dashboard-people-title">
    <div class="admin-list-heading"><h2 id="dashboard-people-title">Người dùng</h2><span>Toàn bộ tài khoản</span></div>
    <dl class="admin-metrics admin-metrics-three">
        <div data-dashboard-tile><dt>Học viên</dt><dd data-metric="students">@stats.Students</dd><dd class="admin-metric-action"><a asp-action="Users" asp-route-role="Student">Xem học viên →</a></dd></div>
        <div data-dashboard-tile><dt>Giảng viên</dt><dd data-metric="teachers">@stats.Teachers</dd><dd class="admin-metric-action"><a asp-action="Users" asp-route-role="Teacher">Xem giảng viên →</a></dd></div>
        <div data-dashboard-tile><dt>Quản trị viên</dt><dd data-metric="admins">@stats.Admins</dd><dd class="admin-metric-action"><a asp-action="Users" asp-route-role="Admin">Xem quản trị →</a></dd></div>
    </dl>
    <div class="admin-dashboard-status-links"><a asp-action="Users" asp-route-status="Locked">Đã khóa: @stats.Locked</a><a asp-action="Users" asp-route-status="Disabled">Vô hiệu hóa: @stats.Disabled</a></div>
</section>
<section class="admin-surface" aria-labelledby="dashboard-courses-title">
    <div class="admin-list-heading"><h2 id="dashboard-courses-title">Trạng thái khóa học</h2><span>Toàn bộ khóa học</span></div>
    <dl class="admin-dashboard-distribution">
    @foreach (var state in states) {
        <div data-dashboard-tile><dt class="admin-metric-action"><a asp-action="Courses" asp-route-status="@state.Status">@state.Label</a></dt><dd><meter min="0" max="@Math.Max(1, stats.Courses)" value="@state.Count" aria-label="@state.Count khóa @state.Label"></meter></dd>
        @if (state.Status == CourseStatus.Draft) { <dd data-metric="draft-courses">@state.Count</dd> }
        else { <dd><span data-metric="@(state.Status == CourseStatus.Published ? "published-courses" : null)">@state.Count</span></dd> }
        </div>
    }
    </dl>
    @if (stats.Courses == 0) { <p class="admin-metrics-note">Chưa có khóa học trong hệ thống.</p> }
</section>
<section class="admin-surface admin-dashboard-payment" aria-labelledby="dashboard-payments-title">
    <div class="admin-list-heading"><h2 id="dashboard-payments-title">Đơn hàng</h2><a asp-action="Transactions">Xem giao dịch →</a></div>
    <dl class="admin-metrics admin-metrics-pair"><div><dt>Tổng đơn hàng · Toàn bộ</dt><dd>@stats.Orders</dd></div><div><dt>Đã thanh toán thành công · Toàn bộ</dt><dd data-metric="succeeded-orders">@stats.SucceededOrders</dd></div></dl>
</section>
</div>
</div>
