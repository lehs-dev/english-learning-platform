@model EnglishLearningPlatform.Web.Models.Assessment.TeacherAssessmentScopeViewModel
@{
    Layout = "_LayoutTeacher";
    ViewData["Title"] = "Phạm vi truy cập bài kiểm tra";
    ViewData["ActiveSection"] = "assessments";
    ViewData["PageClass"] = "teacher-assessment-page";
}
@section Styles { <link rel="stylesheet" href="~/css/teacher-assessments.css" asp-append-version="true" /> }
<nav class="ta-breadcrumb" aria-label="Đường dẫn điều hướng"><a asp-controller="TeacherAssessments" asp-action="Index">Bài kiểm tra</a><span aria-hidden="true">/</span><span aria-current="page">Phạm vi truy cập</span></nav>
<div class="ta-heading"><div><h1>Phạm vi truy cập</h1><p>@Model.Editor.Title</p></div><a class="button secondary" asp-controller="TeacherAssessments" asp-action="Index">Về danh sách</a></div>
<div class="ta-config-grid">
    <section class="ta-card ta-scope-card" data-scope-editor data-can-change="@Model.Editor.CanChangeScope.ToString().ToLowerInvariant()" data-has-attempt="@Model.Editor.HasAttempt.ToString().ToLowerInvariant()" data-is-final="@Model.Editor.IsFinal.ToString().ToLowerInvariant()">
        <div class="ta-card-heading"><h2>Ai có thể làm bài kiểm tra này?</h2><span class="ta-status status-@Model.Editor.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="Model.Editor.Status" /></span></div>
        <div class="ta-current-scope"><span class="ta-kicker">PHẠM VI HIỆN TẠI</span><p data-current-scope>@(Model.Editor.CourseId.HasValue ? Model.Editor.CourseTitle : "Bài độc lập")</p></div>
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        @if (!Model.Editor.CanChangeScope)
        {
            <p class="ta-inline-note" role="status" data-scope-lock>@Model.Editor.LockReason</p>
            @if (Model.Editor.IsFinal && Model.Editor.CourseId.HasValue)
            { <a class="button secondary" asp-controller="TeacherCourseFinal" asp-action="Edit" asp-route-id="@Model.Editor.CourseId">Quản lý bài thi cuối khóa</a> }
            <p class="ta-help">Phạm vi đã khóa. Nội dung và lịch sử làm bài được giữ nguyên.</p>
        }
        else
        {
            <form id="assessment-scope-form" class="editor-form" method="post" asp-controller="TeacherAssessmentScope" asp-action="Edit" asp-route-id="@Model.Editor.AssessmentId" asp-antiforgery="true">
                <input type="hidden" name="Input.ExpectedUpdatedAtUtc" value="@(Model.Input.ExpectedUpdatedAtUtc?.ToString("O"))" />
                <div class="ta-field"><label asp-for="Input.CourseId">Chọn phạm vi truy cập</label>
                    <select asp-for="Input.CourseId" aria-describedby="scope-access-help"><option value="">Bài độc lập</option>
                        @foreach (var course in Model.Editor.Courses) { <option value="@course.Id">@course.Title — <partial name="_UiText" model="course.Status" /></option> }
                        @if (Model.Editor.CourseId.HasValue && !Model.Editor.Courses.Any(course => course.Id == Model.Editor.CourseId.Value))
                        { <option value="@Model.Editor.CourseId">@Model.Editor.CourseTitle — Khóa học hiện tại</option> }
                    </select><span asp-validation-for="Input.CourseId" class="validation"></span>
                </div>
                <p class="ta-help" id="scope-access-help">Học viên chỉ truy cập được sau khi bạn mở bài kiểm tra. Với khóa học trả phí, học viên cần hoàn tất thanh toán.</p>
                <div class="ta-form-actions"><a class="button secondary" asp-action="Edit" asp-route-id="@Model.Editor.AssessmentId">Tải lại trang</a><button type="submit" class="button">Lưu phạm vi</button></div>
            </form>
        }
    </section>
    <aside class="ta-side-column"><section class="ta-type-guide"><h2>Hai cách mở bài kiểm tra</h2><dl><div><dt>Bài độc lập</dt><dd>Mọi học viên đã đăng nhập có thể truy cập khi bài kiểm tra đang mở.</dd></div><div><dt>Gắn với khóa học</dt><dd>Chỉ học viên có đăng ký hợp lệ trong khóa học được truy cập.</dd></div></dl></section><p class="ta-inline-note">Chỉ đổi phạm vi trước lượt làm đầu tiên. Đề đang dùng làm bài thi cuối khóa cần được gỡ hoặc thay thế trước khi đổi phạm vi.</p></aside>
</div>
