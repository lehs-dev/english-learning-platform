@model CoursePage
@{
    var course = Model.Course;
    var isPublished = course.Status == CourseStatus.Published;
    var hasErrors = Model.PublishErrors.Count > 0;
}
<section class="course-manage-card course-manage-publishing" aria-labelledby="course-publish-heading">
    <h2 id="course-publish-heading">Xuất bản khóa học</h2>
    <div class="course-publish-readiness @(hasErrors ? "has-errors" : "is-ready")" id="course-publish-readiness">
        <svg class="icon" aria-hidden="true"><use href="@Url.Content(hasErrors ? "~/images/icons.svg#warning" : "~/images/icons.svg#check-circle")"></use></svg>
        <div>
            <h3>@(hasErrors ? "Chưa đủ điều kiện xuất bản" : isPublished ? "Khóa học đang được xuất bản" : "Đã đủ điều kiện xuất bản")</h3>
            @if (hasErrors)
            {
                <ul>@foreach (var error in Model.PublishErrors) { <li>@error</li> }</ul>
            }
            else { <p>@(isPublished ? "Học viên có thể tìm và tham gia khóa học trong danh mục." : "Nội dung hợp lệ. Bạn có thể xuất bản để học viên tham gia.")</p> }
        </div>
    </div>
    <div class="workspace-actions course-publish-actions">
        @if (isPublished)
        {
            <form method="post" asp-controller="TeacherCourses" asp-action="Unpublish" asp-route-id="@course.Id">
                <button class="button secondary" type="submit">Ngừng xuất bản</button>
            </form>
        }
        else
        {
            <form method="post" asp-controller="TeacherCourses" asp-action="Publish" asp-route-id="@course.Id">
                <button class="button" type="submit" disabled="@hasErrors" aria-describedby="course-publish-readiness">Xuất bản khóa học</button>
            </form>
        }
        @if (course.Status != CourseStatus.Archived)
        {
            <form method="post" asp-controller="TeacherCourses" asp-action="Archive" asp-route-id="@course.Id">
                <button class="button secondary" type="submit">Lưu trữ</button>
            </form>
        }
    </div>
    @if (Model.EnrollmentCount > 0)
    {
        <p class="muted">Khóa học có @Model.EnrollmentCount học viên. Học viên đã tham gia vẫn có thể xem nội dung khả dụng sau khi bạn ngừng xuất bản hoặc lưu trữ.</p>
    }
</section>
