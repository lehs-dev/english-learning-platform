@model ContentEditModel
@{
    var isModule = Model.Kind == ContentKind.Module;
    var isLesson = Model.Kind == ContentKind.Lesson;
    var formEncoding = Model.Kind == ContentKind.Resource ? "multipart/form-data" : null;
    var item = isModule ? "chương học" : isLesson ? "bài học" : "nội dung";
    var moduleId = isModule ? Model.Id : isLesson ? Model.ParentId : (Guid?)null;
    var lessonId = isLesson ? Model.Id : isModule ? null : (Guid?)Model.ParentId;
    var invalidVisibility = ViewData.ModelState.TryGetValue("Input.Visibility", out var visibilityState) && visibilityState.Errors.Count > 0
        ? visibilityState.AttemptedValue : !Enum.IsDefined(Model.Input.Visibility) ? ((int)Model.Input.Visibility).ToString() : null;
}
<div class="curriculum-pane-heading">
    <h2 id="curriculum-item-title">@(Model.Id.HasValue ? "Sửa " : "Thêm ")@item</h2>
</div>
<form class="editor-form curriculum-editor" method="post" enctype="@formEncoding" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@Model.CourseId" asp-route-kind="@Model.Kind" asp-route-parentId="@Model.ParentId" asp-route-id="@Model.Id">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <div>
        <label asp-for="Input.Title">Tên @item @(!isModule && !isLesson ? "(tùy chọn)" : "")</label>
        <input asp-for="Input.Title" maxlength="200" required="@(isModule || isLesson)" />
        <span asp-validation-for="Input.Title" class="validation"></span>
    </div>
    @if (isModule)
    {
        <div>
            <label asp-for="Input.Description">Mô tả chương học</label>
            <textarea asp-for="Input.Description" maxlength="4000" rows="4"></textarea>
            <span asp-validation-for="Input.Description" class="validation"></span>
        </div>
        <div>
            <label asp-for="Input.Visibility">Trạng thái hiển thị</label>
            <select asp-for="Input.Visibility">
                @if (invalidVisibility is not null) { <option value="@invalidVisibility">Lựa chọn không hợp lệ, hãy chọn lại</option> }
                <option value="@((int)ModuleVisibility.Visible)">Hiển thị</option>
                <option value="@((int)ModuleVisibility.Hidden)">Ẩn chương học</option>
            </select>
            <span asp-validation-for="Input.Visibility" class="validation"></span>
        </div>
    }
    else if (isLesson)
    {
        <div>
            <label asp-for="Input.Status">Trạng thái</label>
            <select asp-for="Input.Status" aria-describedby="lesson-status-help">
                @foreach (var choice in Enum.GetValues<LessonStatus>())
                {
                    <option value="@((int)choice)"><partial name="_UiText" model="choice" /></option>
                }
            </select>
            <span asp-validation-for="Input.Status" class="validation"></span>
            <p class="muted" id="lesson-status-help">Bài học cần có ít nhất một nội dung để xuất bản.</p>
        </div>
    }
    else
    {
        <div>
            <label asp-for="Input.ResourceType">Loại nội dung</label>
            <select asp-for="Input.ResourceType" data-resource-type>
                @foreach (var choice in Enum.GetValues<LessonResourceType>())
                {
                    <option value="@((int)choice)"><partial name="_UiText" model="choice" /></option>
                }
            </select>
            <span asp-validation-for="Input.ResourceType" class="validation"></span>
        </div>
        <div data-text-fields>
            <label asp-for="Input.ContentText">Nội dung văn bản</label>
            <textarea asp-for="Input.ContentText" rows="10"></textarea>
            <span asp-validation-for="Input.ContentText" class="validation"></span>
        </div>
        <div data-url-fields>
            <label asp-for="Input.ResourceUrl">Liên kết (HTTP/HTTPS)</label>
            <input asp-for="Input.ResourceUrl" type="url" maxlength="2048" aria-describedby="resource-url-help" />
            <span asp-validation-for="Input.ResourceUrl" class="validation"></span>
            <p class="muted" id="resource-url-help">Nhập liên kết trực tiếp đến tệp khi dùng học liệu đa phương tiện.</p>
        </div>
        <div data-media-fields>
            <label for="media-file">Tải tệp lên</label>
            @if (Model.ExistingMediaUrl is not null)
            {
                <p><a href="@Url.Content("~" + Model.ExistingMediaUrl)" target="_blank" rel="noopener noreferrer">Xem tệp đã tải lên</a>. Để trống cả hai trường để giữ tệp này.</p>
            }
            <input id="media-file" name="mediaFile" type="file" accept=".png,.jpg,.jpeg,.webp,.mp3,.wav,.ogg,.oga" aria-describedby="media-file-help" />
            @Html.ValidationMessage("mediaFile", new { @class = "validation" })
            <p class="muted" id="media-file-help">Ảnh PNG, JPEG, WebP tối đa 5 MiB. Âm thanh MP3, WAV, Ogg tối đa 10 MiB. Tệp tải lên sẽ được dùng thay liên kết.</p>
        </div>
    }
    <div class="workspace-actions curriculum-form-actions">
        <button class="button" type="submit">Lưu @item</button>
        <a class="button secondary" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@Model.CourseId" asp-route-moduleId="@moduleId" asp-route-lessonId="@lessonId">Hủy</a>
    </div>
</form>
