@model AuthoringModel
@{ var coursePage = Model.Page; var courseId = coursePage.Course.Id; }
<section class="course-manage-card course-structure" aria-labelledby="course-structure-heading">
    <div class="course-structure-heading">
        <div class="course-manage-card-heading"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg><div><h2 id="course-structure-heading">Cấu trúc và tài nguyên</h2><p>Sắp xếp chương học, bài học và tài nguyên của khóa học.</p></div></div>
        <a class="button small" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Module" asp-route-parentId="@courseId"><span class="course-manage-plus" aria-hidden="true">+</span>Thêm chương học</a>
    </div>
    @if (coursePage.Modules.Count == 0)
    {
        <div class="course-structure-empty">
            <img src="~/images/course-content-empty.svg" alt="" width="260" height="180" />
            <h3>Bắt đầu xây dựng khóa học</h3>
            <p>Tạo chương học đầu tiên, sau đó thêm bài học và tài nguyên để học viên bắt đầu học.</p>
            <a class="button" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Module" asp-route-parentId="@courseId"><span class="course-manage-plus" aria-hidden="true">+</span>Tạo chương học đầu tiên</a>
        </div>
        <ol class="course-structure-steps" aria-label="Cấu trúc nội dung khóa học">
            <li><span><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#folder")"></use></svg></span><div><strong>Chương học</strong><small>Nhóm bài học theo chủ đề</small></div></li>
            <li><span><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg></span><div><strong>Bài học</strong><small>Soạn nội dung bài học</small></div></li>
            <li><span><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#paperclip")"></use></svg></span><div><strong>Tài nguyên</strong><small>Bài đọc, liên kết, âm thanh, video</small></div></li>
        </ol>
    }
    @for (var mi = 0; mi < coursePage.Modules.Count; mi++)
    {
        var module = coursePage.Modules[mi];
        <details class="course-module module-panel" open>
            <summary class="course-module-summary"><span class="course-module-number">@((mi + 1).ToString("00"))</span><div><h3>@module.Title</h3><p>@module.Lessons.Count bài học <span aria-hidden="true">·</span> <partial name="_UiText" model="module.Visibility" /></p></div><svg class="icon course-module-chevron" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#chevron-down")"></use></svg></summary>
            <div class="course-module-body">
                @if (!string.IsNullOrWhiteSpace(module.Description)) { <p class="course-module-description preserve">@module.Description</p> }
                <div class="course-module-toolbar">
                    <a class="button small secondary" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Lesson" asp-route-parentId="@module.Id"><span aria-hidden="true">+</span>Thêm bài học</a>
                    <a class="course-manage-text-action" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Module" asp-route-parentId="@courseId" asp-route-id="@module.Id"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#pencil")"></use></svg>Sửa chương học</a>
                    <div class="course-manage-order" role="group" aria-label="Sắp xếp chương @module.Title"><partial name="_OrderButtons" model="new OrderButtonsModel(courseId, ContentKind.Module, courseId, coursePage.Modules.Select(m => m.Id).ToArray(), mi)" /></div>
                </div>
                <a class="course-manage-practice-link" asp-controller="TeacherPractices" asp-action="Create" asp-route-courseId="@courseId" asp-route-moduleId="@module.Id"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>Tạo bài luyện tập cho chương</a>
                @if (module.Lessons.Count == 0) { <p class="course-content-empty-note">Chương học chưa có bài học. Chọn “Thêm bài học” để bắt đầu.</p> }
                @for (var li = 0; li < module.Lessons.Count; li++)
                {
                    var lesson = module.Lessons[li];
                    var resources = Model.Resources.GetValueOrDefault(lesson.Id) ?? [];
                    <section class="course-lesson lesson-editor" aria-labelledby="lesson-heading-@lesson.Id">
                        <div class="course-lesson-heading"><span class="course-lesson-number">@(mi + 1).@(li + 1)</span><div><h4 id="lesson-heading-@lesson.Id">@lesson.Title</h4><p><span class="course-manage-badge status-@lesson.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="lesson.Status" /></span><span>@resources.Count tài nguyên</span></p></div></div>
                        <div class="course-lesson-toolbar">
                            <a class="course-manage-text-action" asp-controller="Learning" asp-action="Lesson" asp-route-id="@lesson.Id"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>Xem trước</a>
                            <a class="course-manage-text-action" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Lesson" asp-route-parentId="@module.Id" asp-route-id="@lesson.Id"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#pencil")"></use></svg>Sửa bài học</a>
                            <div class="course-manage-order" role="group" aria-label="Sắp xếp bài học @lesson.Title"><partial name="_OrderButtons" model="new OrderButtonsModel(courseId, ContentKind.Lesson, module.Id, module.Lessons.Select(l => l.Id).ToArray(), li)" /></div>
                        </div>
                        @if (resources.Count == 0) { <p class="course-content-empty-note">Bài học chưa có tài nguyên. Thêm nội dung trước khi xuất bản bài học.</p> }
                        @for (var ri = 0; ri < resources.Count; ri++)
                        {
                            var resource = resources[ri];
                            var resourceTitle = string.IsNullOrWhiteSpace(resource.Title) ? "Tài nguyên chưa có tiêu đề" : resource.Title;
                            var resourceIcon = resource.Type == LessonResourceType.Audio ? "headphones" : resource.Type == LessonResourceType.Text ? "book" : "paperclip";
                            var isLastPublishedResource = lesson.Status == LessonStatus.Published && resources.Count == 1;
                            <div class="course-resource resource-row">
                                <div class="course-resource-info"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#" + resourceIcon)"></use></svg><div><strong>@resourceTitle</strong><span><partial name="_UiText" model="resource.Type" /></span></div></div>
                                <div class="course-resource-actions">
                                    <a class="course-manage-text-action" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Resource" asp-route-parentId="@lesson.Id" asp-route-id="@resource.Id" aria-label="Sửa tài nguyên @resourceTitle">Sửa</a>
                                    <div class="course-manage-order" role="group" aria-label="Sắp xếp tài nguyên @resourceTitle"><partial name="_OrderButtons" model="new OrderButtonsModel(courseId, ContentKind.Resource, lesson.Id, resources.Select(r => r.Id).ToArray(), ri)" /></div>
                                    <form method="post" asp-controller="TeacherCourses" asp-action="DeleteResource" asp-route-courseId="@courseId" asp-route-lessonId="@lesson.Id" asp-route-id="@resource.Id"><button class="button small danger" type="submit" disabled="@isLastPublishedResource" aria-describedby="@(isLastPublishedResource ? "resource-lock-" + lesson.Id : null)" title="@(isLastPublishedResource ? "Chuyển bài học về bản nháp hoặc ẩn trước khi xóa tài nguyên cuối cùng." : "Xóa tài nguyên khỏi bài học")">Xóa tài nguyên</button></form>
                                </div>
                            </div>
                        }
                        @if (lesson.Status == LessonStatus.Published && resources.Count == 1)
                        {
                            <p class="course-resource-protection" id="resource-lock-@lesson.Id"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#lock")"></use></svg>Chuyển bài học về bản nháp hoặc ẩn trước khi xóa tài nguyên cuối cùng.</p>
                        }
                        <div class="course-lesson-footer">
                            <a class="button small secondary" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Resource" asp-route-parentId="@lesson.Id"><span aria-hidden="true">+</span>Thêm tài nguyên</a>
                            @* A practice belongs to a module OR a lesson, so preserve the single parent parameter. *@
                            <a class="course-manage-practice-link" asp-controller="TeacherPractices" asp-action="Create" asp-route-courseId="@courseId" asp-route-lessonId="@lesson.Id">Tạo bài luyện tập cho bài học</a>
                        </div>
                    </section>
                }
            </div>
        </details>
    }
</section>
