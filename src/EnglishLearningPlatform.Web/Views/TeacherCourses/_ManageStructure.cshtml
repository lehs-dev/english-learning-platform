@model AuthoringModel
@{
    var courseId = Model.Page.Course.Id;
    var modules = Model.Page.Modules;
    var module = Model.LessonId is { } targetLesson
        ? modules.FirstOrDefault(item => item.Lessons.Any(lesson => lesson.Id == targetLesson))
        : null;
    module ??= modules.FirstOrDefault(item => item.Id == Model.ModuleId) ?? modules.FirstOrDefault();
    var lesson = module?.Lessons.FirstOrDefault(item => item.Id == Model.LessonId);
    var resourceItems = lesson is null ? [] : Model.Resources.GetValueOrDefault(lesson.Id) ?? [];
}
<div class="curriculum-workspace">
    <aside class="curriculum-sidebar" aria-labelledby="curriculum-title">
        <div class="curriculum-sidebar-heading">
            <h2 id="curriculum-title">Cấu trúc khóa học</h2>
            <a class="button secondary small" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Module" asp-route-parentId="@courseId">+ Thêm chương</a>
        </div>
        <nav class="curriculum-tree" aria-label="Chương và bài học">
            <ul>
                @foreach (var item in modules)
                {
                    var isSelectedModule = item.Id == module?.Id && Model.Editor is not { Kind: ContentKind.Module, Id: null };
                    <li>
                        <a class="curriculum-link curriculum-module-link @(isSelectedModule ? "is-expanded" : "")" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@courseId" asp-route-moduleId="@item.Id" aria-current="@(isSelectedModule && lesson is null ? "page" : null)">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#folder")"></use></svg>
                            <span>@item.Title</span><small aria-label="@item.Lessons.Count bài học">@item.Lessons.Count</small>
                        </a>
                        @if (isSelectedModule && item.Lessons.Count > 0)
                        {
                            <ul>
                                @foreach (var itemLesson in item.Lessons)
                                {
                                    <li><a class="curriculum-link" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@courseId" asp-route-moduleId="@item.Id" asp-route-lessonId="@itemLesson.Id" aria-current="@(itemLesson.Id == lesson?.Id ? "page" : null)">
                                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg><span>@itemLesson.Title</span>
                                    </a></li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </nav>
    </aside>

    <section class="curriculum-pane" aria-labelledby="curriculum-item-title">
        @if (Model.Editor is { } editor)
        {
            <partial name="~/Views/TeacherCourses/_ContentForm.cshtml" model="editor" />
        }
        else if (module is null)
        {
            <div class="curriculum-pane-heading">
                <h2 id="curriculum-item-title">Chưa có chương học</h2>
                <p>Thêm chương đầu tiên để bắt đầu tạo bài học.</p>
            </div>
            <div class="curriculum-toolbar">
                <a class="button" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Module" asp-route-parentId="@courseId">+ Tạo chương học</a>
            </div>
        }
        else if (lesson is null)
        {
            var moduleIds = modules.Select(item => item.Id).ToArray();
            var lessonIds = module.Lessons.Select(item => item.Id).ToArray();
            <div class="curriculum-pane-heading">
                <div class="workspace-meta"><span>Chương học</span><span class="workspace-status status-@module.Visibility.ToString().ToLowerInvariant()"><partial name="_UiText" model="module.Visibility" /></span></div>
                <h2 id="curriculum-item-title">@module.Title</h2>
                @if (!string.IsNullOrWhiteSpace(module.Description)) { <p class="preserve">@module.Description</p> }
            </div>
            <div class="curriculum-toolbar" aria-label="Thao tác chương học">
                <a class="button" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Lesson" asp-route-parentId="@module.Id">+ Thêm bài học</a>
                <a class="button secondary" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Module" asp-route-parentId="@courseId" asp-route-id="@module.Id">Sửa chương</a>
                <a class="button secondary" asp-controller="TeacherPractices" asp-action="Create" asp-route-courseId="@courseId" asp-route-moduleId="@module.Id">Tạo bài luyện tập</a>
                @if (moduleIds.Length > 1)
                {
                    <div class="workspace-actions curriculum-order" role="group" aria-label="Sắp xếp chương">
                        <partial name="_OrderButtons" model="new OrderButtonsModel(courseId, ContentKind.Module, courseId, moduleIds, Array.IndexOf(moduleIds, module.Id), ModuleId: module.Id)" />
                    </div>
                }
            </div>
            @if (module.Lessons.Count == 0)
            {
                <p class="curriculum-empty">Chương này chưa có bài học.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="workspace-table">
                        <caption class="visually-hidden">Bài học trong chương @module.Title</caption>
                        <thead><tr><th scope="col">Bài học</th><th scope="col">Trạng thái</th><th scope="col">Nội dung</th><th scope="col">Thứ tự</th></tr></thead>
                        <tbody>
                            @for (var index = 0; index < module.Lessons.Count; index++)
                            {
                                var item = module.Lessons[index];
                                <tr>
                                    <th scope="row"><a asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@courseId" asp-route-moduleId="@module.Id" asp-route-lessonId="@item.Id">@item.Title</a></th>
                                    <td><span class="workspace-status status-@item.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="item.Status" /></span></td>
                                    <td>@(Model.Resources.GetValueOrDefault(item.Id)?.Count ?? 0)</td>
                                    <td><div class="workspace-actions curriculum-order" role="group" aria-label="Sắp xếp bài học @item.Title"><partial name="_OrderButtons" model="new OrderButtonsModel(courseId, ContentKind.Lesson, module.Id, lessonIds, index, ModuleId: module.Id)" /></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            var resourceIds = resourceItems.Select(item => item.Id).ToArray();
            <div class="curriculum-pane-heading">
                <div class="workspace-meta">
                    <a asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@courseId" asp-route-moduleId="@module.Id">@module.Title</a>
                    <span class="workspace-status status-@lesson.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="lesson.Status" /></span>
                </div>
                <h2 id="curriculum-item-title">@lesson.Title</h2>
            </div>
            <div class="curriculum-toolbar" aria-label="Thao tác bài học">
                <a class="button" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Resource" asp-route-parentId="@lesson.Id">+ Thêm nội dung</a>
                <a class="button secondary" asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Lesson" asp-route-parentId="@module.Id" asp-route-id="@lesson.Id">Sửa bài học</a>
                <a class="button secondary" asp-controller="Learning" asp-action="Lesson" asp-route-id="@lesson.Id">Xem trước</a>
            </div>
            @if (Model.Page.Course.Status != CourseStatus.Archived)
            {
                <div class="curriculum-toolbar" aria-label="Tạo hoạt động học tập">
                    <a class="button secondary" asp-controller="TeacherPractices" asp-action="Create" asp-route-courseId="@courseId" asp-route-lessonId="@lesson.Id">Tạo bài luyện tập</a>
                    <a class="button secondary" asp-controller="TeacherFlashcards" asp-action="Create" asp-route-courseId="@courseId" asp-route-lessonId="@lesson.Id">Tạo bộ thẻ từ vựng</a>
                    <a class="button secondary" asp-controller="TeacherAssessments" asp-action="Edit" asp-route-courseId="@courseId">Tạo bài kiểm tra khóa học</a>
                </div>
            }
            @if (resourceItems.Count == 0)
            {
                <p class="curriculum-empty">Thêm bài đọc, hình ảnh, âm thanh, video hoặc liên kết để xuất bản bài học.</p>
            }
            else
            {
                var protectedResource = lesson.Status == LessonStatus.Published && resourceItems.Count == 1;
                <div class="table-scroll">
                    <table class="workspace-table">
                        <caption class="visually-hidden">Nội dung bài học @lesson.Title</caption>
                        <thead><tr><th scope="col">Nội dung</th><th scope="col">Loại</th><th scope="col">Thao tác</th></tr></thead>
                        <tbody>
                            @for (var index = 0; index < resourceItems.Count; index++)
                            {
                                var item = resourceItems[index];
                                var title = string.IsNullOrWhiteSpace(item.Title) ? "Nội dung chưa có tiêu đề" : item.Title;
                                <tr>
                                    <th scope="row"><a asp-controller="TeacherCourses" asp-action="Content" asp-route-courseId="@courseId" asp-route-kind="Resource" asp-route-parentId="@lesson.Id" asp-route-id="@item.Id">@title</a></th>
                                    <td><partial name="_UiText" model="item.Type" /></td>
                                    <td>
                                        <div class="workspace-actions curriculum-order" role="group" aria-label="Thao tác với @title">
                                            <partial name="_OrderButtons" model="new OrderButtonsModel(courseId, ContentKind.Resource, lesson.Id, resourceIds, index, LessonId: lesson.Id)" />
                                            <form method="post" asp-controller="TeacherCourses" asp-action="DeleteResource" asp-route-courseId="@courseId" asp-route-lessonId="@lesson.Id" asp-route-id="@item.Id">
                                                <button class="button small danger" type="submit" disabled="@protectedResource" aria-describedby="@(protectedResource ? "resource-lock" : null)">Xóa nội dung</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (protectedResource)
                {
                    <p class="curriculum-empty" id="resource-lock">Chuyển bài học về bản nháp hoặc ẩn trước khi xóa nội dung cuối cùng.</p>
                }
            }
        }
    </section>
</div>
