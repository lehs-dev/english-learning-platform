@model AuthoringModel
@{
    Layout = "_LayoutTeacher";
    var course = Model.Page.Course;
    var title = Model.Tab switch
    {
        "assessments" => "Bài kiểm tra",
        "publishing" => "Xuất bản",
        _ => "Nội dung"
    };
    ViewData["Title"] = title + " · " + course.Title;
    ViewData["ActiveSection"] = "courses";
    ViewData["PageClass"] = "course-workspace-page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/course-manage.css" asp-append-version="true" />
    @if (Model.Tab == "assessments")
    {
        <link rel="stylesheet" href="~/css/teacher-assessments.css" asp-append-version="true" />
    }
}
<nav class="workspace-path" aria-label="Đường dẫn điều hướng">
    <a asp-controller="TeacherCourses" asp-action="Index">Khóa học</a><span aria-hidden="true">/</span><span aria-current="page">@title</span>
</nav>
<header class="workspace-heading">
    <div>
        <h1>@course.Title</h1>
        <div class="workspace-meta">
            <span class="workspace-status status-@course.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="course.Status" /></span>
            <span>@course.ModuleCount chương · @course.LessonCount bài học</span>
        </div>
    </div>
    <a class="button secondary" asp-controller="Learning" asp-action="Course" asp-route-id="@course.Id"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>Xem trước khóa học</a>
</header>
<partial name="~/Views/TeacherCourses/_WorkspaceTabs.cshtml" model="new CourseWorkspaceNav(course.Id, Model.Tab)" />

@switch (Model.Tab)
{
    case "assessments":
        <div class="workspace-section-heading">
            <h2>Bài kiểm tra trong khóa học</h2>
            @if (course.Status != CourseStatus.Archived)
            {
                <a class="button" asp-controller="TeacherAssessments" asp-action="Edit" asp-route-courseId="@course.Id">+ Tạo bài kiểm tra</a>
            }
        </div>
        @if (Model.Assessments.Count == 0)
        {
            <p class="workspace-empty">Khóa học chưa có bài kiểm tra. Bạn có thể gắn đề đã có trong tab Phạm vi của bài kiểm tra đó.</p>
        }
        else
        {
            <partial name="~/Views/TeacherAssessments/_AssessmentList.cshtml" model="Model.Assessments" view-data='new ViewDataDictionary(ViewData) { ["AssessmentCourseId"] = course.Id }' />
        }
        <section class="workspace-final">
            <div>
                <h2>Bài kiểm tra cuối khóa</h2>
                <p>@(Model.Page.FinalAssessmentId.HasValue ? "Đã chọn bài kiểm tra. Học viên cần đạt bài này để hoàn thành khóa học." : "Chưa chọn bài kiểm tra cuối khóa.")</p>
            </div>
            <a class="button secondary" asp-controller="TeacherCourseFinal" asp-action="Edit" asp-route-id="@course.Id">Chọn / quản lý bài kiểm tra</a>
        </section>
        break;
    case "publishing":
        <partial name="~/Views/TeacherCourses/_ManagePublishing.cshtml" model="Model.Page" />
        break;
    default:
        <partial name="~/Views/TeacherCourses/_ManageStructure.cshtml" model="Model" />
        break;
}

@section Scripts {
    @if (Model.Editor?.Kind == ContentKind.Resource)
    {
        <script src="~/js/course-editor.js" asp-append-version="true" defer></script>
    }
    @if (Model.Tab == "assessments")
    {
        <script src="~/js/teacher-assessments.js" asp-append-version="true" defer></script>
    }
}
