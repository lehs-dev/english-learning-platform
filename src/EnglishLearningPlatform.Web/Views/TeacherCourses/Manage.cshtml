@model AuthoringModel
@{
    var coursePage = Model.Page;
    var course = coursePage.Course;
    var courseId = course.Id;
    var emblem = course.Skills.Order().Cast<EnglishSkill?>().FirstOrDefault() switch
    {
        EnglishSkill.Listening => "headphones", EnglishSkill.Reading => "book",
        EnglishSkill.Vocabulary => "pencil", EnglishSkill.Grammar => "clipboard-check", _ => "graduation"
    };
    ViewData["Title"] = "Nội dung · " + course.Title;
    ViewData["PageClass"] = "course-manage-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/course-manage.css" asp-append-version="true" />
}

<nav class="course-manage-breadcrumb" aria-label="Đường dẫn điều hướng">
    <a asp-action="Index"><svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>Khóa học của tôi</a>
    <span aria-hidden="true">/</span><span aria-current="page">Quản lý nội dung</span>
</nav>

<header class="course-manage-overview">
    <div class="course-manage-overview-main">
        <span class="course-manage-emblem"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#" + emblem)"></use></svg></span>
        <div class="course-manage-course-info">
            <div class="course-manage-title"><h1>@course.Title</h1><span class="course-manage-badge status-@course.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="course.Status" /></span></div>
            <div class="course-manage-meta">
                <span class="course-manage-teacher"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>@course.Teacher</span>
                <span class="course-manage-skill-list">@foreach (var skill in course.Skills.Order()) { <span class="course-manage-skill"><partial name="_UiText" model="skill" /></span> }</span>
                <strong>@(course.IsPaid ? course.Price.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + " ₫" : "Miễn phí")</strong>
            </div>
        </div>
        <div class="course-manage-overview-actions">
            <a class="button secondary" asp-action="Edit" asp-route-id="@courseId"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#pencil")"></use></svg>Sửa thông tin / giá</a>
            <a class="button secondary" asp-controller="Learning" asp-action="Course" asp-route-id="@courseId"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>Xem trước</a>
        </div>
    </div>
    <div class="course-manage-overview-footer">
        <nav class="course-manage-tabs" aria-label="Quản lý khóa học">
            <a class="is-active" asp-action="Manage" asp-route-id="@courseId" aria-current="page"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>Nội dung khóa học</a>
            <a asp-action="Students" asp-route-id="@courseId"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#users")"></use></svg>Học viên, tiến độ và thống kê</a>
        </nav>
        <p>@course.ModuleCount chương <span aria-hidden="true">·</span> @course.LessonCount bài học</p>
    </div>
</header>

@if (coursePage.EnrollmentCount > 0)
{
    <p class="course-manage-enrollment-note"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#info")"></use></svg><span>Khóa học có @coursePage.EnrollmentCount học viên. Thay đổi cấu trúc hoặc ẩn nội dung có thể thay đổi bài học khả dụng. Quyền tham gia và tiến độ đã ghi nhận được giữ nguyên.</span></p>
}

<div class="course-manage-grid">
    <div class="course-manage-content">
        <partial name="_ManageStructure" model="Model" />
        <div class="course-manage-guidance"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#info")"></use></svg><div><h2>Xây dựng nội dung theo từng bước</h2><p>Thêm chương học, bài học và tài nguyên. Dùng nút Lên / Xuống để sắp xếp trước khi xuất bản.</p></div></div>
    </div>
    <aside class="course-manage-aside" aria-label="Xuất bản và đánh giá cuối khóa">
        <partial name="_ManagePublishing" model="coursePage" />
        <section class="course-manage-card course-manage-final" aria-labelledby="course-final-heading">
            <div class="course-manage-card-heading"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg><h2 id="course-final-heading">Bài kiểm tra cuối khóa</h2><span class="course-manage-badge">Tùy chọn</span></div>
            <p class="course-final-state"><span class="course-final-dot @(coursePage.FinalAssessmentId.HasValue ? "is-configured" : "")" aria-hidden="true"></span>@(coursePage.FinalAssessmentId.HasValue ? "Đã chọn bài kiểm tra cuối khóa" : "Chưa thiết lập bài kiểm tra")</p>
            <p>@(coursePage.FinalAssessmentId.HasValue ? "Học viên cần hoàn thành các bài học khả dụng và đạt bài kiểm tra cuối khóa để hoàn thành khóa học." : "Khóa học hiện được hoàn thành dựa trên các bài học khả dụng.")</p>
            <a class="button secondary course-final-link" asp-controller="TeacherCourseFinal" asp-action="Edit" asp-route-id="@courseId">Chọn / quản lý bài kiểm tra<svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
        </section>
        <p class="course-manage-visibility-note"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#lock")"></use></svg><span>@(course.Status switch
            {
                CourseStatus.Draft => "Bản nháp chỉ hiển thị với bạn.",
                CourseStatus.Published => "Khóa học đang hiển thị trong danh mục.",
                CourseStatus.Unpublished => "Khóa học đã ngừng xuất bản. Học viên đã tham gia vẫn có quyền học.",
                _ => "Khóa học đã được lưu trữ. Học viên đã tham gia vẫn có quyền học."
            })</span></p>
    </aside>
</div>
