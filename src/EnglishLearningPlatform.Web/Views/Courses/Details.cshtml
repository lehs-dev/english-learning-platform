@model CoursePage
@{
    ViewData["Title"] = Model.Course.Title;
    var isStudent = User.IsInRole("Student");
}
@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
}

<div class="course-details-container">
    <div class="course-details-back">
        <a class="button secondary exam-back-btn" asp-action="Index">
            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            <span>Danh mục khóa học</span>
        </a>
    </div>

    <partial name="_CourseNotice" />

    <div class="course-detail-grid">
        <div class="course-detail-information">
            <header class="course-detail-heading">
                <div class="course-tags course-detail-badges">
                    <span class="v2-pill-tag course-tag-level">
                        <partial name="_UiText" model="Model.Course.Level" />
                    </span>
                    @foreach (var skill in Model.Course.Skills)
                    {
                        <span class="v2-pill-tag course-tag-skill">
                            <partial name="_UiText" model="skill" />
                        </span>
                    }
                </div>
                <h1>@Model.Course.Title</h1>
                <p class="preserve">@Model.Course.Description</p>
                <div class="course-detail-teacher">
                    <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>
                    <span>Giảng viên hướng dẫn: <strong>@Model.Course.Teacher</strong></span>
                </div>
            </header>

            @if (isStudent)
            {
                <partial name="_CourseEnrollment" model="Model" />
            }

            <div class="course-detail-content">
                @if (!string.IsNullOrWhiteSpace(Model.Course.Objectives))
                {
                    <section class="card-v2 course-detail-objectives-card">
                        <div class="course-detail-tags course-detail-objectives-head">
                            <span class="v2-pill-tag course-tag-objective">Mục tiêu</span>
                            <h2>Bạn sẽ học được gì?</h2>
                        </div>
                        <div class="preserve course-detail-objectives-copy">
                            @Model.Course.Objectives
                        </div>
                    </section>
                }

                <section class="course-detail-syllabus" aria-labelledby="outline-title">
                    <div class="section-heading course-detail-syllabus-head">
                        <div>
                            <div class="course-detail-tags course-detail-syllabus-tags">
                                <span class="v2-pill-tag">Giáo trình</span>
                                <span class="v2-pill-tag course-tag-skill">@Model.Course.ModuleCount chương · @Model.Course.LessonCount bài học</span>
                            </div>
                            <h2 id="outline-title">Nội dung chi tiết</h2>
                        </div>
                    </div>
                    <partial name="_CourseOutline" model="Model" />
                </section>
            </div>
        </div>

        @if (!isStudent)
        {
            <partial name="_CourseEnrollment" model="Model" />
        }
    </div>
</div>
