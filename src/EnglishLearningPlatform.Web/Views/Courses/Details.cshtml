@model CoursePage
@{
    ViewData["Title"] = Model.Course.Title;
}
@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
}

<div class="course-details-container">
    <div style="margin-bottom: 20px;">
        <a class="button secondary exam-back-btn" asp-action="Index">
            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            <span>Danh mục khóa học</span>
        </a>
    </div>

    <partial name="_CourseNotice" />

    <div class="course-detail-grid">
        <!-- Left: Course Information & Syllabus -->
        <div>
            <header class="course-detail-heading">
                <div class="course-tags" style="margin-bottom: 10px;">
                    <span class="v2-pill-tag" style="background: var(--v2-pastel-periwinkle); color: var(--v2-dark);">
                        <partial name="_UiText" model="Model.Course.Level" />
                    </span>
                    @foreach (var skill in Model.Course.Skills)
                    {
                        <span class="v2-pill-tag" style="background: #FAF9FE; color: var(--v2-text-secondary);">
                            <partial name="_UiText" model="skill" />
                        </span>
                    }
                </div>
                <h1>@Model.Course.Title</h1>
                <p class="preserve">@Model.Course.Description</p>
                <div style="display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 13.5px; color: var(--v2-text-muted);">
                    <svg class="icon icon-sm" aria-hidden="true" style="width: 16px; height: 16px;"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>
                    <span>Giảng viên hướng dẫn: <strong>@Model.Course.Teacher</strong></span>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.Course.Objectives))
            {
                <section class="card-v2" style="padding: 28px 32px; margin-block: 28px; background: #FAF9FE;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                        <span class="v2-pill-tag" style="background: var(--v2-pastel-mint); color: #03543F;">Mục tiêu</span>
                        <h2 style="margin: 0; font-size: 18px; font-weight: 700; color: var(--v2-dark);">Bạn sẽ học được gì?</h2>
                    </div>
                    <div class="preserve" style="color: var(--v2-text-secondary); line-height: 1.7; font-size: 14.5px;">
                        @Model.Course.Objectives
                    </div>
                </section>
            }

            <section aria-labelledby="outline-title" style="margin-top: 24px;">
                <div class="section-heading" style="margin-bottom: 18px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <span class="v2-pill-tag">Giáo trình</span>
                            <span class="v2-pill-tag" style="background: #FAF9FE; color: var(--v2-text-muted);">@Model.Course.ModuleCount chương · @Model.Course.LessonCount bài học</span>
                        </div>
                        <h2 id="outline-title" style="margin: 0; font-size: 22px; font-weight: 800; color: var(--v2-dark);">Nội dung chi tiết</h2>
                    </div>
                </div>
                <partial name="_CourseOutline" model="Model" />
            </section>
        </div>

        <!-- Right: Enrollment Sticky Card -->
        <aside class="course-enrollment" aria-label="Thông tin tham gia">
            <partial name="_CourseCover" model="Model.Course" />
            <div class="enrollment-body">
                <partial name="_CourseSummary" model="Model.Course" />
                
                <div class="actions" style="margin-top: 18px;">
                    @if (Model.IsOwner)
                    {
                        <a class="button secondary" style="justify-content: center;" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@Model.Course.Id">Quản lý nội dung</a>
                    }

                    @if (Model.CanLearn)
                    {
                        <a class="button" style="justify-content: center; font-size: 14px;" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.Course.Id">
                            @(Model.IsOwner ? "Xem trước khóa học" : "Vào phòng học") &rarr;
                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="button" style="justify-content: center; font-size: 14px;" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Courses", new { id = Model.Course.Id })">
                            Đăng nhập để tham gia &rarr;
                        </a>
                    }
                    else if (User.IsInRole("Student"))
                    {
                        if (!Model.Course.IsPaid)
                        {
                            <form method="post" asp-action="EnrollFree" asp-route-id="@Model.Course.Id" style="margin: 0; width: 100%;">
                                <button class="button" type="submit" style="justify-content: center; font-size: 14px;">
                                    Tham gia miễn phí ngay &rarr;
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="button" style="justify-content: center; font-size: 14px;" asp-controller="Checkout" asp-action="Index" asp-route-courseId="@Model.Course.Id">
                                Đăng ký &amp; Thanh toán &rarr;
                            </a>
                        }
                    }
                </div>

                <p class="enrollment-note">
                    Bạn có thể xem đề cương trước khi tham gia. Toàn bộ nội dung bài học và tài liệu mở ngay sau khi đăng ký.
                </p>
            </div>
        </aside>
    </div>
</div>
