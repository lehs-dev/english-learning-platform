@model CatalogPage
@{
    ViewData["Title"] = "Khám phá khóa học";
}
<div class="course-library">
    <section id="discover-courses" aria-labelledby="discovery-title">
        <div class="page-heading course-library-heading">
            <div>
                <h1 id="discovery-title">Khám phá khóa học</h1>
                <p>Chọn kỹ năng và tìm khóa học phù hợp với mục tiêu của bạn.</p>
            </div>
            @if (User.IsInRole("Teacher"))
            {
                <a class="button secondary" asp-controller="TeacherCourses" asp-action="Index">Quản lý khóa học của tôi</a>
            }
        </div>
        <partial name="_CourseCatalog" model="Model" />
    </section>
</div>
@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true" defer></script>
}
