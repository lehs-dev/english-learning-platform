@model EnglishLearningPlatform.Application.TeacherAnalytics.TeacherAnalyticsPage
@{
    Layout = "_LayoutTeacher";
    ViewData["Title"] = "Thống kê lớp học";
    ViewData["ActiveSection"] = "analytics";
    string Score(decimal? value) => value.HasValue ? value.Value.ToString("0.##") + "%" : "Chưa có bài làm";
}
<header class="teacher-banner">
    <div>
        <h1>Thống kê lớp học</h1>
        <p>Kết quả được lọc theo ngày Việt Nam. Tiến độ phản ánh nội dung hiện có của khóa học.</p>
    </div>
</header>
<form method="get" class="teacher-report-panel analytics-filters">
    <label for="analytics-course">Khóa học
        <select name="CourseId" id="analytics-course">
            <option value="">Tất cả khóa học của tôi</option>
            @foreach (var course in Model.Courses)
            {
                <option value="@course.Id" selected="@(course.Id == Model.Query.CourseId)">@course.Title</option>
            }
        </select>
    </label>
    <label for="analytics-from">Từ ngày<input name="From" id="analytics-from" type="date" value="@Model.Query.From?.ToString("yyyy-MM-dd")" /></label>
    <label for="analytics-to">Đến ngày<input name="To" id="analytics-to" type="date" value="@Model.Query.To?.ToString("yyyy-MM-dd")" /></label>
    <button class="button button-primary" type="submit">Xem thống kê</button>
</form>
<dl class="teacher-report-stats" aria-label="Tổng quan lớp học">
    <div><dt>Học viên</dt><dd>@Model.StudentCount</dd><dd>@Model.EnrollmentCount lượt ghi danh</dd></div>
    <div><dt>Hoàn thành khóa học</dt><dd>@Model.CompletionPercent%</dd><dd>@Model.CompletedEnrollments lượt</dd></div>
    <div><dt>Điểm luyện tập trung bình</dt><dd>@Score(Model.AveragePracticeScore)</dd><dd>Kết quả gần nhất</dd></div>
    <div><dt>Điểm đánh giá trung bình</dt><dd>@Score(Model.AverageAssessmentScore)</dd></div>
</dl>
<div class="analytics-panels">
    <section class="teacher-report-panel" aria-labelledby="analytics-skills">
        <h2 id="analytics-skills">Điểm theo kỹ năng</h2>
        @if (Model.Skills.Count == 0)
        {
            <p>Chưa có kết quả đánh giá trong khoảng thời gian này.</p>
        }
        @foreach (var skill in Model.Skills)
        {
            <div class="analytics-skill">
                <div><strong><partial name="_UiText" model="skill.Skill" /></strong><span>@Score(skill.AverageScore)</span></div>
                <meter min="0" max="100" value="@skill.AverageScore.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="@skill.Skill">@Score(skill.AverageScore)</meter>
                <small>@skill.ResultCount kết quả đánh giá</small>
            </div>
        }
    </section>
    <section class="teacher-report-panel" aria-labelledby="analytics-difficult">
        <h2 id="analytics-difficult">Câu hỏi thường làm sai</h2>
        @if (Model.MostMissedQuestions.Count == 0)
        {
            <p>Chưa có câu trả lời sai.</p>
        }
        else
        {
            <div class="analytics-table" role="region" aria-labelledby="analytics-difficult" tabindex="0">
                <table>
                    <thead><tr><th scope="col">Câu hỏi</th><th scope="col">Số lần sai</th><th scope="col">Lượt trả lời</th></tr></thead>
                    <tbody>
                        @foreach (var question in Model.MostMissedQuestions)
                        {
                            <tr><td>@question.Content</td><td>@question.WrongCount</td><td>@question.AnswerCount</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
<section class="teacher-report-panel" aria-labelledby="analytics-students">
    <h2 id="analytics-students">Học viên và tiến độ</h2>
    @if (Model.Students.Count == 0)
    {
        <p>Chưa có học viên ghi danh.</p>
    }
    else
    {
        <div class="analytics-table" role="region" aria-labelledby="analytics-students" tabindex="0">
            <table>
                <thead><tr><th scope="col">Họ tên</th><th scope="col">Bài học hoàn thành</th><th scope="col">Luyện tập</th><th scope="col">Đánh giá</th></tr></thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr><th scope="row">@student.FullName</th><td>@student.CompletedLessons/@student.TotalLessons</td><td>@Score(student.PracticeScore)</td><td>@Score(student.AssessmentScore)</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="workspace-actions analytics-pagination" aria-label="Phân trang học viên">
            @if (Model.Query.Page > 1)
            {
                <a class="button secondary small" asp-route-Page="@(Model.Query.Page - 1)" asp-route-CourseId="@Model.Query.CourseId" asp-route-From="@Model.Query.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.Query.To?.ToString("yyyy-MM-dd")">Trang trước</a>
            }
            <span>Trang @Model.Query.Page</span>
            @if ((long)Model.Query.Page * 25 < Model.StudentRows)
            {
                <a class="button secondary small" asp-route-Page="@(Model.Query.Page + 1)" asp-route-CourseId="@Model.Query.CourseId" asp-route-From="@Model.Query.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.Query.To?.ToString("yyyy-MM-dd")">Trang sau</a>
            }
        </nav>
    }
</section>
