@model CatalogPage
@{
    var catalogController = ViewData["CatalogController"] as string ?? "Courses";
    var activeFilters = new[] { !string.IsNullOrWhiteSpace(Model.Query.Search), Model.Query.Level.HasValue,
        Model.Query.Skill.HasValue, !string.IsNullOrWhiteSpace(Model.Query.Topic), Model.Query.Teacher.HasValue,
        Model.Query.Paid.HasValue }.Count(value => value);
    var enrolledCourses = ViewData["EnrolledCoursesForCatalog"] as IReadOnlyList<CourseSummary> ?? Array.Empty<CourseSummary>();
    var compare = System.Globalization.CultureInfo.GetCultureInfo("vi-VN").CompareInfo;
    const System.Globalization.CompareOptions comparison = System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace;
    var matchingEnrolled = enrolledCourses.Where(course =>
        (string.IsNullOrWhiteSpace(Model.Query.Search) || compare.IndexOf(course.Title, Model.Query.Search, comparison) >= 0) &&
        (!Model.Query.Level.HasValue || course.Level == Model.Query.Level) &&
        (!Model.Query.Skill.HasValue || course.Skills.Contains(Model.Query.Skill.Value)) &&
        (string.IsNullOrWhiteSpace(Model.Query.Topic) || course.Topics.Any(topic => compare.Compare(topic, Model.Query.Topic, comparison) == 0)) &&
        (!Model.Query.Teacher.HasValue || course.OwnerId == Model.Query.Teacher) &&
        (!Model.Query.Paid.HasValue || course.IsPaid == Model.Query.Paid))
        .OrderBy(course => course.Progress?.CompletedAtUtc is not null)
        .ThenByDescending(course => course.Progress?.CompletedLessons ?? 0)
        .ThenBy(course => course.Title).ToArray();
    var teachers = Model.Teachers.Concat(enrolledCourses.Select(course => new TeacherOption(course.OwnerId, course.Teacher)))
        .DistinctBy(teacher => teacher.Id).OrderBy(teacher => teacher.Name).ToArray();
    var topics = Model.Topics.Concat(enrolledCourses.SelectMany(course => course.Topics))
        .Distinct(StringComparer.CurrentCultureIgnoreCase).OrderBy(topic => topic).ToArray();
}
@if (ViewData["QueryNotice"] is string notice)
{
    <div class="notice">@notice</div>
}
<div class="catalog-layout">
    <details class="catalog-filters" open data-catalog-filters>
        <summary>
            <span>Bộ lọc khóa học</span>
            <span class="catalog-filter-count">@(activeFilters > 0 ? activeFilters + " đang áp dụng" : "Tất cả khóa học")</span>
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#chevron-down")"></use></svg>
        </summary>
        <form asp-controller="@catalogController" asp-action="Index" asp-fragment="discover-courses" method="get" class="filter-grid" role="search" aria-label="Bộ lọc khóa học">
            <label class="filter-search">
                Tên khóa học
                <input type="search" name="Search" value="@Model.Query.Search" maxlength="200" placeholder="Tìm theo tên khóa học..." />
            </label>
            <label>
                Cấp độ
                <select name="Level">
                    <option value="">Tất cả cấp độ</option>
                    @foreach (var level in Enum.GetValues<CourseLevel>())
                    {
                        <option value="@level" selected="@(Model.Query.Level == level)"><partial name="_UiText" model="level" /></option>
                    }
                </select>
            </label>
            <label>
                Kỹ năng
                <select name="Skill">
                    <option value="">Tất cả kỹ năng</option>
                    @foreach (var skill in Enum.GetValues<EnglishSkill>())
                    {
                        <option value="@skill" selected="@(Model.Query.Skill == skill)"><partial name="_UiText" model="skill" /></option>
                    }
                </select>
            </label>
            <label>
                Chủ đề
                <select name="Topic">
                    <option value="">Tất cả chủ đề</option>
                    @foreach (var topic in topics)
                    {
                        <option value="@topic" selected="@(Model.Query.Topic == topic)">@topic</option>
                    }
                </select>
            </label>
            <label>
                Giảng viên
                <select name="Teacher">
                    <option value="">Tất cả giảng viên</option>
                    @foreach (var teacher in teachers)
                    {
                        <option value="@teacher.Id" selected="@(Model.Query.Teacher == teacher.Id)">@teacher.Name</option>
                    }
                </select>
            </label>
            <label>
                Học phí
                <select name="Paid">
                    <option value="">Tất cả</option>
                    <option value="false" selected="@(Model.Query.Paid == false)">Miễn phí</option>
                    <option value="true" selected="@(Model.Query.Paid == true)">Có phí</option>
                </select>
            </label>
            <div class="actions catalog-filter-actions">
                <button class="button" type="submit">Lọc khóa học</button>
                @if (activeFilters > 0)
                {
                    <a class="button secondary" asp-controller="@catalogController" asp-action="Index" asp-fragment="discover-courses">Đặt lại</a>
                }
            </div>
        </form>
    </details>
    <section class="catalog-results" id="catalog-results" aria-label="Kết quả khóa học">
        <p class="catalog-result-count" role="status">
            Hiển thị <strong>@(matchingEnrolled.Length + Model.Courses.Count)</strong> / @(matchingEnrolled.Length + Model.Total) khóa học
            @if (Model.Pages > 1)
            {
                <text> · Trang @Model.Query.Page / @Model.Pages của các khóa chưa tham gia</text>
            }
        </p>
        @if (matchingEnrolled.Length == 0 && Model.Courses.Count == 0)
        {
            <div class="catalog-empty">
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#search")"></use></svg>
                <h3>@(activeFilters > 0 ? "Chưa tìm thấy khóa học phù hợp" : "Khóa học đang được chuẩn bị")</h3>
                <p>@(activeFilters > 0 ? "Thử đổi từ khóa hoặc đặt lại bộ lọc để xem thêm khóa học." : "Khóa học mới sẽ xuất hiện tại đây khi được cập nhật.")</p>
                @if (activeFilters > 0)
                {
                    <a class="button secondary" asp-controller="@catalogController" asp-action="Index" asp-fragment="discover-courses">Xem tất cả khóa học</a>
                }
            </div>
        }
        else
        {
            <div class="course-grid">
                @foreach (var course in matchingEnrolled)
                {
                    <partial name="_EnrolledCourseCard" model="course" />
                }
                @foreach (var course in Model.Courses)
                {
                    <partial name="_DiscoveryCourseCard" model="course" />
                }
            </div>
            @if (Model.Pages > 1)
            {
                <nav class="actions pagination" aria-label="Phân trang khóa học">
                    @foreach (var pageNumber in new[] { Model.Query.Page - 1, Model.Query.Page + 1 }.Where(page => page >= 1 && page <= Model.Pages))
                    {
                        <a class="button secondary" asp-controller="@catalogController" asp-action="Index" asp-fragment="discover-courses" asp-route-Page="@pageNumber" asp-route-Search="@Model.Query.Search" asp-route-Level="@Model.Query.Level" asp-route-Skill="@Model.Query.Skill" asp-route-Topic="@Model.Query.Topic" asp-route-Teacher="@Model.Query.Teacher" asp-route-Paid="@Model.Query.Paid">
                            @(pageNumber < Model.Query.Page ? "← Trang trước" : "Trang sau →")
                        </a>
                    }
                </nav>
            }
        }
    </section>
</div>
