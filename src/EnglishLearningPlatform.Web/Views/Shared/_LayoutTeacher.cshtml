@{
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant();
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
    var activeSection = routeController switch
    {
        "teacherquestionbank" => "questionbank",
        "teacherpractices" => "practices",
        "teachercourses" when string.Equals(routeAction, "Students", StringComparison.OrdinalIgnoreCase) => "analytics",
        "teachercourses" or "learning" => ViewData["ActiveSection"] as string ?? "courses",
        _ => ViewData["ActiveSection"] as string ?? ""
    };
    var currentTitle = ViewData["Title"] as string ?? "Studio Giảng viên";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e293b" />
    <title>@currentTitle - Estudy Studio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/question-bank.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role-layouts.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="teacher-studio @ViewData["PageClass"]">
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>

    <div class="studio-shell">
        @* Teacher Studio Sidebar *@
        <aside class="studio-sidebar teacher-sidebar" id="studio-sidebar" aria-label="Thanh điều hướng Teacher Studio">
            <div class="studio-sidebar-header">
                <a class="brand studio-brand" asp-controller="TeacherCourses" asp-action="Index" aria-label="Estudy Teacher Studio">
                    <svg class="brand-icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#graduation")"></use></svg>
                    <span>Estudy</span>
                    <span class="role-badge studio-badge">Studio</span>
                </a>
                <button class="sidebar-close icon-button" type="button" data-sidebar-close aria-label="Đóng menu Studio">✕</button>
            </div>

            <nav class="studio-nav" aria-label="Menu chức năng giảng viên">
                <div class="studio-nav-group">
                    <span class="studio-nav-label">QUẢN LÝ NỘI DUNG</span>
                    <a class="studio-nav-link @(activeSection is "courses" or "teachercourses" ? "is-active" : "")"
                       asp-controller="TeacherCourses"
                       asp-action="Index"
                       aria-current="@(activeSection is "courses" or "teachercourses" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#graduation")"></use></svg>
                        <span>Khóa học</span>
                    </a>
                    <a class="studio-nav-link @(activeSection is "questionbank" or "questions" ? "is-active" : "")"
                       asp-controller="TeacherQuestionBank"
                       asp-action="Index"
                       aria-current="@(activeSection is "questionbank" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#search")"></use></svg>
                        <span>Ngân hàng câu hỏi</span>
                    </a>
                    @* Mở danh sách Practice của Teacher.
                    Trong trang danh sách đã có nút tạo Practice Draft. *@
                    <a class="studio-nav-link @(activeSection is "practices" or "teacherpractices" ? "is-active" : "")"
                    asp-controller="TeacherPractices"
                    asp-action="Index"
                    aria-current="@(activeSection is "practices" ? "page" : null)">
                        <svg class="icon" aria-hidden="true">
                            <use href="@Url.Content("~/images/icons.svg#check-circle")"></use>
                        </svg>
                        <span>Bài luyện tập</span>
                    </a>
                </div>

                <div class="studio-nav-group">
                    <span class="studio-nav-label">HỌC VIÊN & BÁO CÁO</span>
                    <a class="studio-nav-link @(activeSection == "analytics" ? "is-active" : "")"
                       asp-controller="TeacherCourses"
                       asp-action="Index"
                       asp-fragment="statistics"
                       aria-current="@(activeSection == "analytics" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>
                        <span>Thống kê & Học viên</span>
                    </a>
                </div>

                <div class="studio-nav-group studio-nav-group--bottom">
                    <span class="studio-nav-label">LIÊN KẾT NHANH</span>
                    <a class="studio-nav-link" asp-controller="Courses" asp-action="Index">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        <span>Xem danh mục khóa học</span>
                    </a>
                    <a class="studio-nav-link" asp-controller="Profile" asp-action="Index">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>
                        <span>Hồ sơ giảng viên</span>
                    </a>
                </div>
            </nav>
        </aside>

        <div class="sidebar-backdrop" data-sidebar-backdrop aria-controls="studio-sidebar" hidden></div>

        @* Main Content Area with Top Header *@
        <div class="studio-main-wrapper">
            <header class="studio-topbar">
                <div class="studio-topbar-left">
                    <button class="mobile-sidebar-toggle icon-button" type="button" data-sidebar-toggle aria-controls="studio-sidebar" aria-expanded="false" aria-label="Mở menu Studio">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#menu")"></use></svg>
                    </button>
                    <span class="studio-topbar-title">Teacher Studio</span>
                </div>

                <div class="studio-topbar-actions">
                    <a class="button button-primary button-small studio-create-cta"
                       asp-controller="TeacherCourses"
                       asp-action="Edit">
                        + Tạo khóa học
                    </a>
                    @await Component.InvokeAsync("AccountMenu")
                </div>
            </header>

            @* Breadcrumbs Section *@
            @if (IsSectionDefined("Breadcrumbs"))
            {
                <nav class="studio-breadcrumbs-bar" aria-label="Đường dẫn điều hướng">
                    @await RenderSectionAsync("Breadcrumbs", required: false)
                </nav>
            }

            @* Notification & Alert Area *@
            @{
                var successNotice = TempData["Success"] as string ?? TempData["SuccessMessage"] as string;
                var errorNotice = TempData["Error"] as string ?? TempData["ErrorMessage"] as string;
            }
            @if (!string.IsNullOrWhiteSpace(successNotice) || !string.IsNullOrWhiteSpace(errorNotice))
            {
                <div class="studio-notifications" aria-live="polite">
                    @if (!string.IsNullOrWhiteSpace(successNotice))
                    {
                        <div class="alert alert-success" role="status">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                            <span>@successNotice</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorNotice))
                    {
                        <div class="alert alert-error" role="alert">
                            <span>@errorNotice</span>
                        </div>
                    }
                </div>
            }

            @* Studio Body *@
            <main class="studio-main page-content" id="main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
