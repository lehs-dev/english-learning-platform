@model ResourceContent
<section class="resource-content" id="resource-@Model.Id"><div class="resource-type"><partial name="_UiText" model="Model.Type" /></div><h2>@if (string.IsNullOrWhiteSpace(Model.Title)) { <partial name="_UiText" model="Model.Type" /> } else { @Model.Title }</h2>
@if (Model.Type == LessonResourceType.Text) { <div class="preserve reading-copy">@Model.Text</div> }
else if (EnglishLearningPlatform.Domain.Entities.CourseRules.ValidResource(Model.Type, Model.Text, Model.Url)) {
    if (Model.Type == LessonResourceType.Audio) { <audio controls preload="none" src="@Model.Url" aria-label="@(Model.Title ?? "Âm thanh bài học")">Trình duyệt không hỗ trợ âm thanh.</audio> }
    if (Model.Type == LessonResourceType.Video) { <video controls preload="none" src="@Model.Url" aria-label="@(Model.Title ?? "Video bài học")">Trình duyệt không hỗ trợ video.</video> }
    <a class="text-action" href="@Model.Url" target="_blank" rel="noopener noreferrer">Mở tài nguyên trong thẻ mới<svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
} else { <p class="notice error">Tài nguyên chưa có đường dẫn hợp lệ.</p> }</section>
