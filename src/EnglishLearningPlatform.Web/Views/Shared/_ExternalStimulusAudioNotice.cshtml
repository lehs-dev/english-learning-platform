@model string
@if (!string.IsNullOrWhiteSpace(Model)
    && !EnglishLearningPlatform.Application.Stimuli.StimulusAudioUrl.TryGetHash(Model, out _))
{
    <p class="notice">Audio từ máy chủ bên ngoài: nội dung hoặc khả năng phát có thể thay đổi ngoài quyền kiểm soát của ứng dụng. URL lịch sử được giữ nguyên; đề mới cần dùng audio upload bất biến.</p>
}
