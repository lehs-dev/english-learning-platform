<footer class="site-footer">
    <div class="container footer-inner">
        <p>&copy; @DateTime.UtcNow.Year Estudy. Cùng bạn học tiếng Anh mỗi ngày.</p>
        <nav class="footer-links" aria-label="Liên kết cuối trang">
            <a asp-controller="Courses" asp-action="Index">Khám phá khóa học</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </nav>
    </div>
</footer>
