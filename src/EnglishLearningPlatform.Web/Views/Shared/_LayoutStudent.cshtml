@{
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant();
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
    var routeSection = routeController switch
    {
        "learning" when string.Equals(routeAction, "Dashboard", StringComparison.OrdinalIgnoreCase) => "dashboard",
        "learning" => "courses",
        "practice" => "practice",
        "assessment" => "assessment",
        "checkout" when string.Equals(routeAction, "History", StringComparison.OrdinalIgnoreCase) => "history",
        _ => ""
    };
    var activeSection = ViewData["ActiveSection"] as string ?? routeSection;
    var currentTitle = ViewData["Title"] as string ?? "Học tập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#176bff" />
    <title>@currentTitle - Estudy Học viên</title>
    <partial name="_BrandHead" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/role-layouts.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="canvas-body student-workspace-v2 @ViewData["PageClass"]">
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>

    <div class="dashboard-canvas-frame">
        @* 1. Left Icon Rail (82px) *@
        <aside class="dashboard-icon-rail" aria-label="Thanh điều hướng học tập">
            <a asp-controller="Learning" asp-action="Dashboard" class="rail-logo-glyph" title="Estudy V2 - Bàn học" aria-label="Estudy V2 - Bàn học">
                <svg viewBox="0 0 44 44" fill="none" style="width:24px; height:24px;" aria-hidden="true">
                    <rect x="6" y="6" width="14" height="20" rx="7" fill="#FFFFFF" />
                    <rect x="24" y="18" width="14" height="20" rx="7" fill="#FFFFFF" />
                    <rect x="6" y="24" width="20" height="14" rx="7" fill="#FF71CE" opacity="0.9" />
                    <rect x="18" y="6" width="20" height="14" rx="7" fill="#FF71CE" opacity="0.9" />
                </svg>
            </a>

            <nav class="rail-nav-group">
                <a class="rail-btn @(activeSection == "dashboard" ? "active is-active" : "")"
                   asp-controller="Learning"
                   asp-action="Dashboard"
                   title="Bàn học"
                   aria-label="Bàn học"
                   aria-current="@(activeSection == "dashboard" ? "page" : null)">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#dashboard")"></use></svg>
                </a>
                <a class="rail-btn @(activeSection is "courses" or "mycourses" or "learning" ? "active is-active" : "")"
                   asp-controller="Learning"
                   asp-action="Index"
                   title="Khóa học của tôi"
                   aria-label="Khóa học của tôi"
                   aria-current="@(activeSection is "courses" or "mycourses" or "learning" ? "page" : null)">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                </a>
                <a class="rail-btn @(activeSection == "practice" ? "active is-active" : "")"
                   asp-controller="Learning"
                   asp-action="Dashboard"
                   asp-fragment="dashboard-practice-results"
                   title="Luyện tập"
                   aria-label="Luyện tập"
                   aria-current="@(activeSection == "practice" ? "page" : null)">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                </a>
                <a class="rail-btn @(activeSection == "assessment" ? "active is-active" : "")"
                   asp-controller="Assessment"
                   asp-action="Index"
                   title="Đánh giá năng lực"
                   aria-label="Đánh giá năng lực"
                   aria-current="@(activeSection == "assessment" ? "page" : null)">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>
                </a>
                <a class="rail-btn @(activeSection is "history" or "transactions" ? "active is-active" : "")"
                   asp-controller="Checkout"
                   asp-action="History"
                   title="Lịch sử giao dịch"
                   aria-label="Lịch sử giao dịch"
                   aria-current="@(activeSection is "history" or "transactions" ? "page" : null)">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#history")"></use></svg>
                </a>
            </nav>

            <div class="rail-footer-group">
                <a class="rail-btn" asp-controller="Profile" asp-action="Index" title="Hồ sơ cá nhân" aria-label="Hồ sơ cá nhân">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    <button class="rail-btn" type="submit" title="Đăng xuất" aria-label="Đăng xuất">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#logout")"></use></svg>
                    </button>
                </form>
            </div>
        </aside>

        @* 2. Main Dashboard Workspace *@
        <div class="dashboard-main-area">
            @* Clean Topbar *@
            <header class="dashboard-topbar-clean">
                <form class="dashboard-search-clean" asp-controller="Courses" asp-action="Index" method="get" role="search">
                    <svg class="icon search-icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#search")"></use></svg>
                    <label class="visually-hidden" for="student-course-search">Tìm khóa học</label>
                    <input id="student-course-search" type="search" name="Search" value="@(Context.Request.Query["Search"].ToString())" maxlength="200" placeholder="Tìm kiếm bài học, khóa học..." />
                </form>

                <div class="dashboard-topbar-actions">
                    <a asp-controller="Courses" asp-action="Index" class="btn-outline-dark" style="padding: 8px 16px; font-size: 12.5px;">
                        Khám phá khóa học
                    </a>
                    @await Component.InvokeAsync("AccountMenu")
                </div>
            </header>

            @* Optional Breadcrumbs *@
            @if (IsSectionDefined("Breadcrumbs"))
            {
                <nav class="workspace-breadcrumbs-bar" aria-label="Đường dẫn điều hướng">
                    @await RenderSectionAsync("Breadcrumbs", required: false)
                </nav>
            }

            @* Notification & Flash Messages Area *@
            @{
                var successMsg = TempData["Success"] as string ?? TempData["AssessmentSuccess"] as string ?? TempData["SuccessMessage"] as string;
                var errorMsg = TempData["Error"] as string ?? TempData["AssessmentError"] as string ?? TempData["ErrorMessage"] as string;
            }
            @if (!string.IsNullOrWhiteSpace(successMsg) || !string.IsNullOrWhiteSpace(errorMsg))
            {
                <div class="notification-area" aria-live="polite">
                    @if (!string.IsNullOrWhiteSpace(successMsg))
                    {
                        <div class="alert alert-success" role="status">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                            <span>@successMsg</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorMsg))
                    {
                        <div class="alert alert-error" role="alert">
                            <span>@errorMsg</span>
                        </div>
                    }
                </div>
            }

            @* Main Learning Content *@
            <main class="student-content page-content" id="main-content" tabindex="-1">
                @RenderBody()
            </main>

            <partial name="_SiteFooter" />
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
