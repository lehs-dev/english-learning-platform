@model CourseActivities

<section class="learning-surface course-room-group course-activities-panel" aria-labelledby="course-activities-title">
    <h2 id="course-activities-title">Luyện tập &amp; đánh giá</h2>
    @if (Model.Practices.Count == 0 && Model.Assessments.Count == 0)
    {
        <p class="muted">Chưa có bài luyện hoặc bài đánh giá khả dụng tại đây.</p>
    }
    else
    {
        <ul class="learning-activity-list">
            @foreach (var practice in Model.Practices)
            {
                <li>
                    <a class="learning-activity" asp-controller="Practice" asp-action="Take" asp-route-id="@practice.Id">
                        <span class="learning-emblem is-teal">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                        </span>
                        <span class="learning-activity-copy"><strong>@practice.Title</strong><small>@practice.QuestionCount câu hỏi</small></span>
                        <span class="learning-activity-cta">
                            Luyện ngay <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </span>
                    </a>
                </li>
            }
            @foreach (var assessment in Model.Assessments)
            {
                <li>
                    <a class="learning-activity" asp-controller="Assessment" asp-action="Take" asp-route-id="@assessment.Id" asp-route-attemptId="@assessment.ActiveAttemptId">
                        <span class="learning-emblem">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>
                        </span>
                        <span class="learning-activity-copy">
                            <strong>@assessment.Title</strong>
                            <small>@assessment.QuestionCount câu hỏi · @assessment.DurationMinutes phút</small>
                        </span>
                        <span class="learning-activity-cta">
                            @(assessment.ActiveAttemptId.HasValue ? "Tiếp tục" : "Làm bài")
                            <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
</section>
