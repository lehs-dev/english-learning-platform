@model CoursePage
@if (!Model.Modules.Any(m => m.Lessons.Count > 0)) { <p class="empty">Chưa có nội dung khả dụng.</p> }
<div class="course-outline">
@for (var mi = 0; mi < Model.Modules.Count; mi++)
{
    var module = Model.Modules[mi];
    <section class="outline-module"><div class="outline-heading"><span class="module-number">@((mi + 1).ToString("00"))</span><div><h3>@if (Model.CanLearn) { <a asp-controller="Learning" asp-action="Module" asp-route-id="@module.Id">@module.Title</a> } else { @module.Title }</h3><p class="muted">@module.Lessons.Count bài học @if (Model.IsOwner) { <span>· <partial name="_UiText" model="module.Visibility" /></span> }</p></div></div>
    @if (!string.IsNullOrWhiteSpace(module.Description)) { <p class="preserve outline-description">@module.Description</p> }
    <ul class="outline-lessons">@foreach (var lesson in module.Lessons) { <li><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#" + (lesson.IsCompleted ? "check-circle" : "graduation"))"></use></svg><div>@if (Model.CanLearn) { <a asp-controller="Learning" asp-action="Lesson" asp-route-id="@lesson.Id">@lesson.Title</a> } else { <span>@lesson.Title</span> }<small class="muted">@if (Model.IsOwner) { <partial name="_UiText" model="lesson.Status" /> } else if (Model.Progress is not null) { @(lesson.IsCompleted ? "Đã hoàn thành" : "Chưa hoàn thành") } else { <text>Tham gia khóa học để xem bài</text> }</small></div></li> }</ul></section>
}
</div>
