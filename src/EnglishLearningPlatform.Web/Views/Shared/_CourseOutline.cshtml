@model CoursePage
@if (!Model.Modules.Any(m => m.Lessons.Count > 0))
{
    <div class="empty">Chưa có nội dung bài học khả dụng trong khóa này.</div>
}
<div class="course-outline">
@for (var mi = 0; mi < Model.Modules.Count; mi++)
{
    var module = Model.Modules[mi];
    <section class="outline-module">
        <div class="outline-heading">
            <span class="module-number">@((mi + 1).ToString("00"))</span>
            <div style="flex: 1;">
                <h3>
                    @if (Model.CanLearn)
                    {
                        <a asp-controller="Learning" asp-action="Module" asp-route-id="@module.Id">@module.Title</a>
                    }
                    else
                    {
                        <span>@module.Title</span>
                    }
                </h3>
                <p class="muted">
                    @module.Lessons.Count bài học
                    @if (Model.IsOwner)
                    {
                        <span>· <partial name="_UiText" model="module.Visibility" /></span>
                    }
                </p>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(module.Description))
        {
            <p class="preserve outline-description">@module.Description</p>
        }
        <ul class="outline-lessons">
            @foreach (var lesson in module.Lessons)
            {
                <li>
                    @if (lesson.IsCompleted)
                    {
                        <div style="width: 28px; height: 28px; border-radius: 50%; background: #DEF7EC; color: #03543F; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <svg class="icon icon-sm" aria-hidden="true" style="width: 16px; height: 16px;"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                        </div>
                    }
                    else
                    {
                        <div style="width: 28px; height: 28px; border-radius: 50%; background: #F1F4FA; color: var(--v2-text-muted); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <svg class="icon icon-sm" aria-hidden="true" style="width: 15px; height: 15px;"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                        </div>
                    }
                    <div style="flex: 1;">
                        @if (Model.CanLearn)
                        {
                            <a asp-controller="Learning" asp-action="Lesson" asp-route-id="@lesson.Id">@lesson.Title</a>
                        }
                        else
                        {
                            <span style="font-weight: 600; font-size: 14px; color: var(--v2-text-muted);">@lesson.Title</span>
                        }
                        <small class="muted">
                            @if (Model.IsOwner)
                            {
                                <partial name="_UiText" model="lesson.Status" />
                            }
                            else if (Model.Progress is not null)
                            {
                                @(lesson.IsCompleted ? "Đã hoàn thành" : "Chưa hoàn thành")
                            }
                            else
                            {
                                <text>Tham gia khóa học để xem bài</text>
                            }
                        </small>
                    </div>
                    @if (Model.CanLearn)
                    {
                        <a class="button secondary" style="padding: 6px 14px; font-size: 12px; margin-left: auto;" asp-controller="Learning" asp-action="Lesson" asp-route-id="@lesson.Id">
                            @(lesson.IsCompleted ? "Xem lại" : "Học bài")
                        </a>
                    }
                </li>
            }
        </ul>
    </section>
}
</div>
