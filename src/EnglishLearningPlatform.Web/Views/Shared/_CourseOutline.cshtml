@model CoursePage
@{
    var continueId = Model.Progress?.ContinueLessonId;
    var expanded = ViewData["ExpandedOutline"] is true
        ? Model.Modules.FirstOrDefault(module => module.Lessons.Any(lesson => lesson.Id == continueId))
            ?? Model.Modules.FirstOrDefault(module => module.Lessons.Count > 0)
        : null;
}
@if (!Model.Modules.Any(m => m.Lessons.Count > 0))
{
    <div class="empty">Chưa có nội dung bài học khả dụng trong khóa này.</div>
}
<div class="course-outline">
@for (var mi = 0; mi < Model.Modules.Count; mi++)
{
    var module = Model.Modules[mi];
    <details class="outline-module" open="@(expanded?.Id == module.Id)">
        <summary class="outline-heading">
            <span class="module-number">@((mi + 1).ToString("00"))</span>
            <span class="outline-heading-text">
                <span class="outline-module-title">@module.Title</span>
                <span class="outline-module-meta">
                    @module.Lessons.Count bài học
                    @if (ViewData["ExpandedOutline"] is true && module.Lessons.Any(lesson => lesson.IsCompleted))
                    {
                        <span>· @module.Lessons.Count(lesson => lesson.IsCompleted) hoàn thành</span>
                    }
                    @if (Model.IsOwner)
                    {
                        <span>· <partial name="_UiText" model="module.Visibility" /></span>
                    }
                </span>
            </span>
            <svg class="outline-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        @if (!string.IsNullOrWhiteSpace(module.Description))
        {
            <p class="preserve outline-description">@module.Description</p>
        }
        <ul class="outline-lessons">
            @foreach (var lesson in module.Lessons)
            {
                <li data-lesson-completed="@(lesson.IsCompleted ? "true" : "false")" class="@(Model.CanLearn ? "is-clickable-lesson" : null)">
                    @if (Model.CanLearn)
                    {
                        <a class="outline-lesson-row-link" asp-controller="Learning" asp-action="Lesson" asp-route-id="@lesson.Id">
                            @if (lesson.IsCompleted)
                            {
                                <span class="outline-lesson-badge is-done" aria-hidden="true">
                                    <svg class="icon icon-sm"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                                </span>
                            }
                            else
                            {
                                <span class="outline-lesson-badge" aria-hidden="true">
                                    <svg class="icon icon-sm"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                                </span>
                            }
                            <span class="outline-lesson-copy">
                                <span class="outline-lesson-title">@lesson.Title</span>
                                <small class="muted">
                                    @if (Model.IsOwner)
                                    {
                                        <partial name="_UiText" model="lesson.Status" />
                                    }
                                    else if (Model.Progress is not null)
                                    {
                                        @(lesson.IsCompleted ? "Đã hoàn thành" : "Chưa hoàn thành")
                                    }
                                </small>
                            </span>
                            <svg class="icon outline-lesson-chevron" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else
                    {
                        <div class="outline-lesson-badge" aria-hidden="true">
                            <svg class="icon icon-sm"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                        </div>
                        <div class="outline-lesson-copy">
                            <span class="outline-lesson-locked">@lesson.Title</span>
                            <small class="muted">Tham gia khóa học để xem bài</small>
                        </div>
                    }
                </li>
            }
        </ul>
    </details>
}
</div>
