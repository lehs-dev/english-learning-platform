@model EnglishLearningPlatform.Web.Models.Practice.TeacherPracticeQuestionsViewModel
@{
    Layout = "_LayoutTeacher";
    ViewData["Title"] = "Soạn bài luyện tập";
    ViewData["ActiveSection"] = "practices";
    ViewData["PageClass"] = "teacher-practice-page";
    var questionNumber = 0;
    var parentTitle = Model.Editor.LessonId.HasValue || Model.Editor.ModuleId.HasValue
        ? Model.Editor.ParentTitle : "Chưa chọn vị trí";
}
@section Styles { <link rel="stylesheet" href="~/css/teacher-practices.css" asp-append-version="true" /> }
<nav class="practice-breadcrumb" aria-label="Đường dẫn điều hướng"><a asp-controller="TeacherPractices" asp-action="Index" data-editor-navigation>Bài luyện tập</a><span aria-hidden="true">/</span><span aria-current="page">Soạn câu hỏi</span></nav>
<div class="practice-heading">
    <div><h1>@Model.Editor.Title</h1><p>Chọn câu hỏi từ ngân hàng và sắp xếp thành một bài luyện tập.</p></div>
    @if (Model.Editor.Status == PracticeStatus.Draft || Model.Editor.Status == PracticeStatus.Published)
    {
        <a class="button secondary" asp-controller="TeacherPracticePreview" asp-action="Index" asp-route-id="@Model.Editor.PracticeId" data-editor-navigation><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>Xem trước bản đã lưu</a>
    }
</div>
<div class="practice-editor-summary">
    <span class="practice-status status-@Model.Editor.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="Model.Editor.Status" /></span>
    <span>@Model.Editor.Questions.Count câu hỏi đã lưu</span><span>@parentTitle</span>
</div>
@if (!Model.Editor.CanEditQuestions)
{
    <p class="practice-inline-note">Nội dung đã khóa sau khi xuất bản. Bạn có thể xem câu hỏi và quản lý trạng thái xuất bản.</p>
}
else
{
    <ol class="practice-steps" aria-label="Các bước soạn bài"><li class="is-complete"><span>✓</span> Thông tin bài</li><li class="is-current" aria-current="step"><span>2</span> Chọn câu hỏi</li><li><span>3</span> Xem trước và xuất bản</li></ol>
}
<nav class="practice-mobile-shortcuts" aria-label="Điều hướng soạn câu hỏi"><a href="#question-filter-title">Tìm câu hỏi</a><a href="#selected-questions-title">Câu hỏi đã chọn ↓</a></nav>
<div class="practice-editor-grid">
    <div class="practice-bank-column">
<section class="practice-card practice-bank-card" aria-labelledby="question-filter-title">
    <h2 id="question-filter-title">
        Ngân hàng câu hỏi
    </h2>

    @* GET chỉ tìm kiếm, không ghi dữ liệu.
       Tên trường phải khớp QuestionSearchRequest. *@
    <form method="get"
          asp-controller="TeacherPracticeQuestions"
          asp-action="Index"
          data-editor-navigation>

        @* Giữ Practice đang mở khi gửi bộ lọc.
           Service vẫn kiểm tra quyền sở hữu ID này. *@
        <input type="hidden"
               name="id"
               value="@Model.Editor.PracticeId" />

        @* Mỗi lần đổi bộ lọc, bắt đầu lại từ trang 1. *@
        <input type="hidden"
               name="PageNumber"
               value="1" />

        <div class="practice-bank-filters">
            <div>
                <label for="Search">Nội dung câu hỏi</label>

                <input type="search"
                       id="Search"
                       name="Search"
                       value="@Model.Query.Search"
                       placeholder="Ví dụ: school" />
            </div>

            <div>
                <label for="PrimarySkill">Kỹ năng</label>

                <select id="PrimarySkill" name="PrimarySkill">
                    <option value="">Tất cả kỹ năng</option>

                    @* Lấy các kỹ năng từ enum đang có trong dự án. *@
                    @foreach (EnglishSkill skill in
                        Enum.GetValues(typeof(EnglishSkill)))
                    {
                        if (Model.Query.PrimarySkill == skill)
                        {
                            <option value="@skill" selected>
                                <partial name="_UiText" model="skill" />
                            </option>
                        }
                        else
                        {
                            <option value="@skill">
                                <partial name="_UiText" model="skill" />
                            </option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="Level">Trình độ</label>

                <select id="Level" name="Level">
                    <option value="">Tất cả</option>
                    @foreach (var level in QuestionLevels.All)
                    {
                        <option value="@level" selected="@(Model.Query.Level == level)">@level</option>
                    }
                </select>
            </div>

            <div>
                <label for="Status">Trạng thái câu hỏi</label>

                <select id="Status" name="Status">
                    <option value="">Tất cả trạng thái</option>

                    @foreach (QuestionStatus status in
                        Enum.GetValues(typeof(QuestionStatus)))
                    {
                        if (Model.Query.Status == status)
                        {
                            <option value="@status" selected>
                                <partial name="_UiText" model="status" />
                            </option>
                        }
                        else
                        {
                            <option value="@status">
                                <partial name="_UiText" model="status" />
                            </option>
                        }
                    }
                </select>
            </div>

            <div>
                <label for="PageSize">Số câu mỗi trang</label>

                <input type="number"
                       id="PageSize"
                       name="PageSize"
                       min="1"
                       max="100"
                       required
                       value="@Model.Query.PageSize" />
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="button">
                Tìm / lọc
            </button>

            @* Xóa bộ lọc nhưng vẫn mở đúng Practice hiện tại. *@
            <a class="button secondary"
               asp-controller="TeacherPracticeQuestions"
               asp-action="Index"
               asp-route-id="@Model.Editor.PracticeId">
                Xóa bộ lọc
            </a>
        </div>
    </form>
</section>
<section class="practice-card practice-bank-card" aria-labelledby="question-results-title">
    <div class="practice-card-heading"><h2 id="question-results-title">Kết quả tìm kiếm</h2><span class="practice-count">@Model.Result.TotalCount</span></div>



    @if (Model.Result.Items.Count == 0)
    {
        if (Model.Result.TotalCount == 0)
        {
            <p>Không có câu hỏi phù hợp với bộ lọc.</p>
        }
        else
        {
            <p>
                Trang bạn yêu cầu không có dữ liệu.
                Hãy quay về trang đầu.
            </p>
        }
    }
    else
    {
        @* Wrapper cho phép cuộn ngang bảng trên màn hình nhỏ. *@
        <div class="table-scroll"
             role="region"
             aria-label="Kết quả tìm kiếm câu hỏi"
             tabindex="0">

            <table class="report-table practice-table practice-bank-table">
                <thead>
                    <tr>
                        <th scope="col">Nội dung</th>
                        <th scope="col"><span class="visually-hidden">Chi tiết</span></th>
                        <th scope="col">Chọn</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var question in Model.Result.Items)
                    {
                        <tr>
                            <td>
                                <p class="practice-question-content preserve" data-question-content>@question.Content</p>
                                <div class="practice-question-meta"><span><partial name="_UiText" model="question.PrimarySkill" /></span><span>@QuestionLevels.Display(question.Level)</span><span>@question.OptionCount lựa chọn</span><span><partial name="_UiText" model="question.Status" /></span></div>
                            </td>

                            <td>
                                <a asp-controller="TeacherQuestionBank"
                                   asp-action="Details"
                                   asp-route-id="@question.Id">
                                    Xem chi tiết
                                </a>
                            </td>
                            <td>
                                @if (Model.Editor.CanEditQuestions
                                    && question.Status != QuestionStatus.Archived)
                                {
                                    <button type="button"
                                            class="button secondary"
                                            data-add-question
                                            data-question-id="@question.Id"
                                            disabled>
                                        Thêm
                                    </button>
                                }
                                else
                                {
                                    <span class="muted">
                                        @(question.Status == QuestionStatus.Archived
                                            ? "Đã lưu trữ"
                                            : "Chỉ xem")
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
@* Không có kết quả thì không hiển thị Trang 1/0. *@
@if (Model.Result.TotalPages > 0)
{
    <nav class="practice-pagination" aria-label="Phân trang câu hỏi">

        @* Form GET riêng cho phân trang.
           Hidden input giữ lại bộ lọc và Practice đang mở. *@
        <form method="get"
              asp-controller="TeacherPracticeQuestions"
              asp-action="Index"
              class="actions"
              data-editor-navigation>

            <input type="hidden" name="id"
                   value="@Model.Editor.PracticeId" />

            <input type="hidden" name="Search"
                   value="@Model.Query.Search" />

            <input type="hidden" name="PrimarySkill"
                   value="@Model.Query.PrimarySkill" />

            <input type="hidden" name="Level"
                   value="@Model.Query.Level" />


            <input type="hidden" name="Status"
                   value="@Model.Query.Status" />

            <input type="hidden" name="PageSize"
                   value="@Model.Result.PageSize" />

            @if (Model.Result.PageNumber > Model.Result.TotalPages)
            {
                <button type="submit"
                        class="button secondary"
                        name="PageNumber"
                        value="1">
                    Về trang đầu
                </button>
            }
            else
            {
                @if (Model.Result.PageNumber > 1)
                {
                    @* Nút được bấm gửi PageNumber của trang trước. *@
                    <button type="submit"
                            class="button secondary"
                            name="PageNumber"
                            value="@(Model.Result.PageNumber - 1)">
                        Trang trước
                    </button>
                }

                <span class="muted">
                    Trang @Model.Result.PageNumber
                    / @Model.Result.TotalPages
                </span>

                @if (Model.Result.PageNumber < Model.Result.TotalPages)
                {
                    <button type="submit"
                            class="button secondary"
                            name="PageNumber"
                            value="@(Model.Result.PageNumber + 1)">
                        Trang sau
                    </button>
                }
            }
        </form>
    </nav>
}


    </div>
    <aside class="practice-editor-sidebar" aria-label="Nội dung bài luyện tập">
<section class="practice-card practice-selected-card" aria-labelledby="selected-questions-title">
    <div class="practice-card-heading"><h2 id="selected-questions-title">Câu hỏi đã chọn</h2><span class="practice-count" data-selected-count aria-live="polite">@Model.Editor.Questions.Count</span></div>

    <p class="practice-help">Sắp xếp thứ tự câu hỏi, rồi lưu trước khi xem trước hoặc xuất bản.</p>

    <form id="practice-question-form"
          method="post"
          asp-controller="TeacherPracticeQuestions"
          asp-action="Save"
          asp-route-id="@Model.Editor.PracticeId"
          asp-antiforgery="true"
          data-editable="@(Model.Editor.CanEditQuestions ? "true" : "false")">

        <input type="hidden"
               name="ExpectedUpdatedAtUtc"
               value="@(Model.Editor.UpdatedAtUtc?.ToString("O"))" />

        @* Các input cùng tên QuestionIds được gửi thành List<Guid>.
           Thứ tự input trong danh sách chính là thứ tự câu hỏi. *@
        <ol data-selected-question-list>
            @foreach (var question in Model.Editor.Questions)
            {
                <li data-selected-question>
                    <span data-question-number>Câu @(++questionNumber)</span>
                    <input type="hidden" name="QuestionIds" value="@question.Id" />
                    <p class="preserve" data-question-text>@question.Content</p>

                    @if (Model.Editor.CanEditQuestions)
                    {
                        <div class="actions">
                            <button type="button" class="button secondary"
                                    data-question-action="up" disabled>Lên</button>
                            <button type="button" class="button secondary"
                                    data-question-action="down" disabled>Xuống</button>
                            <button type="button" class="button secondary"
                                    data-question-action="remove" disabled>
                                Bỏ chọn
                            </button>
                        </div>
                    }
                </li>
            }
        </ol>

        <p class="muted" data-empty-list
           hidden="@(Model.Editor.Questions.Count > 0)">
            Chưa chọn câu hỏi nào.
        </p>

        <p class="practice-save-notice" data-save-notice role="status" tabindex="-1"></p>

        @if (Model.Editor.CanEditQuestions)
        {
            <button type="submit" class="button practice-full-width" data-save-button disabled>
                Lưu câu hỏi
            </button>
            <noscript>
                <p>Bạn cần bật JavaScript để chọn và sắp xếp câu hỏi.</p>
            </noscript>
        }
    </form>
</section>
<section class="practice-card practice-publication-card" aria-labelledby="publication-title">
    <h2 id="publication-title">Xuất bản bài luyện tập</h2>

    <p>Vị trí hiện tại: @parentTitle</p>

    @if (Model.Editor.CanEditQuestions
        || Model.Editor.Status == PracticeStatus.Unpublished)
    {
        <form method="post"
              asp-controller="TeacherPracticeQuestions"
              asp-action="Publish"
              asp-route-id="@Model.Editor.PracticeId"
              asp-antiforgery="true"
              data-publication-form>

            <input type="hidden"
                   name="ExpectedUpdatedAtUtc"
                   value="@(Model.Editor.UpdatedAtUtc?.ToString("O"))" />

            @if (Model.Editor.CanEditQuestions)
            {
                <p class="muted">
                    Chọn một bài học hoặc một chương học để học viên truy cập bài luyện tập. Hãy lưu câu hỏi trước khi xuất bản.
                </p>

                <div class="practice-publication-fields">
                    <div>
                        <label for="PublishLessonId">Bài học</label>
                        <select id="PublishLessonId" name="lessonId">
                            <option value="">-- Không chọn bài học --</option>
                            @foreach (var option in Model.Editor.LessonOptions)
                            {
                                <option value="@option.Id"
                                        selected="@(Model.Editor.LessonId == option.Id)">
                                    @option.Title
                                </option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="PublishModuleId">Chương học</label>
                        <select id="PublishModuleId" name="moduleId">
                            <option value="">-- Không chọn chương học --</option>
                            @foreach (var option in Model.Editor.ModuleOptions)
                            {
                                <option value="@option.Id"
                                        selected="@(Model.Editor.ModuleId == option.Id)">
                                    @option.Title
                                </option>
                            }
                        </select>
                    </div>
                </div>
            }
            else
            {
                @* Publish lại phải giữ nguyên parent đã bị khóa. *@
                <input type="hidden" name="lessonId" value="@Model.Editor.LessonId" />
                <input type="hidden" name="moduleId" value="@Model.Editor.ModuleId" />
                <p class="muted">
                    Bài luyện tập đã từng xuất bản. Câu hỏi, thứ tự và vị trí liên kết đã được khóa.
                </p>
            }

            <div class="actions">
                <button type="submit" class="button">Xuất bản bài luyện tập</button>
            </div>
        </form>
    }

    @if (Model.Editor.Status == PracticeStatus.Published)
    {
        <p class="muted">
            Ngừng xuất bản sẽ ẩn bài với học viên. Để thay đổi câu hỏi hoặc vị trí, hãy tạo bài luyện tập mới.
        </p>
        <form method="post"
              asp-controller="TeacherPracticeQuestions"
              asp-action="Unpublish"
              asp-route-id="@Model.Editor.PracticeId"
              asp-antiforgery="true"
              data-publication-form>
            <input type="hidden" name="expectedUpdatedAtUtc"
                   value="@(Model.Editor.UpdatedAtUtc?.ToString("O"))" />
            <button type="submit" class="button secondary">
                Ngừng xuất bản
            </button>
        </form>
    }
</section>


    </aside>
</div>
@section Scripts {
    <script src="~/js/teacher-practice-questions.js"
            asp-append-version="true"
            defer></script>
}
