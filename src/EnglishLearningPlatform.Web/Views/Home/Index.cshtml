@model CatalogPage
@{
    ViewData["Title"] = "Trang chủ - Học tiếng Anh trực tuyến";
}

<div class="landing-page">
    @* 1. Hero Banner Section *@
    <section class="hero-banner landing-hero" aria-labelledby="hero-heading">
        <div class="hero-content">
            <span class="eyebrow hero-badge">NỀN TẢNG HỌC TIẾNG ANH TRỰC TUYẾN THẾ HỆ MỚI</span>
            <h1 id="hero-heading" class="hero-title">Chinh phục tiếng Anh đột phá cùng Estudy</h1>
            <p class="hero-subtitle">Estudy đồng hành cùng bạn trên con đường làm chủ Anh ngữ với lộ trình cá nhân hóa, bài học tương tác sinh động và hệ thống khảo thí đánh giá năng lực chuẩn quốc tế.</p>
            <div class="hero-actions actions">
                <a class="button primary" asp-controller="Account" asp-action="Register">Bắt đầu học ngay</a>
                <a class="button secondary" href="#placement-test">Kiểm tra trình độ</a>
                <a class="button secondary" asp-controller="Courses" asp-action="Index">Khám phá khóa học</a>
            </div>
        </div>
    </section>

    @* 2. Platform Highlight Cards (3 Feature Cards) *@
    <section class="highlights-section landing-features" aria-labelledby="highlights-heading">
        <div class="section-header">
            <p class="eyebrow">TẠI SAO CHỌN ESTUDY</p>
            <h2 id="highlights-heading" class="section-title">Điểm nổi bật của nền tảng Estudy</h2>
            <p class="section-desc">Giải pháp học tiếng Anh toàn diện kết hợp giữa phương pháp sư phạm hiện đại và công nghệ tự động hóa.</p>
        </div>
        <div class="highlight-cards feature-grid">
            <article class="panel highlight-card feature-card">
                <div class="highlight-icon">🎯</div>
                <h3>Lộ trình học cá nhân hóa</h3>
                <p>Hệ thống tự động phân tích điểm mạnh và điểm yếu để đề xuất bài học, bài tập thực hành sát với nhu cầu thực tế của từng học viên.</p>
            </article>
            <article class="panel highlight-card feature-card">
                <div class="highlight-icon">📊</div>
                <h3>Đánh giá năng lực chuẩn quốc tế</h3>
                <p>Hệ thống đề thi đánh giá toàn diện các kỹ năng Nghe, Nói, Đọc, Viết với thuật toán chấm điểm thông minh và phân tích chi tiết kết quả.</p>
            </article>
            <article class="panel highlight-card feature-card">
                <div class="highlight-icon">⚡</div>
                <h3>Kho bài tập & Luyện tập tương tác</h3>
                <p>Đa dạng hình thức bài tập với cơ chế chấm điểm và giải thích tức thì, giúp củng cố kiến thức ngữ pháp và từ vựng nhanh chóng.</p>
            </article>
        </div>
    </section>

    @* 3. Featured Courses Catalog Grid *@
    <section class="featured-courses-section" aria-labelledby="featured-courses-heading">
        <div class="section-header">
            <p class="eyebrow">CATALOG KHÓA HỌC</p>
            <h2 id="featured-courses-heading" class="section-title">Khóa học tiêu biểu</h2>
            <p class="section-desc">Các khóa học tiếng Anh nổi bật được giảng viên chọn lọc kỹ lưỡng, phù hợp mọi trình độ từ cơ bản đến nâng cao.</p>
        </div>
        <div class="course-grid">
            @if (Model?.Courses != null && Model.Courses.Count > 0)
            {
                @foreach (var course in Model.Courses.Take(6))
                {
                    <article class="panel course-card">
                        <h2>@course.Title</h2>
                        <p class="excerpt">@(course.Description ?? "Khóa học tiếng Anh chất lượng cao tại Estudy.")</p>
                        <partial name="_CourseSummary" model="course" />
                        <a class="button secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">Xem chi tiết</a>
                    </article>
                }
            }
            else
            {
                @* Curated preview cards if database has not yet seeded courses *@
                <article class="panel course-card">
                    <h2>Tiếng Anh giao tiếp cơ bản cho người mới bắt đầu</h2>
                    <p class="excerpt">Xây dựng nền tảng phát âm chuẩn, từ vựng thông dụng và tự tin giao tiếp trong các tình huống hàng ngày.</p>
                    <p class="muted">Giảng viên Estudy · Cơ bản · Nghe / Nói</p>
                    <span class="badge">Miễn phí</span>
                    <a class="button secondary" asp-controller="Courses" asp-action="Index">Khám phá ngay</a>
                </article>
                <article class="panel course-card">
                    <h2>Luyện thi IELTS Foundation 5.5+</h2>
                    <p class="excerpt">Nắm vững cấu trúc bài thi, chiến thuật làm bài và củng cố ngữ pháp chuyên sâu 4 kỹ năng.</p>
                    <p class="muted">Giảng viên Estudy · Trung cấp · 4 kỹ năng</p>
                    <span class="badge">Nổi bật</span>
                    <a class="button secondary" asp-controller="Courses" asp-action="Index">Khám phá ngay</a>
                </article>
                <article class="panel course-card">
                    <h2>Ngữ pháp tiếng Anh ứng dụng thực chiến</h2>
                    <p class="excerpt">Hệ thống hóa toàn bộ ngữ pháp trọng tâm kèm bài tập phân tích lỗi sai thường gặp.</p>
                    <p class="muted">Giảng viên Estudy · Mọi cấp độ · Ngữ pháp</p>
                    <span class="badge">Miễn phí</span>
                    <a class="button secondary" asp-controller="Courses" asp-action="Index">Khám phá ngay</a>
                </article>
            }
        </div>
        <div class="catalog-cta actions">
            <a class="button" asp-controller="Courses" asp-action="Index">Xem toàn bộ danh mục khóa học →</a>
        </div>
    </section>

    @* 4. Placement Test / Assessment CTA *@
    <section class="assessment-cta-section placement-test-section panel" id="placement-test" aria-labelledby="assessment-cta-heading">
        <div class="assessment-cta-content">
            <span class="eyebrow">KIỂM TRA TRÌNH ĐỘ MIỄN PHÍ</span>
            <h2 id="assessment-cta-heading" class="section-title">Chưa biết bắt đầu từ đâu? Hãy làm bài kiểm tra trình độ tiếng Anh</h2>
            <p class="section-desc">Bài test đánh giá năng lực (Placement Test) chuẩn quốc tế trong 15 phút sẽ giúp bạn xác định chính xác trình độ CEFR hiện tại và nhận lộ trình học tập tối ưu nhất.</p>
            <div class="actions">
                <a class="button primary" asp-controller="Assessment" asp-action="Index">Bắt đầu bài test đánh giá năng lực ngay</a>
                <a class="button secondary" asp-controller="Courses" asp-action="Index">Xem các bài luyện tập</a>
            </div>
        </div>
    </section>
</div>

@section Styles {
    <style>
        .landing-page {
            display: flex;
            flex-direction: column;
            gap: 48px;
            padding: 16px 0 64px;
        }
        .landing-hero {
            background: linear-gradient(135deg, #ffffff 0%, #edf4ff 100%);
            border: 1px solid #dce8fa;
            border-radius: 20px;
            padding: clamp(36px, 6vw, 64px) clamp(24px, 5vw, 48px);
            box-shadow: 0 4px 20px rgba(23, 107, 255, 0.06);
        }
        .hero-content {
            max-width: 820px;
        }
        .hero-badge {
            display: inline-block;
            margin-bottom: 14px;
        }
        .hero-title {
            font-size: clamp(30px, 4.8vw, 46px);
            font-weight: 800;
            line-height: 1.25;
            color: var(--ink, #101d48);
            margin: 0 0 18px;
        }
        .hero-subtitle {
            font-size: clamp(16px, 2vw, 18px);
            line-height: 1.6;
            color: var(--muted, #62718b);
            margin: 0 0 28px;
        }
        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }
        .section-header {
            margin-bottom: 28px;
        }
        .section-title {
            font-size: clamp(22px, 3.2vw, 30px);
            font-weight: 700;
            color: var(--ink, #101d48);
            margin: 6px 0 10px;
        }
        .section-desc {
            color: var(--muted, #62718b);
            font-size: 15px;
            margin: 0;
            max-width: 680px;
            line-height: 1.5;
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
        }
        .highlight-card {
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .highlight-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(23, 107, 255, 0.08);
        }
        .highlight-icon {
            font-size: 32px;
            line-height: 1;
            margin-bottom: 4px;
        }
        .highlight-card h3 {
            font-size: 19px;
            font-weight: 700;
            margin: 0;
            color: var(--ink, #101d48);
        }
        .highlight-card p {
            margin: 0;
            color: var(--muted, #62718b);
            line-height: 1.55;
            font-size: 14px;
        }
        .assessment-cta-section {
            background: linear-gradient(135deg, #176bff 0%, #0751cf 100%);
            color: #ffffff;
            border: none;
            border-radius: 20px;
            padding: clamp(36px, 5vw, 54px);
        }
        .assessment-cta-section .eyebrow {
            color: #b7d5ff;
        }
        .assessment-cta-section .section-title {
            color: #ffffff;
        }
        .assessment-cta-section .section-desc {
            color: #dceaff;
            margin-bottom: 24px;
        }
        .assessment-cta-section .button.primary {
            background: #ffffff;
            color: #0751cf;
            border-color: #ffffff;
        }
        .assessment-cta-section .button.secondary {
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.3);
        }
        .catalog-cta {
            margin-top: 28px;
            justify-content: center;
        }
        @@media (max-width: 900px) {
            .feature-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
