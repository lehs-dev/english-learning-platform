@model CatalogPage
@{ ViewData["Title"] = "Học tiếng Anh theo cách của bạn"; }
@section Styles { <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" /> }
<div class="landing-page">
<section class="landing-hero" aria-labelledby="hero-heading">
    <div class="hero-copy"><h1 id="hero-heading">Một bài học nhỏ.<br /><span>Một bước tiến xa.</span></h1>
    <p>Học tiếng Anh với bài học rõ ràng, bài luyện có giải thích và kết quả giúp bạn biết cần ôn tập điều gì.</p>
    <div class="actions"><a class="button accent" asp-controller="Courses" asp-action="Index">Tìm khóa học phù hợp <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a><a class="button ghost" href="#placement-test">Khám phá bài đánh giá</a></div></div>
    <div class="hero-editorial" aria-hidden="true"><div class="editorial-word">Hello<span>cho những điều mới.</span></div><div class="editorial-foot"><svg class="icon"><use href="@Url.Content("~/images/icons.svg#graduation")"></use></svg><span>Học. Thực hành. Tiến bộ.</span></div></div>
</section>
<section aria-labelledby="featured-title"><div class="section-heading"><div><h2 id="featured-title">Bắt đầu từ điều bạn muốn học</h2><p>Khám phá các khóa học hiện có trên Estudy.</p></div><a class="text-action" asp-controller="Courses" asp-action="Index">Tất cả khóa học <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a></div>
@if (Model.Courses.Count > 0) { <div class="course-grid">@foreach (var course in Model.Courses.Take(6)) { <article class="course-card"><partial name="_CourseCover" model="course" /><div class="course-card-body"><h3><a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">@course.Title</a></h3><p class="excerpt">@course.Description</p><partial name="_CourseSummary" model="course" /><a class="button secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">Khám phá khóa học</a></div></article> }</div> }
else { <div class="empty panel"><h3>Khóa học đang được chuẩn bị</h3><p>Danh mục sẽ cập nhật khi giảng viên xuất bản nội dung mới.</p></div> }
</section>
<section class="learning-path" aria-labelledby="path-title"><div><h2 id="path-title">Học có nhịp.<br />Ôn tập có hướng.</h2><p>Từ bài học đầu tiên đến lần đánh giá tiếp theo, mọi thứ cùng ở một nơi.</p></div><ol><li><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#search")"></use></svg><div><h3>Chọn điều muốn cải thiện</h3><p>Lọc khóa học theo trình độ, kỹ năng và chủ đề.</p></div></li><li><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#graduation")"></use></svg><div><h3>Học rồi thực hành</h3><p>Theo dõi bài đã hoàn thành, luyện tập và đọc giải thích đáp án.</p></div></li><li><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg><div><h3>Nhìn lại kết quả</h3><p>Xem điểm đánh giá và gợi ý ôn tập từ kết quả của bạn.</p></div></li></ol></section>
<section class="placement-section" id="placement-test" aria-labelledby="placement-title"><div><h2 id="placement-title">Dành một chút thời gian<br />để hiểu mình hơn.</h2><p>Xem các bài đánh giá khả dụng, đọc hướng dẫn và chọn thời điểm sẵn sàng để bắt đầu.</p></div><a class="button" asp-controller="Assessment" asp-action="Index">Xem bài đánh giá <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a></section>
</div>
