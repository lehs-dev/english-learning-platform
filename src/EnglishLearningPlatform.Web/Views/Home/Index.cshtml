@model CatalogPage
@{
    ViewData["Title"] = "Học tiếng Anh mỗi ngày";
    ViewData["Description"] = "Luyện tiếng Anh qua tình huống và tìm khóa học theo kỹ năng trên Estudy.";
    ViewData["PageClass"] = "landing-marketing";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing-practice.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing-content.css" asp-append-version="true" />
}

<div class="landing-page">
    <partial name="_LandingHero" />
    <partial name="_LandingPractice" />
    <partial name="_LandingCatalog" model="Model" />
    <partial name="_LandingJourney" />

    <section class="homepage-cta-card" aria-labelledby="cta-heading">
        <h2 id="cta-heading">Bắt đầu học</h2>
        <a asp-controller="Account" asp-action="Register" class="button landing-primary"
           aria-haspopup="dialog" aria-controls="auth-modal">
            Đăng ký
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
        </a>
    </section>

    <nav class="landing-dock" aria-label="Đi nhanh trên trang" data-landing-dock hidden>
        <a href="#courses">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
            Khóa học
        </a>
        <a class="landing-dock-practice" href="#practice">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
            Luyện thử
        </a>
    </nav>
</div>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
    <script src="~/js/landing-practice.js" asp-append-version="true" defer></script>
}
