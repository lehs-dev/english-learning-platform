<section class="homepage-hero-card" aria-labelledby="hero-title">
    <div class="landing-hero-content">
        <h1 id="hero-title">Học tiếng Anh <span>mỗi ngày.</span></h1>
        <p>Nghe, đọc và viết theo tình huống.</p>
        <div class="landing-hero-actions">
            <a href="#practice" class="button landing-primary">
                Luyện thử
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            </a>
            <a href="#courses" class="button landing-hero-secondary">
                <svg class="icon" viewBox="0 0 40 40" aria-hidden="true"><use href="@Url.Content("~/images/landing-illustrations.svg#courses")"></use></svg>
                Khóa học
            </a>
        </div>
    </div>

    <div class="landing-art" data-landing-art aria-hidden="true">
        <div class="landing-art-light"></div>
        <div class="landing-art-stage">
            <svg class="landing-language-orbit" viewBox="0 0 620 490" fill="none" focusable="false">
                <defs>
                    <linearGradient id="landing-orbit-stroke" x1="81" y1="313" x2="561" y2="163" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#454886" stop-opacity=".2"/>
                        <stop offset=".51" stop-color="#a69aff"/>
                        <stop offset="1" stop-color="#6467d2" stop-opacity=".2"/>
                    </linearGradient>
                    <linearGradient id="landing-art-tile" x1="193" y1="132" x2="430" y2="364" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#9f98ff"/>
                        <stop offset=".53" stop-color="#6558e7"/>
                        <stop offset="1" stop-color="#3a329d"/>
                    </linearGradient>
                    <linearGradient id="landing-art-rim" x1="211" y1="134" x2="368" y2="340" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#ebe7ff" stop-opacity=".9"/>
                        <stop offset="1" stop-color="#c4b9ff" stop-opacity=".27"/>
                    </linearGradient>
                    <linearGradient id="landing-art-chip" x1="407" y1="312" x2="512" y2="421" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#eefeb3"/>
                        <stop offset="1" stop-color="#bde75f"/>
                    </linearGradient>
                    <linearGradient id="landing-art-wave" x1="107" y1="282" x2="219" y2="352" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#46457d"/>
                        <stop offset="1" stop-color="#212748"/>
                    </linearGradient>
                </defs>

                <g class="landing-orbit-lines">
                    <circle cx="316" cy="238" r="182" stroke="#7873bd" stroke-opacity=".23" stroke-dasharray="2 8"/>
                    <circle cx="316" cy="238" r="215" stroke="#786ec2" stroke-opacity=".17"/>
                    <ellipse cx="310" cy="237" rx="258" ry="103" transform="rotate(-26 310 237)" stroke="url(#landing-orbit-stroke)" stroke-width="1.2"/>
                    <ellipse cx="312" cy="239" rx="252" ry="103" transform="rotate(31 312 239)" stroke="#7469bd" stroke-opacity=".52"/>
                    <ellipse cx="309" cy="240" rx="276" ry="87" transform="rotate(-9 309 240)" stroke="#7469bd" stroke-opacity=".28" stroke-dasharray="4 7"/>
                    <ellipse class="landing-orbit-trace" cx="310" cy="237" rx="258" ry="103" transform="rotate(-26 310 237)"
                             pathLength="100" stroke="#d8ceff" stroke-width="2.3" stroke-linecap="round" stroke-dasharray="9 91" stroke-dashoffset="38"/>
                    <circle class="landing-orbit-pulse" cx="522" cy="108" r="14" stroke="#d9fa78" opacity="0"/>
                    <circle cx="522" cy="108" r="7" fill="#d9fa78"/>
                    <circle cx="522" cy="108" r="14" stroke="#d9fa78" stroke-opacity=".36"/>
                    <circle cx="101" cy="338" r="5" fill="#b2a6ff"/>
                    <circle cx="501" cy="329" r="4" fill="#b2a6ff"/>
                    <circle cx="175" cy="95" r="3" fill="#d9fa78"/>
                    <circle cx="532" cy="235" r="2.6" fill="#b2a6ff"/>
                    <path d="M564 171h16m-8-8v16M140 160h14m-7-7v14M258 419h15m-7.5-7.5v15" stroke="#b2a6ff" stroke-opacity=".73" stroke-linecap="round"/>
                </g>

                <g class="landing-orbit-bubble">
                    <g transform="rotate(-12 318 251)">
                        <path d="M239 139h159c30 0 54 24 54 54v94c0 30-24 54-54 54h-60l-51 37c-8 5-20 0-20-10v-27h-28c-30 0-54-24-54-54v-94c0-30 24-54 54-54Z" fill="#27215f" stroke="#8278ec" transform="translate(8 15)"/>
                        <path d="M239 139h159c30 0 54 24 54 54v94c0 30-24 54-54 54h-60l-51 37c-8 5-20 0-20-10v-27h-28c-30 0-54-24-54-54v-94c0-30 24-54 54-54Z" fill="url(#landing-art-tile)" stroke="url(#landing-art-rim)" stroke-width="1.7"/>
                        <path d="M202 207v-13c0-22 17-39 39-39h150" stroke="#e0dbff" stroke-opacity=".5" stroke-width="1.4" stroke-linecap="round"/>
                        <path d="M226 315c4 3 8 4 13 4h68" stroke="#ccc2ff" stroke-opacity=".36" stroke-width="1.4" stroke-linecap="round"/>
                        <path d="M419 172v15m-7.5-7.5h15M405 195v8m-4-4h8" stroke="#e9e2ff" stroke-opacity=".6" stroke-linecap="round"/>
                        <circle cx="367" cy="310" r="2" fill="#d7d0ff" fill-opacity=".7"/>
                        <circle cx="376" cy="310" r="2" fill="#d7d0ff" fill-opacity=".5"/>
                        <circle cx="385" cy="310" r="2" fill="#d7d0ff" fill-opacity=".3"/>
                        <text x="319" y="275" text-anchor="middle" fill="#fff" font-size="112" font-weight="800" font-family="Estudy Jakarta, system-ui, sans-serif" letter-spacing="-12">Aa</text>
                    </g>
                </g>

                <g class="landing-orbit-audio">
                    <g transform="rotate(11 167 318)">
                        <rect x="109" y="290" width="116" height="65" rx="20" fill="#121832" stroke="#635caa"/>
                        <rect x="105" y="283" width="116" height="65" rx="20" fill="url(#landing-art-wave)" stroke="#8f86e2" stroke-opacity=".8"/>
                        <path d="M113 303c0-7 6-13 14-13h25" stroke="#d7d1ff" stroke-opacity=".45" stroke-linecap="round"/>
                        <g class="landing-orbit-signal" stroke="#e3dcff" stroke-width="2.6" stroke-linecap="round">
                            <path d="M127 314v5m11-12v19m11-27v35m11-41v46"/>
                            <path d="M171 301v31m11-25v19m11-22v25m11-17v9" opacity=".72"/>
                        </g>
                    </g>
                </g>
                <g class="landing-orbit-check">
                    <g transform="rotate(11 454 353)">
                        <rect x="415" y="315" width="86" height="76" rx="24" fill="#81974b" transform="translate(3 6)"/>
                        <rect x="415" y="315" width="86" height="76" rx="24" fill="url(#landing-art-chip)" stroke="#f5ffcd" stroke-width="1.4"/>
                        <path d="M425 338c0-8 7-15 15-15h24" stroke="#faffdf" stroke-width="1.5" stroke-linecap="round"/>
                        <path d="m443 353 11 12 19-24" stroke="#1d3021" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                </g>
            </svg>
        </div>
    </div>
</section>
