@model IReadOnlyList<EnglishLearningPlatform.Application.Assessment.TeacherAssessmentListItem>

@{
    Layout = "_LayoutTeacher";
    ViewData["Title"] = "Bài kiểm tra của tôi";
    ViewData["ActiveSection"] = "assessments";
}

<div class="page-heading">
    <div>
        <h1>Bài kiểm tra của tôi</h1>
        <p class="muted">
            Quản lý cấu hình các bài kiểm tra do bạn sở hữu.
        </p>
    </div>

    <a class="button"
       asp-controller="TeacherAssessments"
       asp-action="Edit">
        + Tạo Assessment Draft
    </a>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <p>Bạn chưa có bài kiểm tra nào.</p>
    }
    else
    {
        <div class="table-scroll"
             role="region"
             aria-label="Danh sách bài kiểm tra"
             tabindex="0">
            <table class="report-table">
                <thead>
                    <tr>
                        <th scope="col">Tên bài</th>
                        <th scope="col">Loại</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Phạm vi</th>
                        <th scope="col">Thời lượng</th>
                        <th scope="col">Lượt tối đa</th>
                        <th scope="col">Điểm đạt</th>
                        <th scope="col">Số câu</th>
                        <th scope="col">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.AssessmentType</td>
                            <td>@item.Status</td>
                            <td>
                                @(item.CourseId.HasValue
                                    ? item.CourseTitle ?? "Course không khả dụng"
                                    : "Độc lập (Independent)")
                            </td>
                            <td>@item.DurationMinutes phút</td>
                            <td>@item.MaxAttempts</td>
                            <td>
                                @(item.PassingScore.HasValue
                                    ? item.PassingScore.Value.ToString("0.##") + "%"
                                    : "Không áp dụng")
                            </td>
                            <td>@item.QuestionCount</td>
                            <td>
                                @* actions tạo khoảng cách và cho phép nút tự xuống hàng.
                                   Vẫn dùng thẻ a vì đây là thao tác chuyển trang. *@
                                <div class="actions">
                                    <form method="post" asp-controller="TeacherAssessmentClone" asp-action="Create" asp-route-id="@item.Id">
                                        <input type="hidden" name="expectedUpdatedAtUtc" value="@(item.UpdatedAtUtc?.ToString("O"))" />
                                        <button type="submit" class="button small secondary">Clone thành Draft</button>
                                    </form>
                                    @* Vẫn mở được trang chỉ đọc khi phạm vi đã khóa. *@
                                    <a class="button small secondary"
                                       asp-controller="TeacherAssessmentScope" asp-action="Edit"
                                       asp-route-id="@item.Id">Phạm vi / Course</a>
                                    @if (item.Status == AssessmentStatus.Draft
                                        || item.Status == AssessmentStatus.Published)
                                    {
                                        <a class="button small secondary"
                                           asp-controller="TeacherAssessmentPreview"
                                           asp-action="Index"
                                           asp-route-id="@item.Id"
                                           target="_blank"
                                           rel="noopener">
                                            Xem trước
                                        </a>
                                    }

                                    @if (item.CanEditConfiguration)
                                    {
                                        <a class="button small secondary"
                                           asp-controller="TeacherAssessments"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id">
                                            Sửa cấu hình
                                        </a>
                                    }

                                    @* Cùng phạm vi Draft/Published chưa có Attempt;
                                       service vẫn kiểm tra lại khi đọc và lưu. *@
                                    @if (item.CanEditConfiguration)
                                    {
                                        <a class="button small"
                                           asp-controller="TeacherAssessmentQuestions"
                                           asp-action="Index"
                                           asp-route-id="@item.Id">
                                            Soạn câu hỏi
                                        </a>
                                    }
                                    @if (!item.CanEditConfiguration)
                                    {
                                        <span class="muted">
                                            Đề hiện không được chỉnh sửa
                                        </span>
                                    }
                                    @if (item.Status == AssessmentStatus.Published)
                                    {
                                        <form method="post" asp-controller="TeacherAssessmentLifecycle" asp-action="Unpublish" asp-route-id="@item.Id">
                                            <input type="hidden" name="expectedUpdatedAtUtc" value="@(item.UpdatedAtUtc?.ToString("O"))" />
                                            <button type="submit" class="button small secondary">Ngừng xuất bản</button>
                                        </form>
                                    }
                                    @if (item.Status == AssessmentStatus.Published || item.Status == AssessmentStatus.Unpublished)
                                    {
                                        <form method="post" asp-controller="TeacherAssessmentLifecycle" asp-action="Archive" asp-route-id="@item.Id">
                                            <input type="hidden" name="expectedUpdatedAtUtc" value="@(item.UpdatedAtUtc?.ToString("O"))" />
                                            <button type="submit" class="button small secondary">Lưu trữ đề</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
