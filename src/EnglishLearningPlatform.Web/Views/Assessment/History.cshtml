@using EnglishLearningPlatform.Application.Assessment
@model IReadOnlyList<AssessmentHistoryView>
@{
    ViewData["Title"] = "Lịch sử làm bài";
    ViewData["ActiveSection"] = "assessment";
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
}

<div class="exam-workspace-layout">
    <header class="page-heading">
        <div>
            <h1>Lịch sử làm bài</h1>
            <p class="muted">Các lượt làm được lưu riêng. Đề ngừng công bố hoặc lưu trữ vẫn giữ kết quả cũ; trang này không tạo lượt làm mới.</p>
        </div>
        <div class="actions">
            <a class="button secondary" asp-action="Index">Danh sách bài đánh giá</a>
            @if (ViewData["FilteredHistory"] is true)
            {
                <a class="button secondary" asp-action="History" asp-route-id="">Tất cả lịch sử</a>
            }
        </div>
    </header>

    @if (Model.Count == 0)
    {
        <section class="card-v2" style="padding: 24px;">
            <p>Bạn chưa có lượt làm bài nào.</p>
        </section>
    }
    @foreach (var assessment in Model)
    {
        <section class="card-v2" style="padding: 24px; margin-top: 24px;" aria-labelledby="history-@assessment.AssessmentId">
            <h2 id="history-@assessment.AssessmentId">@assessment.AssessmentTitle</h2>
            <p class="muted">Trạng thái đề: <partial name="_UiText" model="assessment.Status" /> · @assessment.Attempts.Count lượt</p>
            <partial name="_AttemptHistory" model="assessment.Attempts" />
        </section>
    }
</div>
