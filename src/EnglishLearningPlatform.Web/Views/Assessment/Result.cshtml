@using EnglishLearningPlatform.Domain.Enums
@model EnglishLearningPlatform.Application.Assessment.AssessmentResultView
@{
    ViewData["Title"] = "Kết quả: " + Model.AssessmentTitle;
    ViewData["ActiveSection"] = "assessment";
}
@section Breadcrumbs {
    <nav class="studio-breadcrumbs" aria-label="Đường dẫn điều hướng">
        <ol class="breadcrumb-list">
            @if (Model.CourseId is Guid cid)
            {
                <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Index">Khóa học của tôi</a></li>
                <li class="breadcrumb-separator" aria-hidden="true">/</li>
                <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Course" asp-route-id="@cid">Về khóa học</a></li>
            }
            else
            {
                <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Progress">Tiến độ &amp; kết quả</a></li>
            }
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item" aria-current="page">Kết quả đánh giá</li>
        </ol>
    </nav>
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}

<div class="activity-scene exam-workspace-layout">
    <header class="activity-hero activity-result-header">
        <div class="activity-result-summary">
            <span class="activity-context">Kết quả đánh giá</span>
            <h1>@Model.AssessmentTitle</h1>
            <div class="activity-context">
                <time datetime="@Model.FinalizedAtUtc.ToString("O")">Đã chấm lúc @Model.FinalizedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy") (UTC+7)</time>
                <span>@(Model.FinalizationReason == AttemptFinalizationReason.DeadlineElapsed ? "Tự nộp khi hết giờ" : "Nộp bài chủ động")</span>
            </div>
            <div class="activity-actions">
                @if (Model.CourseId is Guid courseId)
                {
                    <a class="button" asp-controller="Learning" asp-action="Course" asp-route-id="@courseId">Về phòng học</a>
                }
                <a class="button secondary" asp-controller="Learning" asp-action="Dashboard" asp-fragment="recommendations-title">Xem gợi ý ôn tập theo kỹ năng</a>
                <a class="button secondary" asp-action="History" asp-route-id="@Model.AssessmentId">Lịch sử các lượt làm</a>
                @if (!Model.CourseId.HasValue)
                {
                    <a class="activity-course-link" asp-action="Index">Danh sách bài đánh giá</a>
                }
            </div>
        </div>
        <div class="activity-result-score">
            <span>Điểm tổng kết</span>
            <strong class="assessment-score">@Model.OverallScore.ToString("0.##")<span class="activity-score-scale"> / 100</span></strong>
            @if (Model.PassingScore is decimal passingScore)
            {
                <span class="badge activity-tag @(Model.Passed ? "assessment-passed good" : "assessment-failed danger")">
                    @(Model.Passed ? "Đạt chuẩn yêu cầu" : "Chưa đạt ngưỡng yêu cầu")
                </span>
                <span>Điểm đạt yêu cầu <b>@passingScore.ToString("0.##")/100</b></span>
            }
            else
            {
                <span>Không xét đạt / trượt</span>
            }
        </div>
    </header>

    <section class="activity-panel" aria-labelledby="skills-title">
        <div class="activity-section-title">
            <h2 id="skills-title">Điểm số theo kỹ năng</h2>
        </div>
        @if (Model.SkillBreakdowns.Count == 0)
        {
            <p class="muted activity-note">Chưa đủ dữ liệu để hiển thị điểm theo kỹ năng. Mỗi kỹ năng cần ít nhất 3 câu hỏi khác nhau; không được xem nhóm thiếu dữ liệu là 0 điểm.</p>
        }
        else
        {
            <p class="muted">Chỉ hiển thị kỹ năng có ít nhất 3 câu hỏi khác nhau. Điểm yếu được xác định khi điểm gốc dưới 60%, độc lập với ngưỡng đạt của bài.</p>
            <div class="assessment-table-wrap" role="region" aria-label="Điểm theo kỹ năng" tabindex="0">
                <table class="assessment-table">
                    <caption class="visually-hidden">Điểm kỹ năng chi tiết</caption>
                    <thead>
                        <tr>
                            <th scope="col">Kỹ năng</th>
                            <th scope="col">Số câu hỏi</th>
                            <th scope="col">Điểm số / 100</th>
                            <th scope="col">Đánh giá</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var skill in Model.SkillBreakdowns)
                    {
                        <tr>
                            <td class="activity-cell-title">
                                <partial name="_UiText" model="skill.Skill" />
                            </td>
                            <td>@skill.QuestionCount câu</td>
                            <td class="activity-cell-title">
                                @skill.Score.ToString("0.##")
                            </td>
                            <td>
                                @* Không phân loại lại từ Score vì điểm hiển thị đã được làm tròn. *@
                                @if (skill.IsWeak)
                                {
                                    <span class="activity-tag attention">Cần cải thiện</span>
                                }
                                else
                                {
                                    <span class="activity-tag good">Không thuộc nhóm điểm yếu</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.QuestionFeedback.Count > 0)
    {
        <section class="activity-panel" aria-labelledby="assessment-feedback-title">
            <div class="activity-section-title">
                <h2 id="assessment-feedback-title">Chi tiết câu trả lời tự nhập, ghép cặp và sắp xếp</h2>
            </div>
            <div class="activity-review-list">
                @foreach (var item in Model.QuestionFeedback)
                {
                    <article class="exam-question-card">
                        <div class="exam-question-header">
                            <h3 class="activity-tag">Câu @item.Number</h3>
                            <span class="exam-q-points">Điểm @item.EarnedPoints.ToString("0.##") / @item.Points.ToString("0.##")</span>
                        </div>
                        <div class="reading-copy preserve">@item.Content</div>
                        <dl class="activity-answer">
                            <dt>Câu trả lời của bạn</dt>
                            <dd class="preserve">@(item.SubmittedAnswer ?? "Bỏ trống")</dd>
                        </dl>
                    </article>
                }
            </div>
        </section>
    }
</div>
