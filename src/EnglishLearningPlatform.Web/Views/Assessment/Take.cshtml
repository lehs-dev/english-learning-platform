@using EnglishLearningPlatform.Web.Models.Assessment
@using EnglishLearningPlatform.Domain.Enums
@model AssessmentTakePage
@{
    ViewData["Title"] = Model.Sheet?.Title ?? Model.Overview!.Title;
    ViewData["ActiveSection"] = "assessment";
    var overview = Model.Overview;
}
@section Styles { <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" /> }

<div class="exam-workspace-layout">
    <header class="exam-header-bar">
        <div class="exam-header-left">
            @if (overview?.CourseId is Guid courseId)
            {
                <a class="button secondary exam-back-btn" asp-controller="Learning" asp-action="Course" asp-route-id="@courseId">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    <span>Về khóa học</span>
                </a>
            }
            <div class="exam-title-group">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="v2-pill-tag">Bài kiểm tra</span>
                    @if (Model.Sheet is not null)
                    {
                        <span class="v2-pill-tag" style="background: #E0F2FE; color: #0369A1;">Đang làm bài</span>
                    }
                </div>
                <h1 class="exam-title">@ViewData["Title"]</h1>
            </div>
        </div>
        @if (Model.Sheet is not null || overview?.UsedAttempts > 0)
        {
            <a class="button secondary" asp-action="History" asp-route-id="@(Model.Sheet?.AssessmentId ?? overview?.AssessmentId)">Lịch sử làm bài</a>
        }
    </header>

    @if (TempData["AssessmentError"] is string error) { <p class="notice error" role="alert">@error</p> }
    @if (TempData["AssessmentSuccess"] is string success) { <p class="notice" role="status">@success</p> }

    @if (Model.Sheet is { } sheet)
    {
        <form class="exam-form-grid" asp-action="Submit" asp-route-id="@sheet.AttemptId" method="post" data-assessment-form data-save-url="@Url.Action("Save", new { id = sheet.AttemptId })">
            
            <!-- LEFT: Questions Column -->
            <div class="exam-questions-column">
                @if (!string.IsNullOrWhiteSpace(sheet.Description))
                {
                    <div class="exam-intro-card">
                        <div class="exam-intro-icon">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>
                        </div>
                        <div class="exam-intro-text">
                            <strong>Hướng dẫn bài thi</strong>
                            <p class="preserve">@sheet.Description</p>
                        </div>
                    </div>
                }

                @for (var i = 0; i < sheet.Questions.Count; i++)
                {
                    var question = sheet.Questions[i];
                    @* tabindex=-1 giúp liên kết số câu đưa focus đến đúng câu, không thêm Tab thừa. *@
                    <fieldset class="exam-question-card" id="question-@(i + 1)" tabindex="-1" aria-label="Câu @(i + 1)" data-question>
                        <input type="hidden" name="Answers[@i].AssessmentQuestionId" value="@question.AssessmentQuestionId" />
                        
                        <div class="exam-question-header">
                            <span class="v2-pill-tag exam-q-badge">Câu @(i + 1)</span>
                            <span class="exam-q-points">@question.Points.ToString("0.##") điểm</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(question.StimulusContent))
                        {
                            <div class="exam-stimulus-box">
                                <div class="stimulus-label">
                                    <svg class="icon" aria-hidden="true" style="width: 14px; height: 14px;"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                                    <span>Bài đọc / Ngữ cảnh:</span>
                                </div>
                                <div class="preserve">@question.StimulusContent</div>
                            </div>
                        }

                        <div class="exam-question-content preserve">@question.Content</div>

                        @if (question.AudioUrl is not null)
                        {
                            <div class="exam-audio-box">
                                <audio controls preload="none" src="@question.AudioUrl" aria-label="Âm thanh câu @(i + 1)">Trình duyệt chưa hỗ trợ âm thanh.</audio>
                                <partial name="_ExternalStimulusAudioNotice" model="question.AudioUrl" />
                                <p class="exam-timer-note" style="margin-top: 6px;">Nếu audio không phát, kiểm tra kết nối và dùng nút phát để thử lại.</p>
                            </div>
                        }

                        <div class="exam-options-list" role="radiogroup" aria-label="Đáp án câu @(i + 1)">
                            @for (var optIdx = 0; optIdx < question.Options.Count; optIdx++)
                            {
                                var option = question.Options[optIdx];
                                var optionLetter = (char)('A' + optIdx);
                                var isChecked = question.SelectedOptionId == option.Id;
                                <label class="exam-option-card @(isChecked ? "is-selected" : "")" for="option-@option.Id">
                                    <input type="radio" id="option-@option.Id" class="exam-option-radio" name="Answers[@i].SelectedOptionId" value="@option.Id" checked="@isChecked" />
                                    <span class="exam-option-badge">@optionLetter</span>
                                    <span class="exam-option-text preserve">@option.Content</span>
                                </label>
                            }
                        </div>

                        <div class="exam-question-footer">
                            @* Chỉ đổi vị trí trong trang; không gửi form hay tạo Attempt mới. *@
                            <nav class="exam-question-navigation" aria-label="Điều hướng từ câu @(i + 1)">
                                @if (i > 0)
                                {
                                    <a class="button secondary" href="#question-@i">Câu trước</a>
                                }
                                @if (i < sheet.Questions.Count - 1)
                                {
                                    <a class="button secondary" href="#question-@(i + 2)">Câu tiếp</a>
                                }
                            </nav>
                            <label class="exam-clear-selection" for="clear-q-@(i + 1)">
                                <input type="radio" id="clear-q-@(i + 1)" class="exam-option-radio visually-hidden" name="Answers[@i].SelectedOptionId" value="" checked="@(!question.SelectedOptionId.HasValue)" />
                                <span class="exam-clear-text">
                                    <svg class="icon" aria-hidden="true" style="width: 14px; height: 14px;"><use href="@Url.Content("~/images/icons.svg#rotate-ccw")"></use></svg>
                                    <span>Bỏ chọn đáp án</span>
                                </span>
                            </label>
                        </div>
                    </fieldset>
                }
            </div>

            <!-- RIGHT: Sticky Sidebar Console -->
            <aside class="exam-sidebar-column" aria-label="Bảng điều khiển bài thi">
                <div class="exam-sticky-console">
                    
                    <!-- Countdown Timer Card -->
                    <div class="exam-timer-card" data-assessment-clock data-deadline="@sheet.DeadlineUtc.ToString("O")" data-server-now="@DateTimeOffset.UtcNow.ToString("O")">
                        <div class="exam-timer-header">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clock")"></use></svg>
                            <span>Thời gian còn lại</span>
                        </div>
                        <div class="exam-timer-display" data-time-remaining aria-live="off">Đang tính…</div>
                        <p class="exam-timer-note">Hết giờ, bài sẽ tự động nộp với các đáp án đã lưu.</p>
                        <noscript><p class="exam-timer-note" style="margin-top: 6px; color: #DC2626;">JS đang tắt. Hạn nộp: <time datetime="@sheet.DeadlineUtc.ToString("O")">@sheet.DeadlineUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm:ss dd/MM/yyyy")</time></p></noscript>
                    </div>

                    <!-- Question Palette Card -->
                    <nav class="exam-palette-card" aria-label="Danh sách câu hỏi">
                        <div class="exam-palette-header">
                            <h3>Danh sách câu hỏi</h3>
                            <p class="exam-timer-note" data-answer-progress role="status">@sheet.Questions.Count(q => q.SelectedOptionId.HasValue)/@sheet.Questions.Count câu đã trả lời</p>
                        </div>
                        <div class="exam-palette-grid">
                            @for (var i = 0; i < sheet.Questions.Count; i++)
                            {
                                <a class="exam-palette-btn" href="#question-@(i + 1)" data-question-link="@(i + 1)" aria-label="Đến câu @(i + 1)">@(i + 1)</a>
                            }
                        </div>
                        <div class="exam-palette-legend">
                            <div class="legend-item">
                                <span class="legend-dot is-answered"></span>
                                <span>Đã trả lời</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-dot"></span>
                                <span>Chưa trả lời</span>
                            </div>
                        </div>
                    </nav>

                    <!-- Actions Card -->
                    <div class="exam-actions-card">
                        <button class="button exam-submit-btn" type="submit" data-submit-button>Nộp bài thi</button>
                        <button class="button secondary exam-save-btn" type="submit" asp-action="Save" asp-route-id="@sheet.AttemptId" data-save-button>Lưu đáp án</button>
                        <p class="exam-save-status" data-save-status role="status">Tự động lưu khi bạn chọn đáp án</p>
                    </div>

                </div>
            </aside>

            <!-- Submission Confirmation Dialog -->
            <dialog class="exam-confirm-dialog" data-submit-dialog aria-labelledby="submit-dialog-title">
                <h2 id="submit-dialog-title">Xác nhận nộp bài</h2>
                <p data-submit-summary></p>
                <p>Sau khi nộp, bạn không thể thay đổi đáp án của lượt thi này.</p>
                <div class="actions">
                    <button class="button secondary" type="button" data-cancel-submit>Tiếp tục làm bài</button>
                    <button class="button" type="button" data-confirm-submit>Xác nhận nộp bài</button>
                </div>
            </dialog>
        </form>
    }
    else if (overview is not null)
    {
        <!-- Overview / Not Started View -->
        <section class="card-v2" aria-labelledby="assessment-overview-title" style="padding: 32px;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                <span class="v2-pill-tag">Tổng quan</span>
                <h2 id="assessment-overview-title" style="margin: 0; font-size: 20px;">Thông tin bài thi</h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(overview.Description)) { <p class="preserve" style="color: var(--v2-text-secondary); margin-bottom: 20px;">@overview.Description</p> }
            <partial name="_AssessmentDetails" model="overview" />
            <div style="margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--v2-border-light);">
                @if (overview.AttemptHistory.Any(a => a.Status == AttemptStatus.InProgress))
                {
                    <div class="notice" style="margin-bottom: 16px;">Lượt làm trước đã hết giờ. Hoàn tất chấm điểm để xem kết quả trước khi bắt đầu lượt mới.</div>
                    <form asp-action="Start" asp-route-id="@overview.AssessmentId" method="post"><button class="button" type="submit">Hoàn tất lượt đã hết giờ</button></form>
                }
                else if (overview.UsedAttempts < overview.MaxAttempts)
                {
                    <p class="muted" style="margin-bottom: 16px;">Thời gian được tính ngay khi bấm bắt đầu. Bạn có thể quay lại tiếp tục trong thời gian còn lại.</p>
                    <form asp-action="Start" asp-route-id="@overview.AssessmentId" method="post"><button class="button" type="submit" style="padding: 12px 28px; font-size: 15px;">Bắt đầu làm bài</button></form>
                }
                else { <div class="notice">Bạn đã sử dụng hết lượt làm bài.</div> }
            </div>
        </section>
    }

    <!-- Attempt History Table (Displayed in Overview mode) -->
    @if (overview?.AttemptHistory.Count > 0 && Model.Sheet == null)
    {
        <section class="card-v2" aria-labelledby="attempt-history-title" style="padding: 32px; margin-top: 24px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;">
                <h2 id="attempt-history-title" style="margin: 0; font-size: 18px; font-weight: 700;">Lịch sử làm bài (@overview.AttemptHistory.Count lượt)</h2>
            </div>
            <partial name="_AttemptHistory" model="overview.AttemptHistory" />
        </section>
    }
</div>

@section Scripts { <script src="~/js/assessment.js" asp-append-version="true" defer></script> }
