@{ ViewData["Title"] = "Chưa thể mua khóa học"; }
@section Styles { <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" /> }
<div class="checkout-page">
    <header class="checkout-heading">
        <h1>Chưa thể mua khóa học</h1>
    </header>
    <partial name="_CourseNotice" />
    <section class="panel checkout-card">
        <p class="notice" role="status">Khóa học hiện không đủ điều kiện mua. Vui lòng chọn khóa học khác.</p>
        <a class="button secondary" asp-controller="Courses" asp-action="Index">Về danh mục khóa học</a>
    </section>
</div>
