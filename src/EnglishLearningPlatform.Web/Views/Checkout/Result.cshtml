@model EnglishLearningPlatform.Application.Commerce.CheckoutPage
@{ ViewData["Title"] = "Thanh toán khóa học"; }
<a asp-controller="Learning" asp-action="Index">← Khóa đã tham gia</a>
<section class="panel course-hero">
    <h1>@Model.CourseTitle</h1>
    <p>Mã đơn hàng: <strong>@Model.Id</strong></p>
    <p>Số tiền: <strong>@Model.Amount.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) @Model.Currency</strong></p>
    @if (Model.Enrolled)
    {
        <p class="notice" role="status">Bạn đã có quyền học khóa này.</p>
        <a class="button" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">Vào học</a>
    }
    else if (Model.Status == PaymentStatus.Succeeded)
    {
        <p class="notice error" role="alert">Thanh toán đã được xác nhận, nhưng khóa học hoặc tài khoản hiện không đủ điều kiện tham gia. Vui lòng liên hệ hỗ trợ kèm mã đơn hàng.</p>
    }
    else if (Model.Status == PaymentStatus.Failed)
    {
        <p class="notice error">Thanh toán không thành công. Bạn chưa được cấp quyền học.</p>
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Quay lại khóa học để thử lại</a>
    }
    else
    {
        <p class="notice" role="status">Đang chờ xác nhận thanh toán. Quyền học được cấp sau khi hệ thống xác nhận thành công.</p>
        @if (Model.CheckoutUrl is not null)
        {
            <a class="button" href="@Model.CheckoutUrl">Đến trang thanh toán</a>
        }
        else
        {
            <p class="muted">Đơn hàng đã hết hạn hoặc thanh toán hiện không khả dụng.</p>
            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Quay lại khóa học</a>
        }
        <a class="button secondary" asp-action="Result" asp-route-id="@Model.Id">Kiểm tra trạng thái</a>
    }
</section>
