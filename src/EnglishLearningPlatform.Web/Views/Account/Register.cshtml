@model EnglishLearningPlatform.Web.Models.Account.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<h1>Đăng ký tài khoản Student</h1>

@if (ViewBag.SuccessMessage != null)
{
    <p role="status">@ViewBag.SuccessMessage</p>
}

<form asp-controller="Account" asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" autocomplete="name" />
        <span asp-validation-for="FullName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit">Đăng ký</button>
</form>
