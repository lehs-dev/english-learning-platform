@model EnglishLearningPlatform.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["PageClass"] = "auth-page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}
<section class="auth-shell register-shell" aria-labelledby="auth-title">
    <partial name="_AuthAside" />
    <div class="auth-form-panel">
        <div class="auth-heading">
            <span class="section-kicker">BẮT ĐẦU HÀNH TRÌNH CỦA BẠN</span>
            <h1 id="auth-title">Tạo tài khoản</h1>
            <p>Tham gia Estudy với tài khoản học viên miễn phí.</p>
        </div>
        @if (ViewBag.SuccessMessage is not null)
        {
            <div class="notice notice-success" role="status">@ViewBag.SuccessMessage <a asp-action="Login">Đăng nhập ngay →</a></div>
        }
        <form class="account-form" asp-controller="Account" asp-action="Register" method="post">
            <div class="validation-summary" asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="form-field">
                <label asp-for="FullName">Họ và tên</label>
                <input asp-for="FullName" autocomplete="name" placeholder="Nhập họ và tên của bạn" maxlength="200" aria-describedby="name-error" required />
                <span asp-validation-for="FullName" id="name-error" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" placeholder="Nhập email của bạn" maxlength="256" aria-describedby="email-error" required />
                <span asp-validation-for="Email" id="email-error" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password">Mật khẩu</label>
                <div class="password-field">
                    <input asp-for="Password" autocomplete="new-password" placeholder="Tạo mật khẩu" minlength="8" aria-describedby="password-hint password-error" required />
                    <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Hiện mật khẩu" aria-pressed="false">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>
                    </button>
                </div>
                <small class="field-hint" id="password-hint">Tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
                <span asp-validation-for="Password" id="password-error" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" aria-describedby="confirm-error" required />
                    <button type="button" class="password-toggle" data-password-toggle="ConfirmPassword" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" id="confirm-error" class="field-error"></span>
            </div>
            <button class="button button-primary button-full" type="submit">Tạo tài khoản <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></button>
        </form>
        <p class="auth-switch">Bạn đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập</a></p>
    </div>
</section>
<p class="auth-copyright">© 2026 Estudy. Cùng bạn chinh phục tiếng Anh.</p>
