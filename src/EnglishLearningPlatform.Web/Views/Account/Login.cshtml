@model EnglishLearningPlatform.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["PageClass"] = "auth-page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}
<section class="auth-shell" aria-labelledby="auth-title">
    <partial name="_AuthAside" />
    <div class="auth-form-panel">
        <div class="auth-heading">

            <h1 id="auth-title">Đăng nhập</h1>
            <p>Tiếp tục hành trình học tiếng Anh của bạn.</p>
        </div>
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="notice notice-success" role="status">@successMessage</div>
        }
        <div class="demo-account-shortcuts" aria-label="Chọn tài khoản demo">
            <span class="demo-account-label">Chuyển nhanh tài khoản demo</span>
            <div class="demo-account-buttons">
                <button type="button" class="demo-account-button" data-demo-email="student1@demo.example.test" aria-pressed="false">Học viên</button>
                <button type="button" class="demo-account-button" data-demo-email="teacher1@demo.example.test" aria-pressed="false">Giảng viên</button>
                <button type="button" class="demo-account-button" data-demo-email="admin1@demo.example.test" aria-pressed="false">Quản trị</button>
            </div>
            <span class="field-hint">@(string.IsNullOrWhiteSpace(Model.DemoPassword)
                ? "Chọn vai trò để điền email, sau đó nhập mật khẩu demo."
                : "Chọn vai trò để tự động điền email và mật khẩu demo.")</span>
        </div>
        <form class="account-form" asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div class="validation-summary" asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="form-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="username" placeholder="Nhập email của bạn" aria-describedby="email-error" required />
                <span asp-validation-for="Email" id="email-error" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password">Mật khẩu</label>
                <div class="password-field">
                    <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" aria-describedby="password-error" required />
                    <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Hiện mật khẩu" aria-pressed="false">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" id="password-error" class="field-error"></span>
            </div>
            <label class="checkbox-label"><input asp-for="RememberMe" /> <span>Ghi nhớ đăng nhập</span></label>
            <button class="button button-primary button-full" type="submit">Đăng nhập <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></button>
        </form>
        <p class="auth-switch">Bạn chưa có tài khoản? <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a></p>
        <a class="back-home" asp-controller="Home" asp-action="Index"><svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>Về trang chủ</a>
    </div>
</section>
<p class="auth-copyright">© 2026 Estudy. Cùng bạn chinh phục tiếng Anh.</p>
@section Scripts {
    <script>
        const demoPassword = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DemoPassword));
        document.querySelectorAll("[data-demo-email]").forEach((button) => {
            button.addEventListener("click", () => {
                const emailInput = document.getElementById("Email");
                const passwordInput = document.getElementById("Password");
                emailInput.value = button.dataset.demoEmail;
                passwordInput.value = demoPassword || "";
                [emailInput, passwordInput].forEach((input) => {
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                });
                if (passwordInput.value) {
                    document.querySelector(".account-form button[type='submit']").focus();
                } else {
                    passwordInput.focus();
                }
                document.querySelectorAll("[data-demo-email]").forEach((item) => item.setAttribute("aria-pressed", "false"));
                button.setAttribute("aria-pressed", "true");
            });
        });
    </script>
}
