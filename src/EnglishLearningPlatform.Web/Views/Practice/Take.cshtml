@model EnglishLearningPlatform.Application.Practice.PracticeSheet
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveSection"] = "courses";
    ViewData["FocusMode"] = true;
    ViewData["PageClass"] = "practice-taking-page";
    var hasPassage = Model.Questions.Any(q => !string.IsNullOrWhiteSpace(q.Passage));
}
@section Breadcrumbs {
    <nav class="studio-breadcrumbs" aria-label="Đường dẫn điều hướng">
        <ol class="breadcrumb-list">
            <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Index">Khóa học của tôi</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item" aria-current="page">@Model.Title</li>
        </ol>
    </nav>
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
}

<div class="exam-workspace-layout practice-workspace">
    <header class="exam-header-bar practice-header-bar">
        <div class="exam-header-left">
            <a class="button secondary exam-back-btn" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId" aria-label="Quay lại khóa học @Model.CourseTitle">
                <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                <span>@Model.CourseTitle</span>
            </a>
            <div class="exam-title-group">
                <div class="practice-header-badges">
                    <span class="v2-pill-tag">Bài luyện tập</span>
                    <span class="v2-pill-tag badge-subtle">Không giới hạn thời gian</span>
                    <span class="v2-pill-tag badge-subtle" data-practice-version="@Model.Version">Bản @Model.Version</span>
                    @if (Model.HasResult)
                    {
                        <a class="v2-pill-tag" style="background: #EAE8FB; color: var(--v2-dark); text-decoration: none;" asp-action="Result" asp-route-id="@Model.Id">
                            Xem kết quả gần nhất &rarr;
                        </a>
                    }
                </div>
                <h1 class="exam-title">@Model.Title</h1>
            </div>
        </div>
        <div class="practice-header-progress">
            <div class="practice-progress-pill" data-practice-progress role="status">
                0/@Model.Questions.Count câu đã trả lời
            </div>
            <div class="practice-progress-track" aria-hidden="true">
                <div class="practice-progress-fill" data-practice-bar style="width: 0%;"></div>
            </div>
        </div>
    </header>

    <form method="post" asp-action="Submit" asp-route-id="@Model.Id" class="exam-form-grid @(hasPassage ? "practice-reading-grid" : "practice-single-grid")" data-practice-form>
        <input type="hidden" name="SessionId" value="@Model.SessionId" />

        @if (hasPassage)
        {
            <details class="practice-passages" id="practice-passages" tabindex="-1" open>
                <summary>Bài đọc / Ngữ cảnh</summary>
                @foreach (var passage in Model.Questions.Where(q => !string.IsNullOrWhiteSpace(q.Passage)).Select(q => q.Passage).Distinct())
                {
                    <div class="exam-stimulus-box preserve">@passage</div>
                }
                <a class="practice-skip-to-question" href="#practice-question-1">Đến câu hỏi ↓</a>
            </details>
        }

        <!-- Questions Column -->
        <div class="exam-questions-column">
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];
                <fieldset class="exam-question-card @(index == 0 ? "is-active-question" : "")" id="practice-question-@(index + 1)" data-practice-question data-question-index="@index">
                    <input type="hidden" name="Answers[@index].PracticeQuestionId" value="@question.Id" />
                    
                    <div class="exam-question-header">
                        <span class="v2-pill-tag exam-q-badge">Câu @(index + 1) / @Model.Questions.Count · <partial name="_UiText" model="question.Skill" /></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(question.Passage))
                    {
                        <a class="practice-back-passage" href="#practice-passages">↑ Xem lại bài đọc</a>
                    }

                    <div class="exam-question-content preserve">@question.Content</div>

                    @if (question.AudioUrl is not null)
                    {
                        <div class="exam-audio-box">
                            <audio controls preload="none" src="@question.AudioUrl" aria-label="Âm thanh câu @(index + 1)">Trình duyệt chưa hỗ trợ âm thanh.</audio>
                            <partial name="_ExternalStimulusAudioNotice" model="question.AudioUrl" />
                        </div>
                    }

                    @if (question.QuestionType == EnglishLearningPlatform.Domain.Enums.QuestionType.FillBlank)
                    {
                        <partial name="_QuestionFillBlank" model="@((question, index))" />
                    }
                    else if (question.StructuredPrompt is { } prompt)
                    {
                        <partial name="_StructuredQuestion" model="@(new EnglishLearningPlatform.Web.Models.StructuredQuestionInputModel(
                            $"practice-structured-{index}", $"Answers[{index}].StructuredAnswerJson", question.QuestionType, prompt))" />
                    }
                    else
                    {
                        <partial name="_QuestionMcq" model="@((question, index))" />
                    }
                </fieldset>
            }

            <!-- Bottom Sticky Bar -->
            <div class="practice-bottom-bar" aria-label="Bảng điều khiển làm bài">
                <div class="practice-bottom-inner">
                    <div class="practice-nav-controls">
                        <button class="button secondary button-sm practice-prev-btn" type="button" data-practice-prev aria-label="Câu trước" disabled>
                            &lsaquo; Câu trước
                        </button>
                        <div class="practice-palette-strip" aria-label="Danh sách câu hỏi">
                            @for (var index = 0; index < Model.Questions.Count; index++)
                            {
                                <button class="practice-palette-btn @(index == 0 ? "is-current" : "")" type="button" data-practice-link="@(index + 1)" aria-label="Đến câu @(index + 1)">
                                    @(index + 1)
                                </button>
                            }
                        </div>
                        <button class="button secondary button-sm practice-next-btn" type="button" data-practice-next aria-label="Câu tiếp theo" @(Model.Questions.Count <= 1 ? "disabled" : "")>
                            Tiếp theo &rsaquo;
                        </button>
                    </div>
                    <div class="practice-submit-wrap">
                        <button class="button exam-submit-btn" type="submit" data-practice-submit>
                            Nộp bài &amp; Xem giải thích
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Confirmation Dialog for Incomplete Submissions -->
<dialog class="practice-confirm-dialog" id="practice-confirm-dialog" data-practice-confirm-dialog>
    <div class="practice-dialog-card">
        <h3 class="practice-dialog-title">Xác nhận nộp bài</h3>
        <p class="practice-dialog-message" data-confirm-message>
            Bạn đã trả lời <strong data-answered-count>0</strong>/@Model.Questions.Count câu hỏi, còn <strong data-unanswered-count>@Model.Questions.Count</strong> câu chưa làm. Bạn có chắc chắn muốn nộp bài?
        </p>
        <div class="practice-dialog-actions">
            <button type="button" class="button secondary" data-cancel-submit>Quay lại làm bài</button>
            <button type="button" class="button danger-btn" data-confirm-submit>Vẫn nộp bài</button>
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/structured-answer.js" asp-append-version="true" defer></script>
    <script src="~/js/practice.js" asp-append-version="true" defer></script>
}
