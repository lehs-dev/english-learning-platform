@model EnglishLearningPlatform.Application.Practice.PracticeSheet
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveSection"] = "courses";
    ViewData["FocusMode"] = true;
    ViewData["PageClass"] = "practice-taking-page";
    var passages = Model.Questions
        .Select(q => q.Passage)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct()
        .ToList();
    var hasPassage = passages.Count > 0;
    var isMistakeReview = Model.ReviewStamp is not null;
}
@section Breadcrumbs {
    <nav class="studio-breadcrumbs" aria-label="Đường dẫn điều hướng">
        <ol class="breadcrumb-list">
            <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Index">Khóa học của tôi</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item" aria-current="page">@Model.Title</li>
        </ol>
    </nav>
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}

<div class="activity-scene exam-workspace-layout practice-workspace">
    <header class="exam-header-bar practice-header-bar">
        <div class="exam-header-left">
            <a class="activity-course-link" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId" aria-label="Quay lại khóa học @Model.CourseTitle">
                <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                <span>@Model.CourseTitle</span>
            </a>
            <div class="exam-title-group">
                <div class="activity-context">
                    <span>@(isMistakeReview ? "Ôn câu sai và bỏ trống" : "Bài luyện tập")</span>
                    <span>Không giới hạn thời gian</span>
                    <span data-practice-version="@Model.Version">Bản @Model.Version</span>
                    @if (Model.HasResult)
                    {
                        <a asp-action="Result" asp-route-id="@Model.Id">
                            Xem kết quả gần nhất <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                </div>
                <h1 class="exam-title">@Model.Title</h1>
            </div>
        </div>
        <div class="practice-header-progress">
            <div class="practice-progress-pill" data-practice-progress role="status">
                0/@Model.Questions.Count câu đã trả lời
            </div>
            <div class="practice-progress-track" aria-hidden="true">
                <div class="practice-progress-fill" data-practice-bar style="width: 0%;"></div>
            </div>
        </div>
    </header>

    <form method="post" asp-action="@(isMistakeReview ? "CheckReview" : "Submit")" asp-route-id="@Model.Id" class="exam-form-grid practice-study4-grid" data-practice-form>
        @if (isMistakeReview)
        {
            <input type="hidden" name="ReviewStamp" value="@Model.ReviewStamp" />
        }
        else
        {
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
        }

        <!-- LEFT: Passages + All Questions Expanded (Study4 style) -->
        <div class="exam-questions-column">
            @if (hasPassage)
            {
                <details class="practice-passages" id="practice-passages" tabindex="-1" open>
                    <summary>
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                        Bài đọc / Ngữ cảnh @(passages.Count > 1 ? $"({passages.Count} đoạn)" : "")
                    </summary>
                    @for (var pIdx = 0; pIdx < passages.Count; pIdx++)
                    {
                        <div class="exam-stimulus-box preserve" data-passage-box="@pIdx">
                            @if (passages.Count > 1)
                            {
                                <div class="stimulus-label">Đoạn @(pIdx + 1)</div>
                            }
                            @passages[pIdx]
                        </div>
                    }
                    @if (Model.Questions.Count > 0)
                    {
                        <a class="practice-skip-to-question" href="#practice-question-1">Đến câu hỏi ↓</a>
                    }
                </details>
            }

            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];
                var passageIndex = !string.IsNullOrWhiteSpace(question.Passage) ? passages.IndexOf(question.Passage!) : -1;
                <fieldset class="exam-question-card @(index == 0 ? "is-active-question" : "")" id="practice-question-@(index + 1)" tabindex="-1" aria-label="Câu @(index + 1)" data-practice-question data-question-index="@index" data-question-passage="@passageIndex">
                    <input type="hidden" name="Answers[@index].PracticeQuestionId" value="@question.Id" />
                    
                    <div class="exam-question-header">
                        <span class="activity-tag exam-q-badge">Câu @(index + 1) / @Model.Questions.Count · <partial name="_UiText" model="question.Skill" /></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(question.Passage))
                    {
                        <a class="practice-back-passage" href="#practice-passages">↑ Xem lại bài đọc</a>
                    }

                    <div class="exam-question-content preserve">@question.Content</div>

                    @if (question.AudioUrl is not null)
                    {
                        <div class="exam-audio-box">
                            <audio controls preload="none" src="@question.AudioUrl" aria-label="Âm thanh câu @(index + 1)">Trình duyệt chưa hỗ trợ âm thanh.</audio>
                            <partial name="_ExternalStimulusAudioNotice" model="question.AudioUrl" />
                        </div>
                    }

                    @if (question.QuestionType is EnglishLearningPlatform.Domain.Enums.QuestionType.FillBlank or EnglishLearningPlatform.Domain.Enums.QuestionType.Dictation)
                    {
                        <partial name="_QuestionFillBlank" model="@((question, index))" />
                    }
                    else if (question.StructuredPrompt is { } prompt)
                    {
                        <partial name="_StructuredQuestion" model="@(new EnglishLearningPlatform.Web.Models.StructuredQuestionInputModel(
                            $"practice-structured-{index}", $"Answers[{index}].StructuredAnswerJson", question.QuestionType, prompt))" />
                    }
                    else
                    {
                        <partial name="_QuestionMcq" model="@((question, index))" />
                    }
                </fieldset>
            }
        </div>

        <!-- RIGHT: Sticky Question Palette & Submit (Study4 style) -->
        <aside class="exam-sidebar-column" aria-label="Bảng câu hỏi và nộp bài">
            <div class="exam-sticky-console">
                <div class="exam-actions-card">
                    <button class="button exam-submit-btn" type="submit" data-practice-submit aria-label="@(isMistakeReview ? "Chấm lượt ôn" : "Nộp bài & Xem giải thích")">
                        @if (isMistakeReview)
                        {
                            <span>Chấm lượt ôn</span>
                        }
                        else
                        {
                            <span>Nộp bài<span class="practice-submit-description"> &amp; Xem giải thích</span></span>
                        }
                    </button>
                    <p class="exam-timer-note practice-sidebar-note" data-practice-sidebar-status>Làm toàn bộ câu hỏi ở bên trái rồi bấm nộp bài.</p>
                </div>

                <nav class="exam-palette-card" aria-label="Danh sách câu hỏi">
                    <div class="exam-palette-header">
                        <h3>Danh sách câu hỏi</h3>
                        <p class="exam-timer-note" data-practice-palette-progress>0/@Model.Questions.Count đã làm</p>
                    </div>
                    <div class="exam-palette-grid practice-palette-grid">
                        @for (var index = 0; index < Model.Questions.Count; index++)
                        {
                            <button class="exam-palette-btn practice-palette-btn @(index == 0 ? "is-current" : "")" type="button" data-practice-link="@(index + 1)" aria-label="Đến câu @(index + 1)">
                                @(index + 1)
                            </button>
                        }
                    </div>
                    <div class="exam-palette-legend">
                        <div class="legend-item">
                            <span class="legend-dot is-answered"></span>
                            <span>Đã làm</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot"></span>
                            <span>Chưa làm</span>
                        </div>
                    </div>
                </nav>
            </div>
        </aside>
    </form>
</div>

<!-- Confirmation Dialog for Incomplete Submissions -->
<dialog class="practice-confirm-dialog activity-confirm-dialog" id="practice-confirm-dialog" data-practice-confirm-dialog aria-labelledby="practice-confirm-title">
    <div class="practice-dialog-card">
        <h3 class="practice-dialog-title" id="practice-confirm-title">@(isMistakeReview ? "Xác nhận chấm lượt ôn" : "Xác nhận nộp bài")</h3>
        <p class="practice-dialog-message" data-confirm-message>
            Bạn đã trả lời <strong data-answered-count>0</strong>/@Model.Questions.Count câu hỏi, còn <strong data-unanswered-count>@Model.Questions.Count</strong> câu chưa làm.
        </p>
        <div class="practice-dialog-actions">
            <button type="button" class="button secondary" data-cancel-submit>Quay lại làm bài</button>
            <button type="button" class="button danger-btn" data-confirm-submit>@(isMistakeReview ? "Vẫn chấm lượt ôn" : "Vẫn nộp bài")</button>
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/structured-answer.js" asp-append-version="true" defer></script>
    <script src="~/js/practice.js" asp-append-version="true" defer></script>
}
