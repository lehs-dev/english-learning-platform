@model PracticeHubPage
@{
    ViewData["Title"] = "Luyện tập";
    ViewData["ActiveSection"] = "courses";
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}

<div class="activity-scene activity-catalog">
    <header class="activity-hero">
        <div>
            <h1>Luyện tập theo kỹ năng</h1>
            <p>Chọn bài để luyện nghe, đọc, từ vựng hoặc ngữ pháp. Xem lời giải ngay sau khi nộp.</p>
        </div>
        <div class="activity-actions">
            <a class="button" href="#practice-list-title">Xem bài luyện</a>
            <a class="button secondary" asp-controller="Learning" asp-action="Dashboard">Về bàn học</a>
        </div>
    </header>

    <section aria-labelledby="practice-list-title">
        <div class="activity-section-title">
            <h2 id="practice-list-title">Bài luyện khả dụng</h2>
            <span class="muted">@Model.Practices.Count bài</span>
        </div>
        @if (Model.Practices.Count == 0)
        {
            <div class="activity-panel activity-empty">
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                <h3>Chưa có bài luyện nào khả dụng</h3>
                <p>Bài luyện sẽ xuất hiện khi khóa học bạn tham gia có nội dung luyện tập được mở.</p>
                <a class="button" asp-controller="Learning" asp-action="Index">Xem khóa học của tôi</a>
            </div>
        }
        else
        {
            <div class="activity-grid">
                @foreach (var practice in Model.Practices)
                {
                    <article class="activity-card">
                        <span class="activity-tag">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                            @practice.QuestionCount câu
                        </span>
                        <div class="activity-card-heading">
                            <h3>@practice.Title</h3>
                            <p class="activity-meta">
                                <a asp-controller="Learning" asp-action="Course" asp-route-id="@practice.CourseId">@practice.CourseTitle</a>
                            </p>
                        </div>
                        <div class="activity-tags">
                            @foreach (var skill in practice.Skills)
                            {
                                <span class="activity-tag neutral"><partial name="_UiText" model="skill" /></span>
                            }
                        </div>
                        <footer class="activity-card-footer">
                            <a class="button" asp-action="Take" asp-route-id="@practice.Id">
                                Luyện ngay
                                <svg class="icon" width="16" height="16" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                            </a>
                        </footer>
                    </article>
                }
            </div>
        }
    </section>

    <section aria-labelledby="practice-recommendations-title">
        <div class="activity-section-title">
            <h2 id="practice-recommendations-title">Gợi ý ôn tập theo kỹ năng</h2>
        </div>
        @if (Model.Recommendations.Count == 0)
        {
            <div class="activity-panel activity-empty">
                <p>Hoàn thành một bài đánh giá năng lực để nhận gợi ý theo kỹ năng cần cải thiện.</p>
                <a class="button secondary" asp-controller="Assessment" asp-action="Index">Xem bài đánh giá</a>
            </div>
        }
        else
        {
            <div class="activity-grid">
                @foreach (var recommendation in Model.Recommendations)
                {
                    <article class="activity-card">
                        <div class="activity-card-top">
                            <h3><partial name="_UiText" model="recommendation.Skill" /></h3>
                            <span class="activity-tag attention">@recommendation.Score.ToString("0.##")%</span>
                        </div>
                        <p class="activity-meta">
                            Căn cứ từ bài: <a asp-controller="Assessment" asp-action="Result" asp-route-id="@recommendation.AttemptId">@recommendation.AssessmentTitle</a>
                        </p>
                        @if (recommendation.Contents.Count == 0)
                        {
                            <p class="activity-meta">Chưa có nội dung phù hợp để ôn kỹ năng này.</p>
                        }
                        else
                        {
                            <div class="activity-tags">
                                @foreach (var content in recommendation.Contents.Take(3))
                                {
                                    switch (content.Kind)
                                    {
                                        case RecommendedContentKind.Course:
                                            <a class="button secondary" asp-controller="Learning" asp-action="Course" asp-route-id="@content.Id">Học · @content.Title</a>
                                            break;
                                        case RecommendedContentKind.Practice:
                                            <a class="button secondary" asp-controller="Practice" asp-action="Take" asp-route-id="@content.Id">Luyện · @content.Title</a>
                                            break;
                                        case RecommendedContentKind.Assessment:
                                            <a class="button secondary" asp-controller="Assessment" asp-action="Take" asp-route-id="@content.Id">Đánh giá · @content.Title</a>
                                            break;
                                    }
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="activity-panel" aria-labelledby="practice-results-title">
        <div class="activity-section-title">
            <h2 id="practice-results-title">Kết quả luyện tập gần đây</h2>
        </div>
        @if (Model.Results.Count == 0)
        {
            <p class="muted">Bạn chưa nộp bài luyện tập nào.</p>
        }
        else
        {
            <div class="assessment-table-wrap" role="region" aria-labelledby="practice-results-title" tabindex="0">
                <table class="assessment-table">
                    <thead>
                        <tr>
                            <th scope="col">Bài luyện</th>
                            <th scope="col">Điểm</th>
                            <th scope="col">Nộp lúc</th>
                            <th scope="col"><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.Results)
                        {
                            <tr>
                                <th scope="row">@result.Title</th>
                                <td><strong>@result.Score.ToString("0.##")%</strong></td>
                                <td>
                                    <time datetime="@result.SubmittedAtUtc.ToString("O")">@result.SubmittedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time>
                                </td>
                                <td><a class="button secondary" asp-action="Result" asp-route-id="@result.PracticeId">Xem lại</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
