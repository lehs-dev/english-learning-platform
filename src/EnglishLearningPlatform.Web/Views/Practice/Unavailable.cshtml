@{ ViewData["Title"] = "Bài luyện chưa khả dụng"; }
@section Styles {
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}

<div class="activity-scene">
    <section class="activity-panel activity-empty" aria-labelledby="unavailable-practice-title">
        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clock")"></use></svg>
        <h1 id="unavailable-practice-title">Bài luyện chưa khả dụng</h1>
        <p>Bài luyện hoặc nội dung trong khóa đã thay đổi trạng thái. Bạn vẫn có thể xem kết quả đã nộp.</p>
        <a class="button" asp-controller="Learning" asp-action="Dashboard">Về bàn học của tôi</a>
    </section>
</div>
