@model EnglishLearningPlatform.Application.Practice.PracticeResult
@{
    ViewData["Title"] = "Kết quả luyện tập · " + Model.Title;
    ViewData["ActiveSection"] = "courses";
    bool mistakesOnly = ViewData["MistakesOnly"] is true;
    int correct = Model.Questions.Count(question => question.IsCorrect);
    int mistakes = Model.Questions.Count - correct;
}
@section Breadcrumbs {
    <nav class="studio-breadcrumbs" aria-label="Đường dẫn điều hướng">
        <ol class="breadcrumb-list">
            <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Index">Khóa học của tôi</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item"><a asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">Về khóa học</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-item" aria-current="page">Kết quả luyện tập</li>
        </ol>
    </nav>
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}

<div class="activity-scene exam-workspace-layout practice-result-workspace">
    <header class="activity-hero activity-result-header">
        <div class="activity-result-summary">
            <div class="activity-tags">
                <span>Kết quả luyện tập</span>
                <span data-result-version="@Model.Version">Phiên bản @Model.Version</span>
            </div>
            <h1>@Model.Title</h1>
            <div class="activity-context">
                <time datetime="@Model.SubmittedAtUtc.ToString("O")">Nộp lúc @Model.SubmittedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy") (UTC+7)</time>
            </div>
            <div class="activity-actions">
                @if (ViewData["CanRetry"] is true)
                {
                    <a class="button" asp-action="Take" asp-route-id="@Model.PracticeId">Luyện lại bài này</a>
                }
                <a class="button secondary" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">Quay lại khóa học</a>
            </div>
        </div>
        <div class="activity-result-score">
            <span>Tổng điểm bài luyện</span>
            <strong class="assessment-score">@Model.Score.ToString("0.##")<span class="activity-score-scale"> / 100</span></strong>
            <span>Bạn trả lời đúng @correct / @Model.Questions.Count câu hỏi.</span>
        </div>
    </header>

    <section class="activity-panel" aria-labelledby="practice-review-title">
        <div class="activity-section-title activity-review-heading">
            <h2 id="practice-review-title">Xem lại câu trả lời &amp; lời giải</h2>
            <nav class="practice-result-filters" aria-label="Lọc câu trả lời">
                <a class="button @(mistakesOnly ? "secondary" : "primary")" asp-action="Result" asp-route-id="@Model.PracticeId" asp-fragment="practice-review-title" aria-current="@(mistakesOnly ? null : "true")">Tất cả (@Model.Questions.Count)</a>
                <a class="button @(mistakesOnly ? "primary" : "secondary")" asp-action="Result" asp-route-id="@Model.PracticeId" asp-route-mistakesOnly="true" asp-fragment="practice-review-title" aria-current="@(mistakesOnly ? "true" : null)">Sai hoặc bỏ trống (@mistakes)</a>
            </nav>
        </div>
        @if (mistakesOnly && mistakes == 0)
        {
            <p class="muted">Bạn đã trả lời đúng tất cả câu hỏi.</p>
        }

        <div class="activity-review-list">
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];
                if (mistakesOnly && question.IsCorrect) continue;
                <article class="answer-review">
                    <div class="exam-question-header">
                        <span class="activity-tag exam-q-badge">Câu @(index + 1)</span>
                        <span class="activity-tag @(question.IsCorrect ? "good" : "attention")">
                            @(question.IsCorrect ? "Trả lời đúng" : question.SelectedAnswer is null ? "Bỏ trống" : "Chưa chính xác")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(question.Passage))
                    {
                        <div class="exam-stimulus-box">
                            <div class="stimulus-label">Bài đọc / Ngữ cảnh</div>
                            <div class="preserve">@question.Passage</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(question.AudioUrl))
                    {
                        <div class="exam-audio-box">
                            <audio controls preload="none" src="@question.AudioUrl" aria-label="Âm thanh câu hỏi">Trình duyệt chưa hỗ trợ âm thanh.</audio>
                            <partial name="_ExternalStimulusAudioNotice" model="@question.AudioUrl" />
                        </div>
                    }

                    <div class="reading-copy preserve">@question.Content</div>
                    <div class="answer-comparison">
                        <dl class="activity-answer">
                            <dt>Đáp án của bạn</dt>
                            <dd class="preserve">@(question.SelectedAnswer ?? "Bỏ trống")</dd>
                        </dl>
                        <dl class="activity-answer solution">
                            <dt>Đáp án chính xác</dt>
                            <dd class="preserve">@question.CorrectAnswer</dd>
                        </dl>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(question.Explanation))
                    {
                        <div class="answer-explanation">
                            <h3>Giải thích</h3>
                            <p class="preserve">@question.Explanation</p>
                        </div>
                    }
                </article>
            }
        </div>
    </section>
</div>
