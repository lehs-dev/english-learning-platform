@model EnglishLearningPlatform.Application.Practice.PracticeResult
@{
    ViewData["Title"] = "Kết quả luyện tập · " + Model.Title;
    ViewData["ActiveSection"] = "practice";
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
}

<div class="exam-workspace-layout">
    <header class="exam-header-bar">
        <div class="exam-header-left">
            <a class="button secondary exam-back-btn" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">
                <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                <span>Về khóa học</span>
            </a>
            <div class="exam-title-group">
                <span class="v2-pill-tag">Kết quả luyện tập</span>
                <span class="v2-pill-tag" data-result-version="@Model.Version">Phiên bản @Model.Version đã nộp</span>
                <h1 class="exam-title">@Model.Title</h1>
            </div>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            @if (ViewData["CanRetry"] is true)
            {
                <a class="button" style="padding: 10px 20px;" asp-action="Take" asp-route-id="@Model.PracticeId">
                    Luyện lại bài này &rarr;
                </a>
            }
            <a class="button secondary" style="padding:10px 20px;" asp-controller="Learning" asp-action="Continue" asp-route-id="@Model.CourseId">
                Tiếp tục học &rarr;
            </a>
        </div>
    </header>

    <!-- Score Overview Banner -->
    <div class="result-overview" style="background: #F0FDF4; border: 1.5px solid #BBF7D0;">
        <div>
            <span class="v2-pill-tag" style="background: #DEF7EC; color: #03543F; margin-bottom: 8px;">Tổng điểm bài luyện</span>
            <div class="assessment-score" style="margin: 6px 0; color: var(--v2-dark);">
                @Model.Score.ToString("0.##")<span style="font-size: 24px; font-weight: 600; color: var(--v2-text-muted);">/100</span>
            </div>
            <p style="margin: 0; font-size: 14.5px; color: var(--v2-dark); font-weight: 600;">
                Bạn trả lời đúng <strong>@Model.Questions.Count(q => q.IsCorrect)</strong> / @Model.Questions.Count câu hỏi.
            </p>
            <p class="exam-timer-note" style="margin-top: 6px;">
                Nộp lúc <time datetime="@Model.SubmittedAtUtc.ToString("O")">@Model.SubmittedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy") (UTC+7)</time>
            </p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px;">
            @if (ViewData["CanRetry"] is true)
            {
                <a class="button secondary" style="justify-content: center; padding: 10px 18px;" asp-action="Take" asp-route-id="@Model.PracticeId">
                    Làm lại bài luyện tập
                </a>
            }
            <a class="button secondary" style="justify-content: center; padding: 10px 18px;" asp-controller="Learning" asp-action="Course" asp-route-id="@Model.CourseId">
                Quay lại nội dung khóa học
            </a>
        </div>
    </div>

    <!-- Questions Detailed Review -->
    <section class="card-v2" style="padding: 32px; margin-top: 24px;" aria-label="Chi tiết từng câu">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="v2-pill-tag">Giải thích chi tiết</span>
                <h2 style="margin: 0; font-size: 18px; font-weight: 700; color: var(--v2-dark);">Xem lại câu trả lời &amp; Lời giải</h2>
            </div>
        </div>

        @for (var index = 0; index < Model.Questions.Count; index++)
        {
            var question = Model.Questions[index];
            <article class="answer-review" style="padding: 20px 0; border-bottom: 1px solid var(--v2-border-light);">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <span class="v2-pill-tag exam-q-badge">Câu @(index + 1)</span>
                    <span class="v2-pill-tag" style="@(question.IsCorrect ? "background: #DEF7EC; color: #03543F;" : "background: #FEE2E2; color: #991B1B;")">
                        @(question.IsCorrect ? "✓ Trả lời đúng" : "✗ Chưa chính xác / Bỏ trống")
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(question.Passage))
                {
                    <div class="exam-stimulus-box" style="margin-bottom:14px;">
                        <div class="stimulus-label">
                            <svg class="icon" aria-hidden="true" style="width:14px; height:14px;"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                            <span>Bài đọc / Ngữ cảnh:</span>
                        </div>
                        <div class="preserve">@question.Passage</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(question.AudioUrl))
                {
                    <div class="exam-audio-box" style="margin-bottom:14px;">
                        <audio controls preload="none" src="@question.AudioUrl" aria-label="Âm thanh câu hỏi">Trình duyệt chưa hỗ trợ âm thanh.</audio>
                        <partial name="_ExternalStimulusAudioNotice" model="question.AudioUrl" />
                    </div>
                }

                <div class="reading-copy preserve" style="font-weight: 600; color: var(--v2-dark); margin-bottom: 14px;">
                    @question.Content
                </div>

                <div class="answer-comparison" style="margin: 14px 0;">
                    <div style="background: #FAF9FE; border-radius: 12px; padding: 12px 16px; border: 1px solid #EAE8FB;">
                        <span style="font-size: 11.5px; font-weight: 600; color: var(--v2-text-muted); text-transform: uppercase;">Đáp án của bạn:</span>
                        <div style="font-size: 14.5px; font-weight: 700; color: @(question.IsCorrect ? "#059669" : "#DC2626"); margin-top: 4px;">
                            @(question.SelectedAnswer ?? "Bỏ trống (chưa chọn)")
                        </div>
                    </div>
                    <div style="background: #F0FDF4; border-radius: 12px; padding: 12px 16px; border: 1px solid #BBF7D0;">
                        <span style="font-size: 11.5px; font-weight: 600; color: #047857; text-transform: uppercase;">Đáp án chính xác:</span>
                        <div style="font-size: 14.5px; font-weight: 700; color: #065F46; margin-top: 4px;">
                            @question.CorrectAnswer
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(question.Explanation))
                {
                    <div class="answer-explanation" style="margin-top: 12px;">
                        <h3>💡 Hướng dẫn &amp; Giải thích chi tiết</h3>
                        <p class="preserve" style="margin: 0; font-size: 13.5px; line-height: 1.6;">@question.Explanation</p>
                    </div>
                }
            </article>
        }
    </section>
</div>
