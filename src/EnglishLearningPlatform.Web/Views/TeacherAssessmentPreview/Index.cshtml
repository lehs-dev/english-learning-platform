@model EnglishLearningPlatform.Application.Assessment.TeacherAssessmentPreview
@{
    Layout = "_LayoutTeacher";
    ViewData["Title"] = "Xem trước bài kiểm tra";
    ViewData["ActiveSection"] = "assessments";
    ViewData["PageClass"] = "teacher-assessment-page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teacher-assessments.css" asp-append-version="true" />
}
<nav class="ta-breadcrumb" aria-label="Đường dẫn điều hướng"><a asp-controller="TeacherAssessments" asp-action="Index">Bài kiểm tra</a><span aria-hidden="true">/</span><span aria-current="page">Xem trước</span></nav>
<div class="ta-heading"><div><h1>@Model.Title</h1><p>Kiểm tra đề dưới góc nhìn học viên trước khi xuất bản.</p></div><a class="button secondary" asp-controller="TeacherAssessments" asp-action="Index">Về danh sách</a></div>
<ol class="ta-steps" aria-label="Các bước soạn đề"><li class="is-complete"><span>✓</span>Cấu hình đề</li><li class="@(Model.Questions.Count >= 5 ? "is-complete" : "")"><span>@(Model.Questions.Count >= 5 ? "✓" : "2")</span>Câu hỏi và điểm</li><li class="is-current" aria-current="step"><span>3</span>Xem trước và xuất bản</li></ol>
<p class="ta-inline-note" role="status">Bạn đang xem đề đã lưu. Có thể thử chọn đáp án; bản xem trước không lưu lựa chọn hoặc tạo lượt làm bài.</p>
<section class="ta-preview-header" data-assessment-type="@Model.AssessmentType">
    <div class="ta-card-heading"><h2>Thông tin bài kiểm tra</h2><span class="ta-status status-@Model.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="Model.Status" /></span></div>
    <dl class="assessment-details">
        <div><dt>Loại bài</dt><dd><partial name="_UiText" model="Model.AssessmentType" /></dd></div>
        <div><dt>Phạm vi</dt><dd>@(Model.CourseId.HasValue ? Model.CourseTitle : "Bài độc lập")</dd></div>
        <div><dt>Thời lượng</dt><dd>@Model.DurationMinutes phút</dd></div>
        <div><dt>Lượt làm tối đa</dt><dd>@Model.MaxAttempts lượt</dd></div>
        <div><dt>Điểm đạt</dt><dd>@(Model.PassingScore.HasValue ? Model.PassingScore.Value.ToString("0.##") + "%" : "Không áp dụng")</dd></div>
        <div><dt>Câu hỏi và điểm</dt><dd>@Model.Questions.Count câu · @Model.Questions.Sum(question => question.Points).ToString("0.##") điểm</dd></div>
        @if (Model.TargetSkill.HasValue) { <div><dt>Kỹ năng mục tiêu</dt><dd><partial name="_UiText" model="Model.TargetSkill" /></dd></div> }
    </dl>
    @if (!string.IsNullOrWhiteSpace(Model.Description)) { <p class="preserve ta-help">@Model.Description</p> }
</section>
@if (Model.Warnings.Count > 0)
{
    <section class="ta-card ta-preview-section" aria-labelledby="preview-warning-title">
        <h2 id="preview-warning-title">Các phần cần kiểm tra</h2>

        <ul>
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>

        <p class="muted">
            Bạn có thể xem nội dung hiện có và quay lại hoàn thiện đề trước khi xuất bản.
        </p>
    </section>
}

@if (Model.Questions.Count == 0)
{
    <section class="ta-card ta-preview-section">
        <p>Đề chưa có câu hỏi.</p>
    </section>
}
else
{
    <nav class="ta-card ta-preview-section" aria-label="Điều hướng câu hỏi xem trước">
        <div class="actions ta-question-navigation">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <a class="button secondary"
                   href="#preview-question-@(i + 1)">
                    Câu @(i + 1)
                </a>
            }
        </div>
    </nav>

    <div class="exam-questions-column">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];

            <fieldset class="exam-question-card"
                      id="preview-question-@(i + 1)">

                <legend>
                    Câu @(i + 1) — @question.Points.ToString("0.##") điểm
                </legend>

                @if (!string.IsNullOrWhiteSpace(
                    question.StimulusContent))
                {
                    <div class="exam-stimulus-box">
                        <strong>Bài đọc / Ngữ cảnh</strong>
                        <div class="preserve">@question.StimulusContent</div>
                    </div>
                }

                <div class="exam-question-content preserve">@question.Content</div>

                @if (question.AudioUrl != null)
                {
                    <div class="exam-audio-box">
                        <audio controls
                               preload="none"
                               src="@question.AudioUrl"
                               aria-label="Âm thanh câu @(i + 1)">
                            Trình duyệt chưa hỗ trợ âm thanh.
                        </audio>
                        <partial name="_ExternalStimulusAudioNotice" model="question.AudioUrl" />
                    </div>
                }

                @* Không nằm trong form và không có script gửi đáp án. *@
                <div class="exam-options-list">
                    @for (
                        int optionIndex = 0;
                        optionIndex < question.Options.Count;
                        optionIndex++)
                    {
                        var option = question.Options[optionIndex];

                        <label class="exam-option-card"
                               for="preview-option-@(i)-@(optionIndex)">

                            <input type="radio"
                                   class="exam-option-radio"
                                   id="preview-option-@(i)-@(optionIndex)"
                                   name="PreviewAnswers[@i]"
                                   value="@option.Id" />

                            <span class="exam-option-badge">
                                @((char)('A' + optionIndex))
                            </span>

                            <span class="exam-option-text preserve">@option.Content</span>
                        </label>
                    }
                </div>
            </fieldset>
        }
    </div>
}
