@model EnglishLearningPlatform.Application.Assessment.TeacherAssessmentPreview

@{
    Layout = "_LayoutTeacher";
    ViewData["Title"] = "Preview Assessment";
    ViewData["ActiveSection"] = "assessments";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/assessment.css"
          asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <h1>Preview Assessment</h1>
        <p>@Model.Title</p>
    </div>

    <a class="button secondary"
       asp-controller="TeacherAssessments"
       asp-action="Index">
        Về danh sách
    </a>
</div>

<p class="notice" role="status">
    Đây là bản xem trước của đề đã lưu.
    Bạn có thể bấm thử lựa chọn nhưng đáp án không được lưu.
    Preview không tạo lượt làm bài, không chấm điểm
    và không Publish Assessment.
</p>

<section class="panel">
    <h2>Cấu hình đã lưu</h2>

    @* Mỗi nhóm div là một ô thông tin.
       assessment-details đã có CSS dạng lưới và ô bo góc. *@
    <dl class="assessment-details">
        <div>
            <dt>Loại bài</dt>
            <dd>@Model.AssessmentType</dd>
        </div>

        <div>
            <dt>Trạng thái</dt>
            <dd>@Model.Status</dd>
        </div>

        <div>
            <dt>Phạm vi</dt>
            <dd>
                @if (Model.CourseId.HasValue)
                {
                    <span>@Model.CourseTitle</span>
                }
                else
                {
                    <span>Bài độc lập</span>
                }
            </dd>
        </div>

        <div>
            <dt>Kỹ năng mục tiêu</dt>
            <dd>@(Model.TargetSkill?.ToString() ?? "Không áp dụng")</dd>
        </div>

        <div>
            <dt>Thời lượng</dt>
            <dd>@Model.DurationMinutes phút</dd>
        </div>

        <div>
            <dt>Lượt làm tối đa</dt>
            <dd>@Model.MaxAttempts lượt</dd>
        </div>

        <div>
            <dt>Điểm đạt</dt>
            <dd>
                @(Model.PassingScore.HasValue
                    ? Model.PassingScore.Value.ToString("0.##") + "%"
                    : "Không áp dụng")
            </dd>
        </div>

        <div>
            <dt>Số câu hỏi</dt>
            <dd>@Model.Questions.Count câu</dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <h3>Mô tả / hướng dẫn</h3>
        <p class="preserve">@Model.Description</p>
    }
</section>

@if (Model.Warnings.Count > 0)
{
    <section class="panel" aria-labelledby="preview-warning-title">
        <h2 id="preview-warning-title">Các phần cần kiểm tra</h2>

        <ul>
            @foreach (var warning in Model.Warnings)
            {
                <li>@warning</li>
            }
        </ul>

        <p class="muted">
            Bạn vẫn được xem trước nội dung hiện có.
            Preview không tự sửa hoặc Publish đề.
        </p>
    </section>
}

@if (Model.Questions.Count == 0)
{
    <section class="panel">
        <p>Đề chưa có câu hỏi.</p>
    </section>
}
else
{
    <nav class="panel" aria-label="Điều hướng câu hỏi Preview">
        <div class="actions">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <a class="button secondary"
                   href="#preview-question-@(i + 1)">
                    Câu @(i + 1)
                </a>
            }
        </div>
    </nav>

    <div class="exam-questions-column">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];

            <fieldset class="exam-question-card"
                      id="preview-question-@(i + 1)">

                <legend>
                    Câu @(i + 1) — @question.Points.ToString("0.##") điểm
                </legend>

                @if (!string.IsNullOrWhiteSpace(
                    question.StimulusContent))
                {
                    <div class="exam-stimulus-box">
                        <strong>Bài đọc / Ngữ cảnh</strong>
                        <div class="preserve">@question.StimulusContent</div>
                    </div>
                }

                <div class="exam-question-content preserve">@question.Content</div>

                @if (question.AudioUrl != null)
                {
                    <div class="exam-audio-box">
                        <audio controls
                               preload="none"
                               src="@question.AudioUrl"
                               aria-label="Âm thanh câu @(i + 1)">
                            Trình duyệt chưa hỗ trợ âm thanh.
                        </audio>
                    </div>
                }

                @* Không nằm trong form và không có script gửi đáp án. *@
                <div class="exam-options-list">
                    @for (
                        int optionIndex = 0;
                        optionIndex < question.Options.Count;
                        optionIndex++)
                    {
                        var option = question.Options[optionIndex];

                        <label class="exam-option-card"
                               for="preview-option-@(i)-@(optionIndex)">

                            <input type="radio"
                                   class="exam-option-radio"
                                   id="preview-option-@(i)-@(optionIndex)"
                                   name="PreviewAnswers[@i]"
                                   value="@option.Id" />

                            <span class="exam-option-badge">
                                @((char)('A' + optionIndex))
                            </span>

                            <span class="exam-option-text preserve">@option.Content</span>
                        </label>
                    }
                </div>
            </fieldset>
        }
    </div>
}
