@using EnglishLearningPlatform.Application.Assessment
@using EnglishLearningPlatform.Infrastructure.Identity
@model LessonPage
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveSection"] = "courses";
    var activities = ViewData["Activities"] as CourseActivities;
    bool showPractice = activities is { Practices.Count: > 0 };
    bool showCourseFinal = Model.Next is null && Model.CanRecordProgress;
}
@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lesson-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student-learning.css" asp-append-version="true" />
}
@section Breadcrumbs {
    <ol class="breadcrumbs-list">
        <li><a asp-action="Course" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
        <li><span>@Model.ModuleTitle</span></li>
        <li aria-current="page">@Model.Title</li>
    </ol>
}

<div class="lesson-study-layout learning-screens lesson-study-redesign">
    <header class="lesson-hero">
        <div class="lesson-hero-content">
            <span class="lesson-chapter">
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#folder")"></use></svg>
                @Model.ModuleTitle
            </span>
            <h1 class="learning-title">@Model.Title</h1>
            @if (Model.IsCompleted)
            {
                <span class="lesson-state">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                    Đã hoàn thành
                </span>
            }
        </div>
        @if (User.IsInRole(AppRoles.Teacher))
        {
            <a class="button secondary lesson-hero-action" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@Model.CourseId" asp-route-moduleId="@Model.ModuleId" asp-route-lessonId="@Model.Id">Về trình soạn bài</a>
        }
        else
        {
            <a class="button secondary lesson-hero-action" asp-controller="CourseDiscussion" asp-action="Index" asp-route-id="@Model.CourseId">
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#send")"></use></svg>
                Hỏi giảng viên
            </a>
        }
    </header>

    <div class="lesson-top-backbar">
        <a class="button secondary lesson-back-btn" asp-action="Course" asp-route-id="@Model.CourseId" asp-fragment="course-lessons-title">
            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            <span>Quay lại nội dung khóa học</span>
        </a>
    </div>

    <partial name="_CourseNotice" />
    @if (Model.CourseStatus == CourseStatus.Archived)
    {
        <div class="notice course-study-notice">Khóa học đã lưu trữ. Tiến độ hiện ở chế độ chỉ xem.</div>
    }

    <div class="lesson-study-grid">
        <article class="lesson-study-content">
            <div class="learning-surface lesson-reader">
                @if (Model.Resources.Count == 0)
                {
                    <div class="lesson-empty">
                        <span class="learning-emblem"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg></span>
                        <p>Nội dung bài học đang được chuẩn bị.</p>
                    </div>
                }
                else
                {
                    for (var index = 0; index < Model.Resources.Count; index++)
                    {
                        <div class="lesson-resource" id="lesson-resource-@index">
                            <partial name="_ResourceContent" model="Model.Resources[index]" />
                        </div>
                    }
                }
            </div>
        </article>

        @if (Model.Progress is not null || Model.CanRecordProgress || Model.Resources.Count > 1 || Model.CourseModules.Count > 0)
        {
            <aside class="lesson-study-aside" aria-label="Tiến độ và học liệu">
                @if (Model.Progress is not null || Model.CanRecordProgress)
                {
                    <section class="learning-surface lesson-study-progress" aria-labelledby="lesson-completion-title">
                        <h2 id="lesson-completion-title">Tiến độ học tập</h2>
                        @if (Model.Progress is not null)
                        {
                            <partial name="_LearningProgress" model="Model.Progress" />
                        }
                        @if (Model.CanRecordProgress)
                        {
                            <form method="post" asp-action="Completion" asp-route-id="@Model.Id">
                                <input type="hidden" name="completed" value="@((!Model.IsCompleted).ToString().ToLowerInvariant())" />
                                <button class="button @(Model.IsCompleted ? "secondary" : "")" type="submit" name="goNext"
                                        value="@(!Model.IsCompleted && Model.Next is not null ? "true" : "false")">
                                    @if (Model.IsCompleted)
                                    {
                                        <span>Đánh dấu chưa hoàn thành</span>
                                    }
                                    else
                                    {
                                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                                        <span>@(Model.Next is not null ? "Hoàn thành và học tiếp" : "Hoàn thành bài học")</span>
                                    }
                                </button>
                            </form>
                        }
                    </section>
                }
                @if (Model.Resources.Count > 1)
                {
                    <nav class="learning-surface lesson-resource-nav" aria-label="Mục lục bài học">
                        <h2>Mục lục</h2>
                        <ol>
                            @for (var index = 0; index < Model.Resources.Count; index++)
                            {
                                var resource = Model.Resources[index];
                                <li><a href="#lesson-resource-@index">@(string.IsNullOrWhiteSpace(resource.Title) ? $"Học liệu {index + 1}" : resource.Title)</a></li>
                            }
                        </ol>
                    </nav>
                }
                @if (Model.CourseModules.Any(m => m.Lessons.Count > 0))
                {
                    <nav class="learning-surface lesson-outline-nav" aria-label="Đề cương khóa học">
                        <div class="lesson-outline-header">
                            <h2>Nội dung khóa học</h2>
                            <a asp-action="Course" asp-route-id="@Model.CourseId">Tất cả</a>
                        </div>
                        <div class="lesson-outline-modules">
                            @for (var mIdx = 0; mIdx < Model.CourseModules.Count; mIdx++)
                            {
                                var mod = Model.CourseModules[mIdx];
                                if (mod.Lessons.Count == 0) continue;
                                <details class="lesson-outline-module" open="@(mod.Id == Model.ModuleId)">
                                    <summary>
                                        <span>@((mIdx + 1).ToString("00")). @mod.Title</span>
                                        <small>@mod.Lessons.Count</small>
                                    </summary>
                                    <ul>
                                        @foreach (var item in mod.Lessons)
                                        {
                                            bool isCurrent = item.Id == Model.Id;
                                            <li>
                                                <a class="lesson-outline-link @(isCurrent ? "is-current" : "") @(item.IsCompleted ? "is-done" : "")"
                                                   asp-action="Lesson" asp-route-id="@item.Id"
                                                   aria-current="@(isCurrent ? "page" : null)">
                                                    <span class="lesson-outline-dot" aria-hidden="true">
                                                        @if (item.IsCompleted)
                                                        {
                                                            <svg class="icon"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                                                        }
                                                    </span>
                                                    <span>@item.Title</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </nav>
                }
            </aside>
        }
        @if (showPractice || showCourseFinal)
        {
            <div class="lesson-study-extras">
                @if (showPractice)
                {
                    <div class="lesson-activities">
                        <partial name="_CourseActivities" model="activities" />
                    </div>
                }

                @if (showCourseFinal)
                {
                    <section class="learning-surface lesson-final-panel" aria-labelledby="lesson-final-title">
                        <div class="lesson-final-heading">
                            <span class="learning-emblem is-teal"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg></span>
                            <h2 id="lesson-final-title">Hoàn tất khóa học</h2>
                        </div>
                        @if (Model.FinalAssessmentId is Guid)
                        {
                            if (ViewData["FinalAssessment"] is AssessmentOverviewModel final)
                            {
                                <p>Hoàn thành các bài học và bài thi cuối khóa để ghi nhận kết quả.</p>
                                <a class="button" asp-controller="Assessment" asp-action="Take" asp-route-id="@final.AssessmentId" asp-route-attemptId="@final.ActiveAttemptId">
                                    @(final.ActiveAttemptId.HasValue ? "Tiếp tục bài thi cuối khóa" : "Làm bài thi cuối khóa") <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                                </a>
                            }
                            else
                            {
                                <p>Bài thi cuối khóa hiện chưa khả dụng.</p>
                                <a class="button secondary" asp-action="Course" asp-route-id="@Model.CourseId">Xem tổng quan khóa học</a>
                            }
                        }
                        else
                        {
                            <p>Bạn đã đến bài học cuối của khóa.</p>
                            <a class="button secondary" asp-action="Course" asp-route-id="@Model.CourseId">Xem tổng quan khóa học</a>
                        }
                    </section>
                }
            </div>
        }
    </div>

    @if (Model.Previous is not null || Model.Next is not null)
    {
        <nav class="lesson-study-navigation" aria-label="Điều hướng bài học">
            @if (Model.Previous is { } previous)
            {
                <a class="learning-surface lesson-step is-previous" asp-action="Lesson" asp-route-id="@previous.Id">
                    <span class="learning-emblem"><svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></span>
                    <span><small>Bài trước</small><strong>@previous.Title</strong></span>
                </a>
            }
            @if (Model.Next is { } next)
            {
                <a class="learning-surface lesson-step is-next" asp-action="Lesson" asp-route-id="@next.Id">
                    <span><small>Bài kế tiếp</small><strong>@next.Title</strong></span>
                    <span class="learning-emblem"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></span>
                </a>
            }
        </nav>
    }
</div>
