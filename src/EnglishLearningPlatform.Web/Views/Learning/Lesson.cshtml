@using EnglishLearningPlatform.Application.Assessment
@using EnglishLearningPlatform.Domain.Enums
@model LessonPage
@{
    ViewData["Title"] = Model.Title;
    ViewData["ActiveSection"] = "courses";
}
@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
}

<div class="lesson-study-layout">
    <div style="margin-bottom: 20px;">
        <a class="button secondary exam-back-btn" asp-action="Course" asp-route-id="@Model.CourseId">
            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            <span>@Model.CourseTitle</span>
        </a>
    </div>

    <div class="lesson-workspace">
        <!-- Main Lesson Content Article -->
        <article class="lesson-reading">
            <header class="lesson-heading">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                    <span class="v2-pill-tag">Bài học</span>
                    <a asp-action="Module" asp-route-id="@Model.ModuleId" class="v2-pill-tag" style="background: #FAF9FE; color: var(--v2-text-muted); text-decoration: none;">
                        Chương: @Model.ModuleTitle
                    </a>
                </div>
                <h1>@Model.Title</h1>
            </header>

            <partial name="_CourseNotice" />

            @if (Model.CourseStatus == CourseStatus.Archived)
            {
                <div class="notice">Khóa học đã lưu trữ. Bạn không thể thay đổi tiến độ.</div>
            }

            @if (Model.Resources.Count == 0)
            {
                <div class="empty">Nội dung bài học đang được chuẩn bị.</div>
            }

            @foreach (var resource in Model.Resources)
            {
                <partial name="_ResourceContent" model="resource" />
            }

            @if (ViewData["Activities"] is CourseActivities activities)
            {
                <partial name="_CourseActivities" model="activities" />
            }

            @if (Model.Progress is not null || Model.CanRecordProgress)
            {
            <section class="lesson-completion" aria-labelledby="lesson-completion-title">
                <div class="lesson-completion-info">
                    <h2 id="lesson-completion-title">Tiến độ bài học</h2>
                    <p>@(Model.IsCompleted ? "Bạn đã hoàn thành bài học này." : Model.CanRecordProgress ? "Đánh dấu hoàn thành khi bạn học xong bài này." : "Bài học này chưa hoàn thành.")</p>
                    @if (Model.Progress is not null)
                    {
                        <partial name="_LearningProgress" model="Model.Progress" />
                    }
                </div>
                @if (Model.CanRecordProgress)
                {
                    <form method="post" asp-action="Completion" asp-route-id="@Model.Id">
                        <input type="hidden" name="completed" value="@((!Model.IsCompleted).ToString().ToLowerInvariant())" />
                        <button class="button @(Model.IsCompleted ? "secondary" : "")" type="submit">
                            @if (Model.IsCompleted)
                            {
                                <span>Đánh dấu chưa hoàn thành</span>
                            }
                            else
                            {
                                <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                                <span>Hoàn thành bài học</span>
                            }
                        </button>
                    </form>
                }
            </section>
            }

            <!-- Bottom Lesson Navigation -->
            <nav class="lesson-navigation" aria-label="Điều hướng bài học">
                <div>
                    @if (Model.Previous is not null)
                    {
                        <a class="button secondary" asp-action="Lesson" asp-route-id="@Model.Previous.Id">
                            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                            <span>Bài trước: @Model.Previous.Title</span>
                        </a>
                    }
                </div>
                <div>
                    @if (Model.Next is not null)
                    {
                        <a class="button" asp-action="Lesson" asp-route-id="@Model.Next.Id">
                            <span>Bài kế tiếp: @Model.Next.Title</span>
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                </div>
            </nav>

            @if (Model.Next is null && Model.CanRecordProgress)
            {
                <section class="card-v2" aria-labelledby="lesson-final-title" style="padding: 26px 28px; margin-top: 24px; background: #FFFDF5; border-color: #FEF3C7;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                        <span class="v2-pill-tag" style="background:#FEF3C7; color:#92400E;">Bài cuối</span>
                        <h2 id="lesson-final-title" style="margin:0; font-size:19px; font-weight:800; color:var(--v2-dark);">Hoàn tất khóa học</h2>
                    </div>
                    @if (Model.FinalAssessmentId is Guid)
                    {
                        if (ViewData["FinalAssessment"] is AssessmentOverviewModel final)
                        {
                            <p style="margin:0 0 14px; color:var(--v2-text-secondary); line-height:1.6;">
                                Bạn đã đến bài học cuối. Làm bài thi cuối khóa để hoàn thành khóa học và ghi nhận kết quả.
                            </p>
                            <a class="button" asp-controller="Assessment" asp-action="Take" asp-route-id="@final.AssessmentId">
                                @(final.ActiveAttemptId.HasValue ? "Tiếp tục bài thi cuối khóa" : "Làm bài thi cuối khóa") &rarr;
                            </a>
                        }
                        else
                        {
                            <div class="notice" style="margin-bottom:14px;">Bài thi cuối khóa hiện chưa khả dụng. Bạn vẫn có thể xem lại tiến độ trong trang khóa học.</div>
                            <a class="button secondary" asp-action="Course" asp-route-id="@Model.CourseId">Xem tổng quan khóa học</a>
                        }
                    }
                    else
                    {
                        <p style="margin:0 0 14px; color:var(--v2-text-secondary); line-height:1.6;">
                            Bạn đã đến bài học cuối của khóa. Xem lại tiến độ và các hoạt động trong trang khóa học.
                        </p>
                        <a class="button secondary" asp-action="Course" asp-route-id="@Model.CourseId">Xem tổng quan khóa học</a>
                    }
                </section>
            }
        </article>

    </div>
</div>
