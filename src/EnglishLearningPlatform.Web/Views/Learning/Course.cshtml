@using EnglishLearningPlatform.Application.Assessment
@using EnglishLearningPlatform.Application.Flashcards
@model CoursePage
@{
    ViewData["Title"] = Model.Course.Title;
    ViewData["ActiveSection"] = "courses";
    var activeTab = ViewData["ActiveTab"] as string ?? "lessons";
    var activities = ViewData["Activities"] as CourseActivities;
    var decks = ViewData["CourseFlashcardDecks"] as IReadOnlyList<FlashcardDeckSummary> ?? [];
    var finalAssessment = ViewData["FinalAssessment"] as AssessmentOverviewModel;
    var practices = activities?.Practices ?? [];
    var assessments = activities?.Assessments.Where(item => item.Id != Model.FinalAssessmentId).ToArray() ?? [];
    var totalLessons = Model.Modules.Sum(module => module.Lessons.Count);
    var assessmentCount = assessments.Length + (Model.FinalAssessmentId.HasValue ? 1 : 0);
    var finalPending = Model.Progress is { CompletedAtUtc: null, TotalLessons: > 0 } pending
        && pending.CompletedLessons >= pending.TotalLessons && Model.FinalAssessmentId.HasValue;
    var upcoming = Model.Modules.SelectMany(module => module.Lessons).FirstOrDefault(lesson => lesson.Id == Model.Progress?.ContinueLessonId && !lesson.IsCompleted);
    ViewData["ExpandedOutline"] = !Model.IsOwner;
}

@section Styles {
    <link rel="stylesheet" href="~/css/courses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student-learning.css" asp-append-version="true" />
}

@section Breadcrumbs {
    <ol class="breadcrumbs-list">
        <li><a asp-controller="@(Model.IsOwner ? "TeacherCourses" : "Learning")" asp-action="Index">Khóa học của tôi</a></li>
        <li aria-current="page">@Model.Course.Title</li>
    </ol>
}

<div class="course-study-room learning-screens">
    <header class="course-study-hero card-v2">
        <div class="course-hero-content">
            <div class="learning-context">
                <span><partial name="_UiText" model="Model.Course.Level" /></span>
                <span>@Model.Modules.Count chương</span>
                <span>@totalLessons bài học</span>
                @if (Model.IsOwner || Model.Course.Status != CourseStatus.Published)
                {
                    <span><partial name="_UiText" model="Model.Course.Status" /></span>
                }
            </div>
            <h1 class="learning-title">@Model.Course.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Course.Teacher))
            {
                <p class="course-hero-teacher">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>
                    @Model.Course.Teacher
                </p>
            }
            @if (Model.IsOwner)
            {
                <a class="button course-hero-action" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@Model.Course.Id">Quản lý nội dung <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
            }
            else if (upcoming is not null)
            {
                <a class="button course-hero-action" asp-action="Continue" asp-route-id="@Model.Course.Id">
                    @(Model.Course.Status == CourseStatus.Archived ? "Xem bài học" : Model.Progress?.CompletedLessons == 0 ? "Bắt đầu học" : "Tiếp tục học")
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                </a>
            }
            else if (finalPending)
            {
                <p class="course-hero-teacher">Hãy làm bài thi cuối khóa để hoàn tất khóa học.</p>
                <a class="button course-hero-action" asp-action="Course" asp-route-id="@Model.Course.Id" asp-route-tab="assessment">Xem bài thi cuối khóa <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
            }
        </div>
        @if (Model.Progress is { } progress)
        {
            <div class="course-hero-progress" aria-label="Tiến độ khóa học">
                @if (progress.CompletedAtUtc.HasValue)
                {
                    <div class="course-hero-progress-label"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg> Đã hoàn thành khóa học</div>
                }
                else
                {
                    <div class="course-hero-progress-label"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#chart-bars")"></use></svg> Tiến độ của bạn</div>
                }
                @if (progress.Percentage is decimal percentage)
                {
                    <div class="course-hero-score">@percentage.ToString("0.#")<span>%</span></div>
                }
                <partial name="_LearningProgress" model="progress" />
            </div>
        }
    </header>

    @if (Model.Course.Status == CourseStatus.Archived)
    {
        <div class="notice course-study-notice"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#archive")"></use></svg> Khóa học đã lưu trữ. Nội dung và tiến độ chỉ được xem.</div>
    }
    @if (Model.Course.Status == CourseStatus.Unpublished)
    {
        <div class="notice course-study-notice"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#info")"></use></svg> Khóa học đã ngừng nhận học viên mới. Bạn vẫn có thể tiếp tục học.</div>
    }

    @if (Model.IsOwner)
    {
        <section class="course-room-section" aria-labelledby="owner-outline-title">
            <h2 id="owner-outline-title">Nội dung các bài học</h2>
            <partial name="_CourseOutline" model="Model" />
            @if (activities is not null)
            {
                <partial name="_CourseActivities" model="activities" />
            }
        </section>
    }
    else
    {
        <div class="course-room-grid">
            <aside class="learning-surface course-room-aside" aria-labelledby="course-space-title">
                <h2 id="course-space-title">Trong khóa học</h2>
                <div class="course-space-links">
                    <a asp-controller="Homework" asp-action="Course" asp-route-id="@Model.Course.Id">
                        <span class="learning-emblem"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#pencil")"></use></svg></span>
                        <span>Bài tập viết</span><svg class="icon space-link-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    </a>
                    <a asp-controller="CourseDiscussion" asp-action="Index" asp-route-id="@Model.Course.Id">
                        <span class="learning-emblem is-teal"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#send")"></use></svg></span>
                        <span>Hỏi giảng viên</span><svg class="icon space-link-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    </a>
                </div>
                @if (activeTab != "assessment" && finalAssessment is not null)
                {
                    <div class="course-final-summary">
                        <h3><a asp-action="Course" asp-route-id="@Model.Course.Id" asp-route-tab="assessment">Bài thi cuối khóa</a></h3>
                        <dl class="assessment-details">
                            <div><dt>Thời lượng</dt><dd>@finalAssessment.DurationMinutes phút</dd></div>
                            <div><dt>Điểm cao nhất</dt><dd>@(finalAssessment.HighestScore is decimal score ? score.ToString("0.##") + "/100" : "Chưa có")</dd></div>
                        </dl>
                    </div>
                }
            </aside>
            <div class="course-room-main">
                <nav class="course-sub-nav learning-tabbar" aria-label="Điều hướng khóa học">
                    <a class="sub-nav-item @(activeTab == "lessons" ? "is-active" : "")"
                       asp-action="Course" asp-route-id="@Model.Course.Id" asp-route-tab="lessons"
                       aria-current="@(activeTab == "lessons" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                        <span>Bài học</span><span class="learning-tab-count">@totalLessons</span>
                    </a>
                    <a class="sub-nav-item @(activeTab == "practice" ? "is-active" : "")"
                       asp-action="Course" asp-route-id="@Model.Course.Id" asp-route-tab="practice"
                       aria-current="@(activeTab == "practice" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                        <span>Ôn tập</span><span class="learning-tab-count">@(practices.Count + decks.Count)</span>
                    </a>
                    <a class="sub-nav-item @(activeTab == "assessment" ? "is-active" : "")"
                       asp-action="Course" asp-route-id="@Model.Course.Id" asp-route-tab="assessment"
                       aria-current="@(activeTab == "assessment" ? "page" : null)">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>
                        <span>Đánh giá</span><span class="learning-tab-count">@assessmentCount</span>
                    </a>
                </nav>

                @if (activeTab == "lessons")
                {
                    <section id="tab-pane-lessons" class="course-tab-pane is-active course-room-section" aria-labelledby="course-lessons-title">
                        <div class="course-outline-header">
                            <h2 id="course-lessons-title">Nội dung khóa học</h2>
                            @if (Model.CanLearn && Model.Modules.Any(m => m.Lessons.Count > 0))
                            {
                                <div class="course-outline-tools" data-course-outline-tools>
                                    <div class="course-outline-filters" role="group" aria-label="Lọc bài học">
                                        <button type="button" class="course-outline-pill is-active" data-outline-filter="all" aria-pressed="true">Tất cả (@totalLessons)</button>
                                        <button type="button" class="course-outline-pill" data-outline-filter="remaining" aria-pressed="false">Chưa học</button>
                                        <button type="button" class="course-outline-pill" data-outline-filter="completed" aria-pressed="false">Đã xong</button>
                                    </div>
                                    @if (Model.Modules.Count > 1)
                                    {
                                        <button type="button" class="course-outline-toggle" data-outline-toggle-all>Mở tất cả chương</button>
                                    }
                                </div>
                            }
                        </div>
                        <partial name="_CourseOutline" model="Model" />
                        <p class="learning-surface course-room-empty" data-outline-empty-filter hidden>Không có bài học nào khớp với trạng thái đã chọn.</p>
                    </section>
                }
                else if (activeTab == "practice")
                {
                    <section id="tab-pane-practice" class="course-tab-pane is-active course-room-section" aria-labelledby="course-practice-title">
                        <h2 id="course-practice-title">Luyện tập và thẻ từ vựng</h2>
                        @if (practices.Count == 0 && decks.Count == 0)
                        {
                            <p class="learning-surface course-room-empty">Chưa có nội dung ôn tập cho khóa học này.</p>
                        }
                        @if (practices.Count > 0)
                        {
                            <div class="learning-surface course-room-group">
                                <h3>Bài luyện tập</h3>
                                <ul class="learning-activity-list">
                                    @foreach (var practice in practices)
                                    {
                                        <li>
                                            <a class="learning-activity" asp-controller="Practice" asp-action="Take" asp-route-id="@practice.Id">
                                                <span class="learning-emblem is-teal"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg></span>
                                                <span class="learning-activity-copy"><strong>@practice.Title</strong><small>@practice.QuestionCount câu hỏi</small></span>
                                                <span class="learning-activity-cta">Luyện ngay <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (decks.Count > 0)
                        {
                            <div class="learning-surface course-room-group">
                                <h3>Bộ thẻ từ vựng</h3>
                                <ul class="learning-activity-list">
                                    @foreach (var deck in decks)
                                    {
                                        <li>
                                            <a class="learning-activity" asp-controller="Flashcards" asp-action="Study" asp-route-id="@deck.Id">
                                                <span class="learning-emblem"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg></span>
                                                <span class="learning-activity-copy">
                                                    <strong>@deck.Title</strong>
                                                    <small>@deck.CardCount thẻ @if (deck.DueCount > 0) { <span>· @deck.DueCount cần ôn</span> }</small>
                                                </span>
                                                <span class="learning-activity-cta">Học từ <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </section>
                }
                else
                {
                    <section id="tab-pane-assessment" class="course-tab-pane is-active course-room-section" aria-labelledby="course-assessment-title">
                        <h2 id="course-assessment-title">Bài đánh giá</h2>
                        @if (Model.FinalAssessmentId.HasValue)
                        {
                            <section class="learning-surface course-room-group course-final-panel" aria-labelledby="final-assessment-title">
                                <h3 id="final-assessment-title">Bài thi kết thúc khóa học</h3>
                                @if (finalAssessment is not null)
                                {
                                    <p class="course-final-name">@finalAssessment.Title</p>
                                    <partial name="_AssessmentDetails" model="finalAssessment" />
                                    <p>Hoàn thành tất cả bài học và đạt bài thi cuối khóa để hoàn tất khóa học.</p>
                                    <a class="button" asp-controller="Assessment" asp-action="Take" asp-route-id="@finalAssessment.AssessmentId" asp-route-attemptId="@finalAssessment.ActiveAttemptId">
                                        @(finalAssessment.ActiveAttemptId.HasValue ? "Tiếp tục làm bài thi" : "Xem thông tin bài thi") <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                                    </a>
                                }
                                else
                                {
                                    <p class="notice">Bài thi hiện chưa khả dụng.</p>
                                }
                            </section>
                        }
                        @if (assessments.Length > 0)
                        {
                            <div class="learning-surface course-room-group">
                                <h3>Bài đánh giá định kỳ</h3>
                                <ul class="learning-activity-list">
                                    @foreach (var assessment in assessments)
                                    {
                                        <li>
                                            <a class="learning-activity" asp-controller="Assessment" asp-action="Take" asp-route-id="@assessment.Id" asp-route-attemptId="@assessment.ActiveAttemptId">
                                                <span class="learning-emblem"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg></span>
                                                <span class="learning-activity-copy">
                                                    <strong>@assessment.Title</strong>
                                                    <small>@assessment.QuestionCount câu <span aria-hidden="true">·</span> @assessment.DurationMinutes phút</small>
                                                </span>
                                                <span class="learning-activity-cta">@(assessment.ActiveAttemptId.HasValue ? "Tiếp tục" : "Làm bài") <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (assessmentCount == 0)
                        {
                            <p class="learning-surface course-room-empty">Khóa học này hiện chưa có bài đánh giá.</p>
                        }
                    </section>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/activity-filters.js" asp-append-version="true" defer></script>
}
