@model StudentDashboard
@using System.Globalization
@using EnglishLearningPlatform.Application.Flashcards
@using EnglishLearningPlatform.Application.Gamification
@using EnglishLearningPlatform.Application.LearningPath
@inject TimeProvider Clock

@{
    ViewData["Title"] = "Hôm nay";
    ViewData["ActiveSection"] = "dashboard";
    ViewData["PageClass"] = "student-today-page";

    var inProgressCourses = Model.Courses.Where(course =>
        course.Status != CourseStatus.Archived &&
        course.Progress is { TotalLessons: > 0 } progress &&
        (progress.CompletedLessons > 0 || progress.CompletedAtUtc.HasValue) &&
        progress.CompletedLessons < progress.TotalLessons).ToArray();
    var continueCourse = inProgressCourses.FirstOrDefault(course => course.Progress!.ContinueLessonId.HasValue)
        ?? inProgressCourses.FirstOrDefault();
    var finalPendingCourse = Model.Courses.FirstOrDefault(course =>
        course.Status != CourseStatus.Archived && course.Progress is { TotalLessons: > 0, CompletedAtUtc: null } progress &&
        progress.CompletedLessons >= progress.TotalLessons);
    var notStartedCourse = Model.Courses.FirstOrDefault(course =>
        course.Status != CourseStatus.Archived &&
        (course.Progress is null || course.Progress is { CompletedLessons: 0, CompletedAtUtc: null }));
    var heroCourse = continueCourse ?? finalPendingCourse ?? notStartedCourse;
    var spotlight = new[] { continueCourse, finalPendingCourse }.OfType<CourseSummary>()
        .Concat(Model.Courses).DistinctBy(course => course.Id).Take(2).ToArray();

    var localToday = GamificationPolicy.LocalDate(Clock.GetUtcNow());
    var weekStart = Model.WeekStartDate == default
        ? localToday.AddDays(-(((int)localToday.DayOfWeek + 6) % 7))
        : Model.WeekStartDate;
    var weekDays = Enumerable.Range(0, 7).Select(weekStart.AddDays).ToArray();
    var selectedDay = weekDays.Contains(localToday) ? localToday : weekStart;
    var activitiesByDay = Model.WeeklyActivities.ToLookup(activity => GamificationPolicy.LocalDate(activity.OccurredAtUtc));
    var gamification = ViewData["Gamification"] as GamificationSummary;
    var suggestions = ViewData["SuggestedCourses"] as IReadOnlyList<CourseSummary> ?? [];
    var dueDecks = ViewData["DueDecks"] as IReadOnlyList<FlashcardDeckSummary> ?? [];
    var activePlan = (ViewData["LearningPathPage"] as LearningPathPage)?.Plan;
    var agenda = activePlan?.Items.Where(item => item.DayIndex == localToday.DayNumber - activePlan.StartDate.DayNumber + 1
        && item.Status != LearningPlanItemStatus.Skipped).Take(3).ToArray();
    string[] dayNames = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];
    var shortDate = localToday.ToString("dddd, d 'tháng' M", CultureInfo.GetCultureInfo("vi-VN"));
    var heroLabel = continueCourse is not null ? "Học tiếp"
        : finalPendingCourse is not null ? "Hoàn tất khóa học"
        : notStartedCourse is not null ? "Bài học đầu tiên"
        : "Khám phá khóa học";
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-today.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/student-today.js" asp-append-version="true" defer></script>
}

<div class="today-workspace-container">
    <header class="today-greeting-header">
        <div>
            <time class="today-date-badge" datetime="@localToday.ToString("yyyy-MM-dd")">
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clock")"></use></svg>
                @shortDate
            </time>
            <h1 class="today-title">Hôm nay</h1>
        </div>
        @if (gamification is { } summary)
        {
            <a class="today-header-streak" asp-action="Progress" asp-route-tab="achievements" aria-label="Chuỗi học @summary.CurrentStreak ngày">
                <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#sparkles")"></use></svg>
                @summary.CurrentStreak ngày
            </a>
        }
        <a class="today-header-link" asp-controller="Learning" asp-action="Progress">
            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#chart-bars")"></use></svg>
            Tiến độ học tập
        </a>
    </header>

    <div class="dashboard-columns-grid">
        <div class="today-main">
            <section class="hero-promo-banner" aria-labelledby="today-hero-title">
                <div class="hero-promo-content">
                    <span class="today-hero-label"><span aria-hidden="true"></span>@heroLabel</span>
                    <h2 class="hero-promo-title" id="today-hero-title">@(heroCourse?.Title ?? "Tìm khóa học tiếng Anh")</h2>
                    @if (finalPendingCourse is not null && continueCourse is null)
                    {
                        <p class="hero-promo-desc">Đã học xong @finalPendingCourse.Progress!.CompletedLessons bài. Hoàn tất khóa bằng bài thi cuối khóa.</p>
                    }
                    else if (heroCourse is not null)
                    {
                        <p class="hero-promo-desc">
                            @heroCourse.Teacher <span aria-hidden="true">·</span> <partial name="_UiText" model="heroCourse.Level" />
                        </p>
                    }
                    else
                    {
                        <p class="hero-promo-desc">Chọn khóa học phù hợp với trình độ và mục tiêu của bạn.</p>
                    }

                    @if (continueCourse is not null)
                    {
                        <a asp-action="Continue" asp-route-id="@continueCourse.Id" class="today-hero-button">
                            Tiếp tục học ngay <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else if (finalPendingCourse is not null)
                    {
                        <a asp-action="Course" asp-route-id="@finalPendingCourse.Id" asp-route-tab="assessment" class="today-hero-button">
                            Làm bài thi cuối khóa <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else if (notStartedCourse is not null)
                    {
                        <a asp-action="Continue" asp-route-id="@notStartedCourse.Id" class="today-hero-button">
                            Bắt đầu khóa học <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Courses" asp-action="Index" class="today-hero-button">
                            Khám phá khóa học <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                </div>
                <img class="hero-promo-art" src="~/images/study-desk-cover.webp" asp-append-version="true" alt="" width="1200" height="800" fetchpriority="high" />
            </section>

            <nav class="today-activity-links" aria-label="Hoạt động học tập">
                <a class="today-shortcut" asp-controller="Practice" asp-action="Index">
                    <span class="today-icon-tile">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                    </span>
                    <span>Luyện tập</span>
                    <svg class="icon today-link-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                </a>
                <a class="today-shortcut" asp-controller="Assessment" asp-action="Index">
                    <span class="today-icon-tile today-icon-tile--teal">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>
                    </span>
                    <span>Bài kiểm tra</span>
                    <svg class="icon today-link-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                </a>
                <a class="today-shortcut" asp-controller="Flashcards" asp-action="Index">
                    <span class="today-icon-tile today-icon-tile--warm">
                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#folder")"></use></svg>
                    </span>
                    <span>Ôn từ vựng</span>
                    <svg class="icon today-link-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                </a>
            </nav>

            <partial name="_TodayCoursework" model="Model.Coursework" />

            <section class="today-section" aria-labelledby="your-progress">
                <header class="today-section-heading">
                    <h2 id="your-progress">Khóa học của bạn</h2>
                    @if (Model.Courses.Count > 0)
                    {
                        <a asp-action="Index">Tất cả khóa học (@Model.Courses.Count) <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                    }
                </header>
                @if (spotlight.Length > 0)
                {
                    <div class="today-course-grid spotlight-cards-row">
                        @foreach (var course in spotlight)
                        {
                            var progress = course.Progress;
                            <article class="today-course-card" data-course-id="@course.Id">
                                <header>
                                    <span class="today-icon-tile">
                                        <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                                    </span>
                                    <span class="today-tag"><partial name="_UiText" model="course.Level" /></span>
                                </header>
                                <div class="today-course-copy">
                                    <h3><a asp-action="Course" asp-route-id="@course.Id">@course.Title</a></h3>
                                    <p>@course.Teacher</p>
                                </div>

                                @if (progress is { Percentage: decimal percentage })
                                {
                                    <div class="today-course-progress">
                                        <div><span>@progress.CompletedLessons/@progress.TotalLessons bài</span><strong>@percentage.ToString("0.##")%</strong></div>
                                        <progress aria-label="Tiến độ @course.Title" max="100" value="@percentage.ToString(CultureInfo.InvariantCulture)"></progress>
                                    </div>
                                }
                                else
                                {
                                    <div class="today-course-progress"><div><span>Chưa có bài học</span><strong>—</strong></div></div>
                                }

                                <footer>
                                    <a class="today-text-action" asp-controller="Homework" asp-action="Course" asp-route-id="@course.Id">Bài tập viết</a>
                                    @if (course == continueCourse || course.Status != CourseStatus.Archived &&
                                        progress is { CompletedLessons: > 0 } && progress.CompletedLessons < progress.TotalLessons)
                                    {
                                        <a class="today-text-action" asp-action="Continue" asp-route-id="@course.Id">Học tiếp <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                                    }
                                    else
                                    {
                                        <a class="today-text-action" asp-action="Course" asp-route-id="@course.Id">Vào khóa học <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                                    }
                                </footer>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="today-empty-card">
                        <p>Bạn chưa tham gia khóa học nào.</p>
                        <a class="today-text-action" asp-controller="Courses" asp-action="Index">Chọn khóa học đầu tiên <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                    </div>
                }
            </section>

            <div class="today-compact-widgets-row">
                <section class="today-compact-widget" aria-labelledby="today-plan-title">
                    <header class="today-widget-heading">
                        <span class="today-icon-tile">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                        </span>
                        <h2 id="today-plan-title">Lộ trình hôm nay</h2>
                    </header>
                    @if (agenda is { Length: > 0 })
                    {
                        <ul class="today-plain-list">
                            @foreach (var item in agenda)
                            {
                                <li class="today-list-item">
                                    <div>
                                        <strong>@item.Title</strong>
                                        <small><partial name="_UiText" model="item.Skill" /> · @item.EstimatedMinutes phút</small>
                                    </div>
                                    @if (item.Status == LearningPlanItemStatus.Completed)
                                    {
                                        <span class="today-tag today-tag--teal">Đã xong</span>
                                    }
                                    else if (item.Status == LearningPlanItemStatus.Unavailable)
                                    {
                                        <span class="today-tag">Chưa khả dụng</span>
                                    }
                                    else
                                    {
                                        switch (item.TargetType)
                                        {
                                            case LearningPlanTargetType.Course:
                                                <a asp-action="Course" asp-route-id="@item.TargetId">Vào học</a>
                                                break;
                                            case LearningPlanTargetType.Lesson:
                                                <a asp-action="Lesson" asp-route-id="@item.TargetId">Học</a>
                                                break;
                                            case LearningPlanTargetType.Practice:
                                                <a asp-controller="Practice" asp-action="Take" asp-route-id="@item.TargetId">Luyện</a>
                                                break;
                                            case LearningPlanTargetType.FlashcardDeck:
                                                <a asp-controller="Flashcards" asp-action="Study" asp-route-id="@item.TargetId">Ôn từ</a>
                                                break;
                                            case LearningPlanTargetType.Assessment:
                                                <a asp-controller="Assessment" asp-action="Take" asp-route-id="@item.TargetId">Làm bài</a>
                                                break;
                                        }
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="today-muted">@(activePlan is null ? "Bạn chưa thiết lập lộ trình học." : "Hôm nay không có mục cần làm trong lộ trình.")</p>
                    }
                    <a class="today-text-action" asp-controller="LearningPath" asp-action="Index">@(activePlan is null ? "Thiết lập lộ trình" : "Xem lộ trình") <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                </section>

                <section class="today-compact-widget" aria-labelledby="today-flashcards-title">
                    <header class="today-widget-heading">
                        <span class="today-icon-tile today-icon-tile--teal">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#folder")"></use></svg>
                        </span>
                        <h2 id="today-flashcards-title">Ôn từ đến hạn</h2>
                    </header>
                    @if (dueDecks.Count > 0)
                    {
                        <ul class="today-plain-list">
                            @foreach (var deck in dueDecks.Take(2))
                            {
                                <li class="today-list-item">
                                    <div><strong>@deck.Title</strong><small>@deck.DueCount thẻ đến hạn</small></div>
                                    <a asp-controller="Flashcards" asp-action="Study" asp-route-id="@deck.Id">Ôn ngay</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="today-muted">Hôm nay không có thẻ cần ôn.</p>
                    }
                    <a class="today-text-action" asp-controller="Flashcards" asp-action="Index">Xem các bộ thẻ <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                </section>
            </div>

            <section class="today-section" aria-labelledby="recommendations-title">
                <header class="today-section-heading"><h2 id="recommendations-title">Kỹ năng cần cải thiện</h2></header>
                @if (Model.Recommendations.Count == 0)
                {
                    <div class="today-empty-card">
                        <p>Làm bài đánh giá năng lực để biết kỹ năng cần ưu tiên.</p>
                        <a asp-controller="Assessment" asp-action="Index" class="today-text-action">Làm bài đánh giá <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                    </div>
                }
                else
                {
                    <div class="today-course-grid">
                        @foreach (var recommendation in Model.Recommendations.Take(2))
                        {
                            <article class="today-compact-widget today-recommendation">
                                <header>
                                    <h3><partial name="_UiText" model="recommendation.Skill" /></h3>
                                    <strong>@recommendation.Score.ToString("0.##")%</strong>
                                </header>
                                <p class="today-muted">Căn cứ từ bài: <a asp-controller="Assessment" asp-action="Result" asp-route-id="@recommendation.AttemptId">@recommendation.AssessmentTitle</a></p>
                                @if (recommendation.Contents.Count == 0)
                                {
                                    <p class="today-muted">Chưa có nội dung phù hợp trong các khóa đã tham gia.</p>
                                }
                                @foreach (var content in recommendation.Contents.Take(2))
                                {
                                    switch (content.Kind)
                                    {
                                        case RecommendedContentKind.Course:
                                            <a asp-action="Course" asp-route-id="@content.Id" class="today-text-action">@content.Title <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                                            break;
                                        case RecommendedContentKind.Practice:
                                            <a asp-controller="Practice" asp-action="Take" asp-route-id="@content.Id" class="today-text-action">@content.Title <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                                            break;
                                        case RecommendedContentKind.Assessment:
                                            <a asp-controller="Assessment" asp-action="Take" asp-route-id="@content.Id" class="today-text-action">@content.Title <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                                            break;
                                    }
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            @if (Model.Courses.Count == 0 && suggestions.Count > 0)
            {
                <section class="today-section" aria-labelledby="suggested-courses-title">
                    <header class="today-section-heading"><h2 id="suggested-courses-title">Khóa học gợi ý cho bạn</h2></header>
                    <div class="dashboard-discovery-grid">
                        @foreach (var course in suggestions)
                        {
                            <partial name="_DiscoveryCourseCard" model="course" />
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="today-rail" aria-label="Thành tích và hoạt động">
            @if (gamification is { } achievement)
            {
                <section class="today-streak-card" aria-labelledby="today-streak-heading">
                    <header>
                        <span class="today-icon-tile today-icon-tile--warm">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#sparkles")"></use></svg>
                        </span>
                        <h2 id="today-streak-heading">Chuỗi ngày học</h2>
                        <a asp-action="Progress" asp-route-tab="achievements" aria-label="Xem thành tích và XP" class="today-icon-action">
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    </header>
                    <div class="today-streak-value">
                        <div><strong>@achievement.CurrentStreak</strong> ngày</div>
                        <span class="today-tag">@achievement.TotalXp XP</span>
                    </div>
                    <p class="@(achievement.StudiedToday ? "is-studied" : "")">
                        @if (achievement.StudiedToday)
                        {
                            <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#check-circle")"></use></svg>
                        }
                        @(achievement.StudiedToday ? "Đã học hôm nay" : "Hôm nay chưa ghi nhận")
                    </p>
                </section>
            }

            <section class="calendar-date-card" id="calendar-widget" aria-labelledby="today-calendar-heading">
                <header class="calendar-header-row">
                    <h2 id="today-calendar-heading">Hoạt động tuần</h2>
                    <span class="calendar-month-label">
                        @(weekDays[0].Month == weekDays[6].Month ? weekStart.ToString("MM/yyyy") : $"{weekDays[0]:MM}–{weekDays[6]:MM/yyyy}")
                    </span>
                </header>
                <div class="calendar-strip-row" role="group" aria-label="Chọn ngày">
                    @for (var index = 0; index < weekDays.Length; index++)
                    {
                        var day = weekDays[index];
                        var calendarKey = day.ToString("yyyy-MM-dd");
                        var isToday = day == localToday;
                        var isSelected = day == selectedDay;
                        var count = activitiesByDay[day].Count();
                        var studied = gamification?.RecentActivityDates.Contains(day) == true;
                        <button type="button" class="calendar-day-col @(isSelected ? "active" : "") @(isToday ? "is-today" : "")"
                                data-calendar-day="@calendarKey" aria-controls="calendar-@calendarKey"
                                aria-pressed="@(isSelected ? "true" : "false")" aria-current="@(isToday ? "date" : null)"
                                aria-label="@dayNames[index], @day.ToString("dd/MM/yyyy"), @(studied ? "đã học" : $"{count} hoạt động")">
                            <span class="calendar-day-name">@dayNames[index]</span>
                            <span class="calendar-day-num">@day.Day</span>
                            <span class="calendar-day-dot @(count > 0 || studied ? "has-activity" : "")" aria-hidden="true"></span>
                        </button>
                    }
                </div>
                <div aria-live="polite">
                    @foreach (var day in weekDays)
                    {
                        var calendarKey = day.ToString("yyyy-MM-dd");
                        var activities = activitiesByDay[day].OrderBy(activity => activity.OccurredAtUtc).ToArray();
                        <div class="calendar-day-panel" id="calendar-@calendarKey" data-calendar-panel="@calendarKey" hidden="@(day != selectedDay)">
                            <h3>Ngày @day.ToString("dd/MM/yyyy")</h3>
                            @if (activities.Length == 0)
                            {
                                <p class="today-muted">@(gamification?.RecentActivityDates.Contains(day) == true ? "Đã ghi nhận ngày học cho chuỗi." : "Chưa có hoạt động học tập.")</p>
                            }
                            else
                            {
                                <ul class="today-plain-list">
                                    @foreach (var activity in activities)
                                    {
                                        <li class="today-calendar-activity">
                                            <time datetime="@activity.OccurredAtUtc.ToString("O")">@activity.OccurredAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</time>
                                            <div>
                                                @switch (activity.Kind)
                                                {
                                                    case DashboardActivityKind.LessonCompleted:
                                                        if (activity.CanOpenTarget)
                                                        {
                                                            <a asp-action="Lesson" asp-route-id="@activity.TargetId">@activity.Title</a>
                                                        }
                                                        else
                                                        {
                                                            <strong>@activity.Title</strong>
                                                            <small>Bài học hiện không khả dụng</small>
                                                        }
                                                        break;
                                                    case DashboardActivityKind.PracticeSubmitted:
                                                        <a asp-controller="Practice" asp-action="Result" asp-route-id="@activity.TargetId">@activity.Title</a>
                                                        break;
                                                    case DashboardActivityKind.AssessmentFinalized:
                                                        <a asp-controller="Assessment" asp-action="Result" asp-route-id="@activity.TargetId">@activity.Title</a>
                                                        break;
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="today-rail-card" id="dashboard-results" aria-labelledby="today-results-title">
                <header class="today-rail-heading">
                    <h2 id="today-results-title">Kết quả cao nhất</h2>
                    <a asp-action="Progress" asp-route-tab="assessments">Tất cả</a>
                </header>
                @if (Model.Results.Count > 0)
                {
                    <ul class="today-plain-list">
                        @foreach (var result in Model.Results.Take(2))
                        {
                            <li class="today-result" data-representative-attempt="@result.AttemptId">
                                <div>
                                    <a asp-controller="Assessment" asp-action="Result" asp-route-id="@result.AttemptId">@result.Title</a>
                                    <time datetime="@result.FinalizedAtUtc.ToString("O")">@result.FinalizedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</time>
                                    @if (result.Skills.Count > 0)
                                    {
                                        <div class="today-result-skills" aria-label="Điểm theo kỹ năng">
                                            @foreach (var skill in result.Skills)
                                            {
                                                <span class="today-tag @(skill.IsWeak ? "today-tag--warm" : "")"><partial name="_UiText" model="skill.Skill" />: @skill.Score.ToString("0.##")%</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <strong>@result.OverallScore.ToString("0.##")%</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="today-muted">Bạn chưa có kết quả đánh giá.</p>
                    <a asp-controller="Assessment" asp-action="Index" class="today-text-action">Làm bài kiểm tra đầu vào <svg class="icon ui-arrow" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg></a>
                }
            </section>

            <section class="today-rail-card" id="dashboard-practice-results" aria-labelledby="dashboard-practice-results-title">
                <header class="today-rail-heading">
                    <h2 id="dashboard-practice-results-title">Luyện tập gần đây</h2>
                    @if (Model.PracticeResults.Count > 0)
                    {
                        <a asp-controller="Practice" asp-action="Index">Xem tất cả (@Model.PracticeResults.Count)</a>
                    }
                </header>
                @if (Model.PracticeResults.Count > 0)
                {
                    <ul class="today-plain-list">
                        @foreach (var practice in Model.PracticeResults.Take(2))
                        {
                            <li class="today-result">
                                <div>
                                    <a asp-controller="Practice" asp-action="Result" asp-route-id="@practice.PracticeId">@practice.Title</a>
                                    <time datetime="@practice.SubmittedAtUtc.ToString("O")">@practice.SubmittedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</time>
                                </div>
                                <strong>@practice.Score.ToString("0.##")%</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="today-muted">Bạn chưa nộp bài luyện tập nào.</p>
                }
            </section>
        </aside>
    </div>
</div>
