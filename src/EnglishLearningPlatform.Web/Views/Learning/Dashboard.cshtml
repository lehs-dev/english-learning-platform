@model StudentDashboard

@{
    ViewData["Title"] = "Trang chủ — Tiến độ học tập";
    ViewData["ActiveSection"] = "dashboard";

    // 1. Chỉ khóa còn bài chưa học mới là "tiếp tục học". CourseProgress có thể
    // fallback ContinueLessonId về bài đầu ngay cả khi khóa đã hoàn thành.
    // CompletedAtUtc là lịch sử; bài mới hoặc bài đánh dấu chưa xong vẫn cần học tiếp.
    var activeCourses = Model.Courses
        .Where(c => c.Status != CourseStatus.Archived && c.Progress is { TotalLessons: > 0 } progress &&
            (progress.CompletedLessons > 0 || progress.CompletedAtUtc is not null) &&
            progress.CompletedLessons < progress.TotalLessons)
        .ToList();
    var continueCourse = activeCourses.FirstOrDefault(c => c.Progress!.ContinueLessonId.HasValue);
    var finalPendingCourse = Model.Courses.FirstOrDefault(c =>
        c.Status != CourseStatus.Archived && c.Progress is { TotalLessons: > 0, CompletedAtUtc: null } progress &&
        progress.CompletedLessons >= progress.TotalLessons);
    var heroCourse = continueCourse ?? finalPendingCourse;
    var otherCourses = Model.Courses.Where(c => c.Id != heroCourse?.Id).Take(6).ToList();

    // 2. Calendar tuần hiện tại theo UTC+7, dùng đúng tuần mà service đã query.
    var localToday = DateOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).DateTime);
    var weekStart = Model.WeekStartDate == default ? localToday.AddDays(-(((int)localToday.DayOfWeek + 6) % 7)) : Model.WeekStartDate;
    var weekDays = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList();
    var selectedDay = weekDays.Contains(localToday) ? localToday : weekStart;
    var activitiesByDay = Model.WeeklyActivities
        .ToLookup(a => DateOnly.FromDateTime(a.OccurredAtUtc.ToOffset(TimeSpan.FromHours(7)).DateTime));
    string[] dayNamesVi = { "T2", "T3", "T4", "T5", "T6", "T7", "CN" };

    // 3. Pastel Card Theme Classes
    string[] pastelCardThemes = { "progress-card-lavender", "progress-card-peach", "progress-card-pink" };
    var suggestedCourses = ViewData["SuggestedCourses"] as IReadOnlyList<CourseSummary> ?? Array.Empty<CourseSummary>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-columns-grid">
    @* =========================================================================
       LEFT COLUMN (~66%): Hero Promo Banner + Your Progress + Top Recommendations
       ========================================================================= *@
    <div class="col-main-content">
        @* 1. Hero Promo Banner (Pastel Periwinkle with Vector Illustration) *@
        <section class="hero-promo-banner" aria-label="Học tiếp 1-click">
            <div class="hero-promo-content">
                @if (continueCourse != null)
                {
                    <div class="pill-tag-dark" style="margin-bottom: 8px;">
                        <span>📖 Khóa học đang diễn ra</span>
                    </div>
                    <h1 class="hero-promo-title">
                        Bạn đã sẵn sàng tiếp tục học "@continueCourse.Title" chưa?
                    </h1>
                    <p class="hero-promo-desc">
                        Giảng viên: @continueCourse.Teacher · Trình độ: <partial name="_UiText" model="continueCourse.Level" /> · @continueCourse.LessonCount bài học
                    </p>
                    <a asp-action="Continue" asp-route-id="@continueCourse.Id" class="btn-dark">
                        <span>Tiếp tục học ngay</span>
                        <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    </a>
                }
                else if (finalPendingCourse != null)
                {
                    <div class="pill-tag-dark" style="margin-bottom: 8px;">
                        <span>🎓 Đã hoàn thành bài học</span>
                    </div>
                    <h1 class="hero-promo-title">
                        Hoàn tất khóa "@finalPendingCourse.Title" bằng bài thi cuối khóa
                    </h1>
                    <p class="hero-promo-desc">
                        Bạn đã học xong @finalPendingCourse.Progress!.CompletedLessons/@finalPendingCourse.Progress.TotalLessons bài. Làm bài thi cuối khóa để ghi nhận hoàn thành.
                    </p>
                    <a asp-action="Course" asp-route-id="@finalPendingCourse.Id" class="btn-dark">
                        <span>Làm bài thi cuối khóa</span>
                        <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    </a>
                }
                else if (Model.CompletedCourses > 0)
                {
                    <div class="pill-tag-dark" style="margin-bottom: 8px;">
                        <span>✅ Bạn đã hoàn thành @Model.CompletedCourses khóa học</span>
                    </div>
                    <h1 class="hero-promo-title">
                        Tiếp tục mở rộng lộ trình học của bạn
                    </h1>
                    <p class="hero-promo-desc">
                        Các khóa đã hoàn thành vẫn được lưu trong tiến độ. Khám phá nội dung mới để tiếp tục học.
                    </p>
                    <a asp-controller="Courses" asp-action="Index" class="btn-dark">
                        <span>Khám phá khóa học mới</span>
                        <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    </a>
                }
                else
                {
                    <div class="pill-tag-dark" style="margin-bottom: 8px;">
                        <span>✨ Chào mừng bạn đến với Estudy V2</span>
                    </div>
                    <h1 class="hero-promo-title">
                        Bắt đầu lộ trình học tiếng Anh chuẩn hóa của bạn ngay hôm nay!
                    </h1>
                    <p class="hero-promo-desc">
                        Khám phá các khóa học thực tế, bài tập có giải thích chi tiết và các bài kiểm tra chẩn đoán năng lực 15 phút.
                    </p>
                    <a asp-controller="Courses" asp-action="Index" class="btn-dark">
                        <span>Khám phá khóa học</span>
                        <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                    </a>
                }
            </div>

            @* Line Art Illustration of Student on Stack of Books *@
            <div class="hero-promo-art" aria-hidden="true">
                <svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:auto;">
                    <path d="M15 65 Q 40 45, 65 60 T 115 35" stroke="#191A23" stroke-width="1.8" stroke-dasharray="3 3"/>
                    <circle cx="15" cy="65" r="3.5" fill="#FF71CE"/>
                    <circle cx="65" cy="60" r="3.5" fill="#FF71CE"/>
                    <circle cx="115" cy="35" r="4.5" fill="#191A23"/>

                    <rect x="75" y="10" width="40" height="26" rx="4" fill="#FFFFFF" stroke="#191A23" stroke-width="1.5"/>
                    <circle cx="85" cy="23" r="4" fill="#FF71CE" opacity="0.3"/>
                    <polyline points="83 23, 85 25, 88 21" stroke="#191A23" stroke-width="1.5" stroke-linecap="round"/>
                    <line x1="93" y1="23" x2="108" y2="23" stroke="#191A23" stroke-width="1.5" stroke-linecap="round"/>

                    <rect x="70" y="128" width="130" height="14" rx="3" fill="#FFFFFF" stroke="#191A23" stroke-width="2"/>
                    <line x1="80" y1="135" x2="190" y2="135" stroke="#191A23" stroke-width="1.5"/>

                    <rect x="76" y="112" width="120" height="16" rx="3" fill="#FFFFFF" stroke="#191A23" stroke-width="2"/>
                    <rect x="80" y="115" width="20" height="10" rx="2" fill="#FF71CE"/>
                    <line x1="106" y1="120" x2="185" y2="120" stroke="#191A23" stroke-width="1.5"/>

                    <rect x="82" y="96" width="110" height="16" rx="3" fill="#FFFFFF" stroke="#191A23" stroke-width="2"/>
                    <line x1="90" y1="104" x2="180" y2="104" stroke="#191A23" stroke-width="1.5"/>

                    <path d="M125 75 L115 110 L135 125" stroke="#191A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    <path d="M132 80 L140 105 L155 122" stroke="#191A23" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    <path d="M120 72 C115 90, 110 108, 128 126 C136 126, 142 110, 136 90 Z" fill="#FFFFFF" stroke="#191A23" stroke-width="1.8"/>
                    <path d="M130 75 C136 90, 142 108, 155 122 C162 120, 156 102, 145 80 Z" fill="#FFFFFF" stroke="#191A23" stroke-width="1.8"/>

                    <path d="M135 48 C125 56, 126 74, 136 78 C148 78, 156 65, 150 48 Z" fill="#191A23"/>

                    <path d="M138 52 C146 56, 155 60, 150 72" stroke="#191A23" stroke-width="2" stroke-linecap="round" fill="none"/>
                    <rect x="136" y="58" width="22" height="14" rx="2" fill="#FFFFFF" stroke="#191A23" stroke-width="1.5" transform="rotate(-12 136 58)"/>

                    <circle cx="148" cy="38" r="8" fill="#FEE2E2" stroke="#191A23" stroke-width="1.5"/>
                    <path d="M142 34 C138 24, 156 18, 160 26 C168 28, 168 40, 158 40 C154 40, 150 44, 144 38 Z" fill="#191A23"/>
                    <circle cx="160" cy="28" r="6" fill="#191A23"/>
                    <circle cx="152" cy="22" r="7" fill="#191A23"/>

                    <path d="M60 40 L63 46 L70 48 L63 50 L60 56 L57 50 L50 48 L57 46 Z" fill="#FF71CE"/>
                    <polygon points="175,20 177,24 182,25 177,26 175,30 173,26 168,25 173,24" fill="#191A23"/>
                </svg>
            </div>
        </section>

        @if (Model.Courses.Count == 0 && suggestedCourses.Count > 0)
        {
            <section class="dashboard-discovery" aria-labelledby="suggested-courses-title">
                <div class="clean-section-header">
                    <h2 class="clean-section-title" id="suggested-courses-title">Khóa học gợi ý cho bạn</h2>
                </div>
                <p class="section-subtitle-clean">Khám phá nội dung và chọn khóa học phù hợp với bạn.</p>
                <div class="dashboard-discovery-grid">
                    @foreach (var course in suggestedCourses)
                    {
                        <partial name="_DiscoveryCourseCard" model="course" />
                    }
                </div>
                <div class="dashboard-discovery-action">
                    <a asp-controller="Courses" asp-action="Index" class="btn-dark-sm">Khám phá khóa học ngay</a>
                </div>
            </section>
        }

        @* 2. "Your progress" Section (3 Pastel Cards in a Row) *@
        <div class="clean-section-header" id="your-progress">
            <h2 class="clean-section-title">Tiến độ học tập</h2>
            <a asp-action="Index" class="btn-outline-dark" style="padding: 6px 14px; font-size: 12px;">
                Tất cả khóa đã tham gia (@Model.Courses.Count)
            </a>
        </div>

        @if (Model.Courses.Count > 0)
        {
            <div class="progress-cards-row">
                @{
                    var displayCourses = Model.Courses.Take(6).ToList();
                    for (int i = 0; i < displayCourses.Count; i++)
                    {
                        var c = displayCourses[i];
                        var themeClass = pastelCardThemes[i % pastelCardThemes.Length];
                        var pct = c.Progress?.Percentage;
                        var pctStr = pct?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "0";

                        <div class="progress-pastel-card @themeClass">
                            <div class="progress-card-top">
                                <div class="progress-icon-circle">
                                    <svg viewBox="0 0 24 24" style="width:18px; height:18px;" fill="none" stroke="#191A23" stroke-width="2.4" aria-hidden="true">
                                        <polygon points="12 2 2 22 22 22"></polygon>
                                    </svg>
                                </div>
                                <span class="pill-tag pill-tag-purple" style="background:rgba(255,255,255,0.7);">
                                    <partial name="_UiText" model="c.Level" />
                                </span>
                            </div>

                            <div>
                                <h3 class="progress-card-title">
                                    <a asp-action="Course" asp-route-id="@c.Id" style="color:inherit; text-decoration:none;">@c.Title</a>
                                </h3>
                                <div class="progress-track-clean">
                                    <div class="progress-fill-clean" style="width: @pctStr%;"></div>
                                </div>
                                <div class="progress-card-footer">
                                    <span>
                                        @if (c.Progress is { TotalLessons: > 0 } courseProgress)
                                        {
                                            <text>@courseProgress.CompletedLessons/@courseProgress.TotalLessons bài</text>
                                        }
                                        else
                                        {
                                            <text>Chưa có bài học</text>
                                        }
                                    </span>
                                    <strong>@(pct.HasValue ? $"{pct.Value.ToString("0.##")}%" : "—")</strong>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="panel empty" style="border-radius: 20px; padding: 32px; text-align: center; background: #FFFFFF; border: 1px solid var(--v2-border-light);">
                <p style="font-weight: 600; color: var(--v2-dark); margin-bottom: 8px;">Bạn chưa tham gia khóa học nào.</p>
                <p class="section-subtitle-clean" style="margin-bottom: 16px;">Hãy khám phá danh mục khóa học để bắt đầu lộ trình của mình.</p>
                <a asp-controller="Courses" asp-action="Index" class="btn-dark-sm">Khám phá khóa học ngay</a>
            </div>
        }

        @* 3. Gợi ý ôn tập theo kỹ năng (dữ liệu thật, không có bài viết giả) *@
        <div class="clean-section-header" style="margin-top:32px;">
            <h2 class="clean-section-title" id="recommendations-title">Gợi ý ôn tập theo kỹ năng</h2>
        </div>

        @if (Model.Recommendations.Count == 0)
        {
            <div class="panel empty" style="border-radius:20px; padding:24px; background:#FFFFFF; border:1px solid var(--v2-border-light);">
                <p style="font-weight:600; color:var(--v2-dark); margin-bottom:6px;">Chưa có gợi ý ôn tập.</p>
                <p class="section-subtitle-clean" style="margin-bottom:14px;">Hoàn thành một bài đánh giá năng lực để nhận gợi ý theo kỹ năng yếu.</p>
                <a asp-controller="Assessment" asp-action="Index" class="btn-dark-sm">Xem bài đánh giá</a>
            </div>
        }
        else
        {
            <div class="articles-cards-row">
                @foreach (var recommendation in Model.Recommendations.Take(4))
                {
                    <article class="article-clean-card">
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
                            <span class="pill-tag pill-tag-orange"><partial name="_UiText" model="recommendation.Skill" /></span>
                            <strong style="font-size:15px; color:var(--v2-dark);">@recommendation.Score.ToString("0.##")%</strong>
                        </div>
                        <p class="section-subtitle-clean" style="margin:0 0 12px;">
                            Căn cứ từ bài: <a asp-controller="Assessment" asp-action="Result" asp-route-id="@recommendation.AttemptId">@recommendation.AssessmentTitle</a>
                        </p>
                        @if (recommendation.Contents.Count == 0)
                        {
                            <p class="section-subtitle-clean" style="margin:0;">Chưa có nội dung phù hợp trong các khóa bạn đã tham gia.</p>
                        }
                        else
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:auto;">
                                @foreach (var content in recommendation.Contents.Take(2))
                                {
                                    switch (content.Kind)
                                    {
                                        case RecommendedContentKind.Course:
                                            <a asp-action="Course" asp-route-id="@content.Id" class="btn-dark-sm">Học: @content.Title</a>
                                            break;
                                        case RecommendedContentKind.Practice:
                                            <a asp-controller="Practice" asp-action="Take" asp-route-id="@content.Id" class="btn-dark-sm">Luyện: @content.Title</a>
                                            break;
                                        case RecommendedContentKind.Assessment:
                                            <a asp-controller="Assessment" asp-action="Take" asp-route-id="@content.Id" class="btn-dark-sm">Đánh giá: @content.Title</a>
                                            break;
                                    }
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }

        @* 4. Kết quả luyện tập gần đây; toàn bộ kết quả nằm ở trang Luyện tập. *@
        <section id="dashboard-practice-results" aria-labelledby="dashboard-practice-results-title" style="margin-top:32px;">
            <div class="clean-section-header">
                <h2 class="clean-section-title" id="dashboard-practice-results-title">Luyện tập gần đây</h2>
                <a asp-controller="Practice" asp-action="Index" class="btn-outline-dark" style="padding:6px 14px; font-size:12px;">
                    Xem tất cả (@Model.PracticeResults.Count)
                </a>
            </div>

            @if (Model.PracticeResults.Count == 0)
            {
                <div class="panel empty" style="border-radius:20px; padding:24px; background:#FFFFFF; border:1px solid var(--v2-border-light);">
                    <p style="font-weight:600; color:var(--v2-dark); margin-bottom:6px;">Bạn chưa nộp bài luyện tập nào.</p>
                    <p class="section-subtitle-clean" style="margin-bottom:14px;">Vào khóa học để luyện tập và xem lời giải chi tiết.</p>
                    <a asp-action="Index" class="btn-dark-sm">Xem khóa học của tôi</a>
                </div>
            }
            else
            {
                <div class="articles-cards-row">
                    @foreach (var practice in Model.PracticeResults.Take(3))
                    {
                        <article class="article-clean-card">
                            <h3 class="article-clean-title">@practice.Title</h3>
                            <p class="section-subtitle-clean" style="margin-bottom:12px;">
                                Điểm đạt: <strong>@practice.Score.ToString("0.##")%</strong> ·
                                <time datetime="@practice.SubmittedAtUtc.ToString("O")">@practice.SubmittedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time>
                            </p>
                            <div class="article-clean-meta" style="margin-top:auto;">
                                <a asp-controller="Practice" asp-action="Result" asp-route-id="@practice.PracticeId" class="btn-dark-sm">Xem lại bài giải</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    @* =========================================================================
       RIGHT COLUMN (~34%): Dynamic Calendar Strip + Courses + Assessment Results
       ========================================================================= *@
    <div class="col-secondary-content">
        @* 1. Calendar / Date Strip Widget (Dynamic Current Week) *@
        <div class="calendar-date-card" id="calendar-widget">
            <div class="calendar-header-row">
                <span class="calendar-month-label">
                    @if (weekDays[0].Month == weekDays[6].Month)
                    {
                        <text>Tháng @weekStart.ToString("MM / yyyy")</text>
                    }
                    else
                    {
                        <text>@weekDays[0].ToString("MM") – @weekDays[6].ToString("MM / yyyy")</text>
                    }
                </span>
                <span class="pill-tag pill-tag-purple">Hôm nay</span>
            </div>

            <div class="calendar-strip-row" role="region" aria-label="Lịch tuần này">
                @for (int i = 0; i < weekDays.Count; i++)
                {
                    var d = weekDays[i];
                    var isToday = d == localToday;
                    var isSelected = d == selectedDay;
                    var activityCount = activitiesByDay[d].Count();

                    <button type="button" class="calendar-day-col @(isSelected ? "active" : "") @(isToday ? "is-today" : "")"
                            data-calendar-day="@d.ToString("yyyy-MM-dd")" aria-pressed="@(isSelected ? "true" : "false")"
                            aria-label="@dayNamesVi[i], @d.ToString("dd/MM/yyyy"), @activityCount hoạt động"
                            title="@d.ToString("dd/MM/yyyy")">
                        <span class="calendar-day-name">@dayNamesVi[i]</span>
                        <span class="calendar-day-num">@d.Day</span>
                        @if (activityCount > 0)
                        {
                            <span class="calendar-day-dot" aria-hidden="true"></span>
                        }
                    </button>
                }
            </div>

            @foreach (var d in weekDays)
            {
                var activities = activitiesByDay[d].OrderBy(a => a.OccurredAtUtc).ToList();
                <div class="calendar-day-panel" data-calendar-panel="@d.ToString("yyyy-MM-dd")" hidden="@(d != selectedDay ? "hidden" : null)">
                    <h3 class="calendar-day-panel-title">Hoạt động ngày @d.ToString("dd/MM/yyyy")</h3>
                    @if (activities.Count == 0)
                    {
                        <p class="section-subtitle-clean" style="margin:0;">Chưa có hoạt động học tập trong ngày này.</p>
                    }
                    else
                    {
                        <ul class="calendar-activity-list">
                            @foreach (var activity in activities)
                            {
                                <li>
                                    <span class="calendar-activity-time">@activity.OccurredAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</span>
                                    @switch (activity.Kind)
                                    {
                                        case DashboardActivityKind.LessonCompleted:
                                            @if (activity.CanOpenTarget)
                                            {
                                                <a asp-action="Lesson" asp-route-id="@activity.TargetId">@activity.Title</a>
                                            }
                                            else
                                            {
                                                <span>@activity.Title</span>
                                                <span class="calendar-activity-kind">Bài học hiện không khả dụng</span>
                                            }
                                            <span class="calendar-activity-kind">Hoàn thành bài học</span>
                                            break;
                                        case DashboardActivityKind.PracticeSubmitted:
                                            <a asp-controller="Practice" asp-action="Result" asp-route-id="@activity.TargetId">@activity.Title</a>
                                            <span class="calendar-activity-kind">Nộp bài luyện tập</span>
                                            break;
                                        case DashboardActivityKind.AssessmentFinalized:
                                            <a asp-controller="Assessment" asp-action="Result" asp-route-id="@activity.TargetId">@activity.Title</a>
                                            <span class="calendar-activity-kind">Chấm bài đánh giá</span>
                                            break;
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>

        @* 2. Enrolled & Completed Courses KPI *@
        <div class="upcoming-courses-card">
            <div class="clean-section-header" style="margin-top:0; margin-bottom:14px;">
                <h2 class="clean-section-title" style="font-size:16px;">Khóa học của bạn</h2>
                <span class="pill-tag pill-tag-mint">@Model.CompletedCourses hoàn thành</span>
            </div>

            <div class="upcoming-courses-list">
                @if (otherCourses.Count > 0)
                {
                    @foreach (var course in otherCourses)
                    {
                        var cSkill = course.Skills.FirstOrDefault();
                        <div class="upcoming-course-item">
                            <div class="upcoming-tags-row">
                                <span class="pill-tag pill-tag-purple"><partial name="_UiText" model="course.Level" /></span>
                                <span class="pill-tag pill-tag-orange"><partial name="_UiText" model="cSkill" /></span>
                            </div>

                            <div class="upcoming-title-price">
                                <h3 class="upcoming-course-name">
                                    <a asp-action="Course" asp-route-id="@course.Id">@course.Title</a>
                                </h3>
                            </div>

                            <div class="upcoming-meta-row">
                                <span class="upcoming-meta-item">
                                    <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#user")"></use></svg>
                                    <span>@course.Teacher</span>
                                </span>
                                <span class="upcoming-meta-item">
                                    <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg>
                                    <span>@course.LessonCount bài</span>
                                </span>
                            </div>

                            <div class="upcoming-bottom-row">
                                <span class="pill-tag pill-tag-dark"><partial name="_UiText" model="course.Status" /></span>
                                <a asp-action="Course" asp-route-id="@course.Id" class="btn-dark-sm">Xem khóa</a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="section-subtitle-clean">Chưa có khóa học bổ sung nào.</p>
                }
            </div>
        </div>

        @* 3. Assessment Results Clean Card *@
        <div class="assessment-results-card" id="dashboard-results">
            <div class="clean-section-header" style="margin-top:0; margin-bottom:14px;">
                <h2 class="clean-section-title" style="font-size:16px;">Kết quả cao nhất</h2>
                <a asp-controller="Profile" asp-action="Index" asp-fragment="assessment-results" class="btn-outline-dark" style="padding:4px 10px; font-size:11px;">
                    Tất cả kết quả
                </a>
            </div>

            @if (Model.Results.Count > 0)
            {
                @foreach (var res in Model.Results.Take(2))
                {
                    <div class="result-item-row" data-representative-attempt="@res.AttemptId">
                        <div class="upcoming-title-price">
                            <h3 class="upcoming-course-name">
                                <a asp-controller="Assessment" asp-action="Result" asp-route-id="@res.AttemptId">@res.Title</a>
                            </h3>
                            <span class="upcoming-course-price" style="color:var(--v2-dark);">@res.OverallScore.ToString("0.##")%</span>
                        </div>
                        <p class="section-subtitle-clean">Điểm cao nhất · <time datetime="@res.FinalizedAtUtc.ToString("O")">@res.FinalizedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time></p>

                        <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:8px;">
                            @foreach (var sk in res.Skills)
                            {
                                <span class="pill-tag @(sk.IsWeak ? "pill-tag-orange" : "pill-tag-purple")">
                                    <partial name="_UiText" model="sk.Skill" />: @sk.Score.ToString("0.##")%
                                </span>
                            }
                            @if (res.Skills.Count == 0)
                            {
                                <span class="section-subtitle-clean">Chưa đủ dữ liệu kỹ năng để phân tích.</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="section-subtitle-clean">Chưa có kết quả bài kiểm tra năng lực.</p>
                <div style="margin-top:12px;">
                    <a asp-controller="Assessment" asp-action="Index" class="btn-dark-sm">
                        Làm bài kiểm tra đầu vào
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chọn ngày để xem chi tiết hoạt động; dữ liệu được render sẵn từ server.
            var dayButtons = document.querySelectorAll('.calendar-day-col');
            var panels = document.querySelectorAll('[data-calendar-panel]');
            dayButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    dayButtons.forEach(function (item) {
                        item.classList.remove('active');
                        item.setAttribute('aria-pressed', 'false');
                    });
                    button.classList.add('active');
                    button.setAttribute('aria-pressed', 'true');
                    var day = button.dataset.calendarDay;
                    panels.forEach(function (panel) {
                        panel.hidden = panel.dataset.calendarPanel !== day;
                    });
                });
            });
        });
    </script>
}
