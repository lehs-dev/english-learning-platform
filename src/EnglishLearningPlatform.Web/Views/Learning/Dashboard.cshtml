@model StudentDashboard
@using EnglishLearningPlatform.Application.Gamification
@inject TimeProvider Clock

@{
    ViewData["Title"] = "Hôm nay — Tiến độ học tập";
    ViewData["ActiveSection"] = "dashboard";

    // 1. Phân loại khóa học ưu tiên theo dữ liệu thật
    var activeCourses = Model.Courses
        .Where(c => c.Status != CourseStatus.Archived && c.Progress is { TotalLessons: > 0 } progress &&
            (progress.CompletedLessons > 0 || progress.CompletedAtUtc is not null) &&
            progress.CompletedLessons < progress.TotalLessons)
        .ToList();
    var continueCourse = activeCourses.FirstOrDefault(c => c.Progress!.ContinueLessonId.HasValue) ?? activeCourses.FirstOrDefault();
    var finalPendingCourse = Model.Courses.FirstOrDefault(c =>
        c.Status != CourseStatus.Archived && c.Progress is { TotalLessons: > 0, CompletedAtUtc: null } progress &&
        progress.CompletedLessons >= progress.TotalLessons);
    var notStartedCourse = Model.Courses.FirstOrDefault(c =>
        c.Status != CourseStatus.Archived && (c.Progress == null || (c.Progress.CompletedLessons == 0 && c.Progress.CompletedAtUtc == null)));

    // Tối đa 2 khóa học nổi bật trên màn hình Hôm nay
    var spotlightCourses = new List<CourseSummary>();
    if (continueCourse != null) spotlightCourses.Add(continueCourse);
    if (finalPendingCourse != null && !spotlightCourses.Any(c => c.Id == finalPendingCourse.Id)) spotlightCourses.Add(finalPendingCourse);
    foreach (var c in Model.Courses)
    {
        if (spotlightCourses.Count >= 2) break;
        if (!spotlightCourses.Any(s => s.Id == c.Id)) spotlightCourses.Add(c);
    }

    // 2. Calendar tuần hiện tại theo UTC+7
    var localToday = GamificationPolicy.LocalDate(Clock.GetUtcNow());
    var weekStart = Model.WeekStartDate == default ? localToday.AddDays(-(((int)localToday.DayOfWeek + 6) % 7)) : Model.WeekStartDate;
    var weekDays = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList();
    var selectedDay = weekDays.Contains(localToday) ? localToday : weekStart;
    var activitiesByDay = Model.WeeklyActivities.ToLookup(a => GamificationPolicy.LocalDate(a.OccurredAtUtc));
    var gamification = ViewData["Gamification"] as GamificationSummary;
    string[] dayNamesVi = { "T2", "T3", "T4", "T5", "T6", "T7", "CN" };

    string[] pastelCardThemes = { "progress-card-lavender", "progress-card-peach" };
    var suggestedCourses = ViewData["SuggestedCourses"] as IReadOnlyList<CourseSummary> ?? Array.Empty<CourseSummary>();
    var dueDecks = ViewData["DueDecks"] as IReadOnlyList<EnglishLearningPlatform.Application.Flashcards.FlashcardDeckSummary> ?? Array.Empty<EnglishLearningPlatform.Application.Flashcards.FlashcardDeckSummary>();
    var learningPathPage = ViewData["LearningPathPage"] as EnglishLearningPlatform.Application.LearningPath.LearningPathPage;
}

<div class="today-workspace-container">
    <!-- 1. Header lời chào ngắn & Chỉ báo XP/Streak nhỏ gọn -->
    <header class="today-greeting-header">
        <div class="today-greeting-main">
            <span class="today-date-badge">@localToday.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span>
            <h1 class="today-title">Chào buổi học mới, @(User.Identity?.Name ?? "học viên")!</h1>
            <p class="today-subtitle">Tiếp tục hành trình cải thiện kỹ năng tiếng Anh hôm nay.</p>
        </div>
        @if (gamification is { } achievement)
        {
            <div class="today-gamification-pills" aria-label="Thành tích cá nhân">
                <a asp-controller="Learning" asp-action="Progress" asp-route-tab="achievements" class="today-stat-pill" title="Xem thành tích XP">
                    <span class="today-stat-icon">⚡</span>
                    <strong>@achievement.TotalXp XP</strong>
                </a>
                <a asp-controller="Learning" asp-action="Progress" asp-route-tab="achievements" class="today-stat-pill" title="Xem chuỗi học tập">
                    <span class="today-stat-icon" aria-hidden="true">🔥</span>
                    <span>
                        <strong>Chuỗi @achievement.CurrentStreak ngày</strong>
                        <small class="today-streak-status">@(achievement.StudiedToday ? "Đã học hôm nay" : "Hôm nay chưa ghi nhận")</small>
                    </span>
                </a>
            </div>
        }
    </header>

    <div class="dashboard-columns-grid">
        @* =========================================================================
           LEFT COLUMN: Primary CTA + Spotlight Courses (Max 2) + Daily Widgets
           ========================================================================= *@
        <div class="col-main-content">
            @* 2. Hero Primary CTA: Duy nhất một hành động chính theo dữ liệu thật *@
            <section class="hero-promo-banner" aria-label="Học tiếp 1-click">
                <div class="hero-promo-content">
                    @if (continueCourse != null)
                    {
                        <div class="pill-tag pill-tag-dark" style="margin-bottom: 8px;">
                            <span>📖 Khóa học đang diễn ra</span>
                        </div>
                        <h2 class="hero-promo-title">
                            Bạn đã sẵn sàng tiếp tục học "@continueCourse.Title" chưa?
                        </h2>
                        <p class="hero-promo-desc">
                            Giảng viên: @continueCourse.Teacher · Trình độ: <partial name="_UiText" model="continueCourse.Level" /> · @continueCourse.LessonCount bài học
                        </p>
                        <a asp-action="Continue" asp-route-id="@continueCourse.Id" class="btn-dark">
                            <span>Tiếp tục học ngay</span>
                            <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else if (finalPendingCourse != null)
                    {
                        <div class="pill-tag pill-tag-dark" style="margin-bottom: 8px;">
                            <span>🎓 Đã hoàn thành bài học</span>
                        </div>
                        <h2 class="hero-promo-title">
                            Hoàn tất khóa "@finalPendingCourse.Title" bằng bài thi cuối khóa
                        </h2>
                        <p class="hero-promo-desc">
                            Bạn đã học xong @finalPendingCourse.Progress!.CompletedLessons/@finalPendingCourse.Progress.TotalLessons bài. Làm bài thi cuối khóa để ghi nhận hoàn thành.
                        </p>
                        <a asp-action="Course" asp-route-id="@finalPendingCourse.Id" asp-route-tab="assessment" class="btn-dark">
                            <span>Làm bài thi cuối khóa</span>
                            <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else if (notStartedCourse != null)
                    {
                        <div class="pill-tag pill-tag-dark" style="margin-bottom: 8px;">
                            <span>🚀 Sẵn sàng khởi đầu</span>
                        </div>
                        <h2 class="hero-promo-title">
                            Bắt đầu học khóa "@notStartedCourse.Title"
                        </h2>
                        <p class="hero-promo-desc">
                            Giảng viên: @notStartedCourse.Teacher · Trình độ: <partial name="_UiText" model="notStartedCourse.Level" /> · @notStartedCourse.LessonCount bài học
                        </p>
                        <a asp-action="Continue" asp-route-id="@notStartedCourse.Id" class="btn-dark">
                            <span>Bắt đầu khóa học</span>
                            <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else if (Model.CompletedCourses > 0 && Model.Courses.Count > 0)
                    {
                        <div class="pill-tag pill-tag-dark" style="margin-bottom: 8px;">
                            <span>✅ Bạn đã hoàn thành @Model.CompletedCourses khóa học</span>
                        </div>
                        <h2 class="hero-promo-title">
                            Tiếp tục mở rộng lộ trình học của bạn
                        </h2>
                        <p class="hero-promo-desc">
                            Các khóa đã hoàn thành vẫn được lưu trong tiến độ. Khám phá nội dung mới để tiếp tục học.
                        </p>
                        <a asp-controller="Courses" asp-action="Index" class="btn-dark">
                            <span>Khám phá khóa học mới</span>
                            <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                    else
                    {
                        <div class="pill-tag pill-tag-dark" style="margin-bottom: 8px;">
                            <span>✨ Chào mừng bạn đến với Estudy</span>
                        </div>
                        <h2 class="hero-promo-title">
                            Bắt đầu lộ trình học tiếng Anh chuẩn hóa của bạn ngay hôm nay!
                        </h2>
                        <p class="hero-promo-desc">
                            Khám phá các khóa học thực tế, bài tập có giải thích chi tiết và các bài kiểm tra chẩn đoán năng lực.
                        </p>
                        <a asp-controller="Courses" asp-action="Index" class="btn-dark">
                            <span>Khám phá khóa học</span>
                            <svg class="icon icon-sm" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
                        </a>
                    }
                </div>

                <div class="hero-promo-art" aria-hidden="true">
                    <svg viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:100%; height:auto;">
                        <path d="M15 65 Q 40 45, 65 60 T 115 35" stroke="#191A23" stroke-width="1.8" stroke-dasharray="3 3"/>
                        <circle cx="15" cy="65" r="3.5" fill="#FF71CE"/>
                        <circle cx="65" cy="60" r="3.5" fill="#FF71CE"/>
                        <circle cx="115" cy="35" r="4.5" fill="#191A23"/>
                        <rect x="70" y="128" width="130" height="14" rx="3" fill="#FFFFFF" stroke="#191A23" stroke-width="2"/>
                        <rect x="76" y="112" width="120" height="16" rx="3" fill="#FFFFFF" stroke="#191A23" stroke-width="2"/>
                        <rect x="82" y="96" width="110" height="16" rx="3" fill="#FFFFFF" stroke="#191A23" stroke-width="2"/>
                        <path d="M135 48 C125 56, 126 74, 136 78 C148 78, 156 65, 150 48 Z" fill="#191A23"/>
                    </svg>
                </div>
            </section>

            <nav class="today-activity-links" aria-label="Hoạt động học tập">
                <a class="button secondary" asp-controller="Practice" asp-action="Index">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#target")"></use></svg>
                    Luyện tập
                </a>
                <a class="button secondary" asp-controller="Assessment" asp-action="Index">
                    <svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg>
                    Bài kiểm tra
                </a>
            </nav>

            @* 3. Khóa học nổi bật (Tối đa 2 khóa spotlight) *@
            <div class="clean-section-header" id="your-progress" style="margin-top:28px;">
                <h2 class="clean-section-title">Khóa học của bạn</h2>
                @if (Model.Courses.Count > 0)
                {
                    <a asp-action="Index" class="btn-outline-dark">
                        Tất cả khóa học (@Model.Courses.Count) &rarr;
                    </a>
                }
            </div>

            @if (spotlightCourses.Count > 0)
            {
                <div class="progress-cards-row spotlight-cards-row">
                    @for (int i = 0; i < spotlightCourses.Count; i++)
                    {
                        var c = spotlightCourses[i];
                        var themeClass = pastelCardThemes[i % pastelCardThemes.Length];
                        var pct = c.Progress?.Percentage;
                        var pctStr = pct?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "0";

                        <div class="progress-pastel-card @themeClass" data-course-id="@c.Id">
                            <div class="progress-card-top">
                                <span class="pill-tag pill-tag-purple" style="background:rgba(255,255,255,0.85);">
                                    <partial name="_UiText" model="c.Level" />
                                </span>
                                @if (c.Progress?.CompletedAtUtc is not null)
                                {
                                    <span class="pill-tag pill-tag-mint" style="font-size:11px;">Hoàn thành</span>
                                }
                                else if (c.Progress?.CompletedLessons > 0)
                                {
                                    <span class="pill-tag pill-tag-orange" style="font-size:11px;">Đang học</span>
                                }
                            </div>

                            <div class="progress-card-content">
                                <h3 class="progress-card-title">
                                    <a asp-action="Course" asp-route-id="@c.Id" style="color:inherit; text-decoration:none;">@c.Title</a>
                                </h3>
                                <p class="progress-card-meta">@c.Teacher · @c.LessonCount bài học</p>

                                <div class="progress-track-clean">
                                    <div class="progress-fill-clean" style="width: @pctStr%;"></div>
                                </div>
                                <div class="progress-card-footer">
                                    <span>
                                        @if (c.Progress is { TotalLessons: > 0 } courseProgress)
                                        {
                                            <text>@courseProgress.CompletedLessons/@courseProgress.TotalLessons bài</text>
                                        }
                                        else
                                        {
                                            <text>Chưa có bài học</text>
                                        }
                                    </span>
                                    <strong>@(pct.HasValue ? $"{pct.Value.ToString("0.##")}%" : "—")</strong>
                                </div>
                            </div>

                            <div class="progress-card-action">
                                <a class="button secondary button-small" asp-controller="Homework" asp-action="Course" asp-route-id="@c.Id">Bài tập viết</a>
                                @if (c.Progress is { TotalLessons: > 0, CompletedLessons: > 0 } && c.Progress.CompletedLessons < c.Progress.TotalLessons)
                                {
                                    <a asp-action="Continue" asp-route-id="@c.Id" class="btn-dark-sm">Học tiếp &rarr;</a>
                                }
                                else
                                {
                                    <a asp-action="Course" asp-route-id="@c.Id" class="btn-dark-sm">Vào học &rarr;</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="panel empty" style="border-radius: 20px; padding: 32px; text-align: center; background: #FFFFFF; border: 1px solid var(--v2-border-light);">
                    <p style="font-weight: 600; color: var(--v2-dark); margin-bottom: 8px;">Bạn chưa tham gia khóa học nào.</p>
                    <p class="section-subtitle-clean" style="margin-bottom: 16px;">Hãy khám phá danh mục khóa học để bắt đầu hành trình học tập.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn-dark-sm">Chọn khóa học đầu tiên</a>
                </div>
            }

            @* 4. Hai widget nhỏ: Lộ trình hôm nay & Ôn từ cần đến hạn *@
            <div class="today-compact-widgets-row">
                <!-- Widget Lộ trình hôm nay -->
                <section class="today-compact-widget" aria-labelledby="today-plan-title">
                    <div class="widget-header">
                        <div class="widget-header-title">
                            <span class="widget-icon">🎯</span>
                            <h3 id="today-plan-title">Lộ trình hôm nay</h3>
                        </div>
                        <a asp-controller="LearningPath" asp-action="Index" class="widget-link">Xem chi tiết &rarr;</a>
                    </div>
                    @if (learningPathPage?.Plan is { } plan)
                    {
                        var dayIdx = (localToday.DayNumber - plan.StartDate.DayNumber);
                        var todayItems = plan.Items
                            .Where(i => i.DayIndex == dayIdx && i.Status != EnglishLearningPlatform.Domain.Enums.LearningPlanItemStatus.Skipped)
                            .Take(3)
                            .ToList();
                        if (todayItems.Count > 0)
                        {
                            <ul class="widget-items-list">
                                @foreach (var item in todayItems)
                                {
                                    <li class="widget-item">
                                        <div class="widget-item-info">
                                            <span class="widget-item-title">@item.Title</span>
                                            <span class="widget-item-meta"><partial name="_UiText" model="item.Skill" /> · @item.EstimatedMinutes phút</span>
                                        </div>
                                        @if (item.Status == EnglishLearningPlatform.Domain.Enums.LearningPlanItemStatus.Completed)
                                        {
                                            <span class="pill-tag pill-tag-mint" style="font-size:11px;">Đã xong</span>
                                        }
                                        else
                                        {
                                            switch (item.TargetType)
                                            {
                                                case EnglishLearningPlatform.Domain.Enums.LearningPlanTargetType.Lesson:
                                                    <a asp-action="Lesson" asp-route-id="@item.TargetId" class="button secondary button-small">Học</a>
                                                    break;
                                                case EnglishLearningPlatform.Domain.Enums.LearningPlanTargetType.Practice:
                                                    <a asp-controller="Practice" asp-action="Take" asp-route-id="@item.TargetId" class="button secondary button-small">Luyện</a>
                                                    break;
                                                case EnglishLearningPlatform.Domain.Enums.LearningPlanTargetType.FlashcardDeck:
                                                    <a asp-controller="Flashcards" asp-action="Study" asp-route-id="@item.TargetId" class="button secondary button-small">Ôn từ</a>
                                                    break;
                                            }
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="widget-empty-note">Đã hoàn tất các mục tiêu lộ trình hôm nay! 🎉</p>
                        }
                    }
                    else
                    {
                        <div class="widget-empty-state">
                            <p class="widget-empty-note">Chưa có lộ trình được kích hoạt.</p>
                            <a asp-controller="LearningPath" asp-action="Index" class="btn-dark-sm">Thiết lập lộ trình</a>
                        </div>
                    }
                </section>

                <!-- Widget Ôn từ cần đến hạn -->
                <section class="today-compact-widget" aria-labelledby="today-flashcards-title">
                    <div class="widget-header">
                        <div class="widget-header-title">
                            <span class="widget-icon">🗂️</span>
                            <h3 id="today-flashcards-title">Ôn từ đến hạn</h3>
                        </div>
                        <a asp-controller="Flashcards" asp-action="Index" class="widget-link">Xem bộ thẻ &rarr;</a>
                    </div>
                    @if (dueDecks.Count > 0)
                    {
                        var totalDue = dueDecks.Sum(d => d.DueCount);
                        <div class="widget-due-summary">
                            <span class="widget-due-count">@totalDue</span>
                            <span class="widget-due-label">từ vựng cần ôn hôm nay</span>
                        </div>
                        <ul class="widget-items-list">
                            @foreach (var deck in dueDecks.Take(2))
                            {
                                <li class="widget-item">
                                    <div class="widget-item-info">
                                        <span class="widget-item-title">@deck.Title</span>
                                        <span class="widget-item-meta">@deck.CourseTitle · @deck.DueCount thẻ</span>
                                    </div>
                                    <a asp-controller="Flashcards" asp-action="Study" asp-route-id="@deck.Id" class="button button-small">Ôn ngay</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="widget-empty-state">
                            <p class="widget-empty-note">Không có từ vựng nào cần ôn hôm nay. Tuyệt vời!</p>
                            <a asp-controller="Flashcards" asp-action="Index" class="button secondary button-small">Xem thư viện thẻ</a>
                        </div>
                    }
                </section>
            </div>

            @* 5. Gợi ý theo kỹ năng yếu (chỉ khi có assessment evidence hợp lệ) *@
            <section class="today-recommendations-section" style="margin-top:32px;">
                <div class="clean-section-header">
                    <h2 class="clean-section-title" id="recommendations-title">Kỹ năng cần cải thiện</h2>
                </div>

                @if (Model.Recommendations.Count == 0)
                {
                    <div class="panel empty" style="border-radius:20px; padding:24px; background:#FFFFFF; border:1px solid var(--v2-border-light);">
                        <p style="font-weight:600; color:var(--v2-dark); margin-bottom:6px;">Chưa đủ dữ liệu đánh giá năng lực.</p>
                        <p class="section-subtitle-clean" style="margin-bottom:14px;">Hoàn thành một bài đánh giá năng lực 15 phút để hệ thống chẩn đoán kỹ năng cần ưu tiên cải thiện.</p>
                        <a asp-controller="Assessment" asp-action="Index" class="btn-dark-sm">Làm bài đánh giá</a>
                    </div>
                }
                else
                {
                    <div class="articles-cards-row">
                        @foreach (var recommendation in Model.Recommendations.Take(2))
                        {
                            <article class="article-clean-card">
                                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
                                    <span class="pill-tag pill-tag-orange"><partial name="_UiText" model="recommendation.Skill" /></span>
                                    <strong style="font-size:15px; color:var(--v2-dark);">@recommendation.Score.ToString("0.##")%</strong>
                                </div>
                                <p class="section-subtitle-clean" style="margin:0 0 12px;">
                                    Căn cứ từ bài: <a asp-controller="Assessment" asp-action="Result" asp-route-id="@recommendation.AttemptId">@recommendation.AssessmentTitle</a>
                                </p>
                                @if (recommendation.Contents.Count == 0)
                                {
                                    <p class="section-subtitle-clean" style="margin:0;">Chưa có nội dung phù hợp trong các khóa bạn đã tham gia.</p>
                                }
                                else
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:auto;">
                                        @foreach (var content in recommendation.Contents.Take(2))
                                        {
                                            switch (content.Kind)
                                            {
                                                case RecommendedContentKind.Course:
                                                    <a asp-action="Course" asp-route-id="@content.Id" class="btn-dark-sm">Học: @content.Title</a>
                                                    break;
                                                case RecommendedContentKind.Practice:
                                                    <a asp-controller="Practice" asp-action="Take" asp-route-id="@content.Id" class="btn-dark-sm">Luyện: @content.Title</a>
                                                    break;
                                                case RecommendedContentKind.Assessment:
                                                    <a asp-controller="Assessment" asp-action="Take" asp-route-id="@content.Id" class="btn-dark-sm">Đánh giá: @content.Title</a>
                                                    break;
                                            }
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            @* 6. Khóa học gợi ý cho bạn (CHỈ khi học viên chưa có khóa nào) *@
            @if (Model.Courses.Count == 0 && suggestedCourses.Count > 0)
            {
                <section class="dashboard-discovery" aria-labelledby="suggested-courses-title" style="margin-top:32px;">
                    <div class="clean-section-header">
                        <h2 class="clean-section-title" id="suggested-courses-title">Khóa học gợi ý cho bạn</h2>
                    </div>
                    <p class="section-subtitle-clean">Khám phá nội dung và chọn khóa học phù hợp với bạn.</p>
                    <div class="dashboard-discovery-grid">
                        @foreach (var course in suggestedCourses)
                        {
                            <partial name="_DiscoveryCourseCard" model="course" />
                        }
                    </div>
                    <div class="dashboard-discovery-action" style="margin-top:16px;">
                        <a asp-controller="Courses" asp-action="Index" class="btn-dark-sm">Khám phá khóa học ngay</a>
                    </div>
                </section>
            }
        </div>

        @* =========================================================================
           RIGHT COLUMN: Hoạt động tuần & Kết quả gần đây
           ========================================================================= *@
        <div class="col-secondary-content">
            <!-- Lịch hoạt động tuần này -->
            <div class="calendar-date-card" id="calendar-widget">
                <div class="calendar-header-row">
                    <span class="calendar-month-label">
                        @if (weekDays[0].Month == weekDays[6].Month)
                        {
                            <text>Tháng @weekStart.ToString("MM / yyyy")</text>
                        }
                        else
                        {
                            <text>@weekDays[0].ToString("MM") – @weekDays[6].ToString("MM / yyyy")</text>
                        }
                    </span>
                    <span class="pill-tag pill-tag-purple">Hôm nay</span>
                </div>

                <div class="calendar-strip-row" role="region" aria-label="Lịch tuần này">
                    @for (int i = 0; i < weekDays.Count; i++)
                    {
                        var d = weekDays[i];
                        var isToday = d == localToday;
                        var isSelected = d == selectedDay;
                        var activityCount = activitiesByDay[d].Count();
                        var studiedDay = gamification?.RecentActivityDates.Contains(d) == true;
                        var activityLabel = studiedDay ? "đã ghi nhận ngày học" : $"{activityCount} hoạt động";

                        <button type="button" class="calendar-day-col @(isSelected ? "active" : "") @(isToday ? "is-today" : "")"
                                data-calendar-day="@d.ToString("yyyy-MM-dd")" aria-pressed="@(isSelected ? "true" : "false")"
                                aria-label="@dayNamesVi[i], @d.ToString("dd/MM/yyyy"), @activityLabel"
                                title="@d.ToString("dd/MM/yyyy")">
                            <span class="calendar-day-name">@dayNamesVi[i]</span>
                            <span class="calendar-day-num">@d.Day</span>
                            @if (activityCount > 0 || studiedDay)
                            {
                                <span class="calendar-day-dot" aria-hidden="true"></span>
                            }
                        </button>
                    }
                </div>

                @foreach (var d in weekDays)
                {
                    var activities = activitiesByDay[d].OrderBy(a => a.OccurredAtUtc).ToList();
                    <div class="calendar-day-panel" data-calendar-panel="@d.ToString("yyyy-MM-dd")" hidden="@(d != selectedDay ? "hidden" : null)">
                        <h3 class="calendar-day-panel-title">Hoạt động ngày @d.ToString("dd/MM/yyyy")</h3>
                        @if (activities.Count == 0)
                        {
                            <p class="section-subtitle-clean" style="margin:0;">@(gamification?.RecentActivityDates.Contains(d) == true ? "Đã ghi nhận ngày học cho chuỗi." : "Chưa có hoạt động học tập trong ngày này.")</p>
                        }
                        else
                        {
                            <ul class="calendar-activity-list">
                                @foreach (var activity in activities)
                                {
                                    <li>
                                        <span class="calendar-activity-time">@activity.OccurredAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm")</span>
                                        @switch (activity.Kind)
                                        {
                                            case DashboardActivityKind.LessonCompleted:
                                                @if (activity.CanOpenTarget)
                                                {
                                                    <a asp-action="Lesson" asp-route-id="@activity.TargetId">@activity.Title</a>
                                                }
                                                else
                                                {
                                                    <span>@activity.Title</span>
                                                    <span class="calendar-activity-kind">Bài học hiện không khả dụng</span>
                                                }
                                                <span class="calendar-activity-kind">Hoàn thành bài học</span>
                                                break;
                                            case DashboardActivityKind.PracticeSubmitted:
                                                <a asp-controller="Practice" asp-action="Result" asp-route-id="@activity.TargetId">@activity.Title</a>
                                                <span class="calendar-activity-kind">Nộp bài luyện tập</span>
                                                break;
                                            case DashboardActivityKind.AssessmentFinalized:
                                                <a asp-controller="Assessment" asp-action="Result" asp-route-id="@activity.TargetId">@activity.Title</a>
                                                <span class="calendar-activity-kind">Chấm bài đánh giá</span>
                                                break;
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>

            <!-- Kết quả đánh giá gần đây -->
            <div class="assessment-results-card" id="dashboard-results">
                <div class="clean-section-header" style="margin-top:0; margin-bottom:14px;">
                    <h2 class="clean-section-title" style="font-size:16px;">Kết quả cao nhất</h2>
                    <a asp-controller="Learning" asp-action="Progress" asp-route-tab="assessments" class="btn-outline-dark">
                        Tất cả kết quả &rarr;
                    </a>
                </div>

                @if (Model.Results.Count > 0)
                {
                    @foreach (var res in Model.Results.Take(2))
                    {
                        <div class="result-item-row" data-representative-attempt="@res.AttemptId">
                            <div class="upcoming-title-price">
                                <h3 class="upcoming-course-name">
                                    <a asp-controller="Assessment" asp-action="Result" asp-route-id="@res.AttemptId">@res.Title</a>
                                </h3>
                                <span class="upcoming-course-price" style="color:var(--v2-dark);">@res.OverallScore.ToString("0.##")%</span>
                            </div>
                            <p class="section-subtitle-clean">Điểm cao nhất · <time datetime="@res.FinalizedAtUtc.ToString("O")">@res.FinalizedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time></p>

                            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:8px;">
                                @foreach (var sk in res.Skills)
                                {
                                    <span class="pill-tag @(sk.IsWeak ? "pill-tag-orange" : "pill-tag-purple")">
                                        <partial name="_UiText" model="sk.Skill" />: @sk.Score.ToString("0.##")%
                                    </span>
                                }
                                @if (res.Skills.Count == 0)
                                {
                                    <span class="section-subtitle-clean">Chưa đủ dữ liệu kỹ năng để phân tích.</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="section-subtitle-clean">Chưa có kết quả bài kiểm tra năng lực.</p>
                    <div style="margin-top:12px;">
                        <a asp-controller="Assessment" asp-action="Index" class="btn-dark-sm">
                            Làm bài kiểm tra đầu vào
                        </a>
                    </div>
                }
            </div>

            <!-- Luyện tập gần đây -->
            <section id="dashboard-practice-results" aria-labelledby="dashboard-practice-results-title">
                <div class="clean-section-header" style="margin-top:0; margin-bottom:14px;">
                    <h2 class="clean-section-title" id="dashboard-practice-results-title" style="font-size:16px;">Luyện tập gần đây</h2>
                    @if (Model.PracticeResults.Count > 0)
                    {
                        <a asp-controller="Practice" asp-action="Index" class="btn-outline-dark">
                            Xem tất cả (@Model.PracticeResults.Count)
                        </a>
                    }
                </div>

                @if (Model.PracticeResults.Count == 0)
                {
                    <div class="panel empty" style="border-radius:16px; padding:18px; background:#FFFFFF; border:1px solid var(--v2-border-light);">
                        <p style="font-weight:600; color:var(--v2-dark); margin-bottom:4px; font-size:13.5px;">Bạn chưa nộp bài luyện tập nào.</p>
                        <p class="section-subtitle-clean" style="margin-bottom:10px; font-size:12.5px;">Vào khóa học để luyện tập và xem lời giải chi tiết.</p>
                        <a asp-action="Index" class="btn-dark-sm">Xem khóa học của tôi</a>
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:12px;">
                        @foreach (var practice in Model.PracticeResults.Take(2))
                        {
                            <article class="article-clean-card" style="padding:14px;">
                                <h3 class="article-clean-title" style="font-size:14px;">@practice.Title</h3>
                                <p class="section-subtitle-clean" style="margin-bottom:8px; font-size:12px;">
                                    Điểm đạt: <strong>@practice.Score.ToString("0.##")%</strong> ·
                                    <time datetime="@practice.SubmittedAtUtc.ToString("O")">@practice.SubmittedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</time>
                                </p>
                                <div class="article-clean-meta" style="margin-top:auto;">
                                    <a asp-controller="Practice" asp-action="Result" asp-route-id="@practice.PracticeId" class="btn-dark-sm">Xem lại bài giải</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>
