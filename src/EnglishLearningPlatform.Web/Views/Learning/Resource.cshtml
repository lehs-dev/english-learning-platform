@model ResourceContent
@{ ViewData["Title"] = Model.Title ?? "Nội dung"; }
@section Styles {
    <link rel="stylesheet" href="~/css/lesson-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student-learning.css" asp-append-version="true" />
}

<div class="v2-resource-page learning-screens">
    <header class="resource-page-intro">
        <h1 class="learning-title">Nội dung bài học</h1>
    </header>
    <div class="learning-surface resource-page-card lesson-reader">
        <partial name="_ResourceContent" model="Model" />
    </div>
</div>
