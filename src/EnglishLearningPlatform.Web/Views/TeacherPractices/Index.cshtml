@model EnglishLearningPlatform.Web.Models.Practice.TeacherPracticeIndexViewModel
@{
    ViewData["Title"] = "Bài luyện tập của tôi";
    ViewData["ActiveSection"] = "practices";
    ViewData["PageClass"] = "teacher-practice-page";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Query.Search) || Model.Query.Status.HasValue || Model.Query.CourseId.HasValue;
}
@section Styles { <link rel="stylesheet" href="~/css/teacher-practices.css" asp-append-version="true" /> }

<nav class="practice-breadcrumb" aria-label="Đường dẫn điều hướng"><span>Giảng dạy</span><span aria-hidden="true">/</span><span aria-current="page">Bài luyện tập</span></nav>
<div class="practice-heading">
    <div><h1>Bài luyện tập của tôi</h1><p>Soạn bài, sắp xếp câu hỏi và chuẩn bị nội dung cho học viên.</p></div>
    <a class="button" asp-action="Create"><span aria-hidden="true">+</span> Tạo bài luyện tập</a>
</div>
<section class="practice-intro" aria-labelledby="practice-intro-title">
    <span class="practice-emblem" aria-hidden="true"><svg class="icon"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg></span>
    <div><h2 id="practice-intro-title">Từ ý tưởng đến một bài luyện tập hoàn chỉnh</h2><p>Tạo bản nháp → chọn câu hỏi → xem trước và mở bài.</p></div>
    <a href="#practice-list-title" class="practice-text-link">Xem danh sách <span aria-hidden="true">↓</span></a>
</section>
<section class="practice-card practice-filter-card" aria-label="Tìm và lọc bài luyện tập">
    <form method="get" asp-controller="TeacherPractices" asp-action="Index" class="practice-list-filters" id="practice-filters">
        <input type="hidden" name="PageNumber" value="1" />
        <div class="practice-field practice-search-field"><label for="Search">Tìm bài luyện tập</label><input type="search" id="Search" name="Search" value="@Model.Query.Search" placeholder="Nhập tên bài luyện tập..." /></div>
        <div class="practice-field"><label for="Status">Trạng thái</label>
            <select id="Status" name="Status"><option value="">Tất cả trạng thái</option>
                @foreach (var status in Enum.GetValues<PracticeStatus>())
                { <option value="@status" selected="@(Model.Query.Status == status)"><partial name="_UiText" model="status" /></option> }
            </select>
        </div>
        <div class="practice-field"><label for="CourseId">Khóa học</label><select id="CourseId" name="CourseId" asp-items="Model.CourseOptions"><option value="">Tất cả khóa học</option></select></div>
        <div class="practice-field practice-page-size"><label for="PageSize">Bài / trang</label><input type="number" id="PageSize" name="PageSize" min="1" max="100" required value="@Model.Query.PageSize" /></div>
        <button type="submit" class="button">Tìm / lọc</button>
    </form>
</section>
<div class="practice-section-heading">
    <h2 id="practice-list-title">Danh sách bài luyện tập <span class="practice-count">@Model.Result.TotalCount</span></h2>
    @if (hasFilters) { <a class="practice-text-link" asp-action="Index">Xóa bộ lọc</a> }
</div>
@if (Model.Result.Items.Count == 0)
{
    <section class="practice-card practice-empty">
        <span class="practice-emblem" aria-hidden="true"><svg class="icon"><use href="@Url.Content("~/images/icons.svg#book")"></use></svg></span>
        @if (Model.Result.TotalCount == 0)
        {
            <h2>@(hasFilters ? "Không tìm thấy bài luyện tập phù hợp" : "Tạo bài luyện tập đầu tiên")</h2>
            <p>@(hasFilters ? "Thử từ khóa khác hoặc bỏ bớt bộ lọc để xem thêm bài luyện tập." : "Bắt đầu với một bản nháp, sau đó chọn câu hỏi từ ngân hàng câu hỏi.")</p>
            @if (hasFilters) { <a class="button secondary" asp-action="Index">Xem tất cả bài luyện tập</a> }
            else { <a class="button" asp-action="Create">Tạo bài luyện tập</a> }
        }
        else { <h2>Trang bạn yêu cầu không có bài luyện tập</h2><p>Kết quả hiện có @Model.Result.TotalPages trang. Chọn “Về trang đầu” để tiếp tục.</p> }
    </section>
}
else
{
    <section class="practice-card practice-list-card" aria-labelledby="practice-list-title">
        <div class="table-scroll" role="region" aria-label="Danh sách bài luyện tập" tabindex="0">
            <table class="report-table practice-table">
                <caption class="visually-hidden">Bài luyện tập theo bộ lọc hiện tại. Ngày tạo hiển thị theo UTC.</caption>
                <thead><tr><th scope="col">Bài luyện tập</th><th scope="col">Trạng thái</th><th scope="col">Khóa học và vị trí</th><th scope="col">Số câu</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead>
                <tbody>
                @foreach (var practice in Model.Result.Items)
                {
                    <tr>
                        <td><a class="practice-title-link" asp-controller="TeacherPracticeQuestions" asp-action="Index" asp-route-id="@practice.Id">@practice.Title</a><span class="practice-row-meta">Tạo @practice.CreatedAtUtc.UtcDateTime.ToString("dd/MM/yyyy HH:mm") UTC</span></td>
                        <td><span class="practice-status status-@practice.Status.ToString().ToLowerInvariant()"><partial name="_UiText" model="practice.Status" /></span></td>
                        <td>
                            @if (practice.CourseId.HasValue) { <a class="practice-course-link" asp-controller="TeacherCourses" asp-action="Manage" asp-route-id="@practice.CourseId.Value">@practice.CourseTitle</a> }
                            else { <span class="muted">Chưa gắn khóa học</span> }
                            <span class="practice-row-meta practice-parent">
                                @if (practice.LessonId.HasValue) { <span>Bài học: @practice.LessonTitle</span> }
                                else if (practice.ModuleId.HasValue) { <span>Chương học: @practice.ModuleTitle</span> }
                                else { <span>Chưa chọn vị trí</span> }
                            </span>
                        </td>
                        <td><span class="practice-question-count">@practice.QuestionCount</span></td>
                        <td><div class="practice-row-actions">
                            <a class="button secondary small" asp-controller="TeacherPracticeQuestions" asp-action="Index" asp-route-id="@practice.Id" aria-label="Mở bài luyện tập @practice.Title">Mở bài</a>
                            @if (practice.Status == PracticeStatus.Draft || practice.Status == PracticeStatus.Published)
                            { <a class="practice-preview-link" asp-controller="TeacherPracticePreview" asp-action="Index" asp-route-id="@practice.Id" aria-label="Xem trước @practice.Title"><svg class="icon" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#eye")"></use></svg></a> }
                        </div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
@if (Model.Result.TotalPages > 0)
{
    <nav class="actions pagination practice-pagination" aria-label="Phân trang bài luyện tập">
        @if (Model.Result.PageNumber <= Model.Result.TotalPages)
        {
            @if (Model.Result.PageNumber > 1)
            { <a class="button secondary" asp-action="Index" asp-route-PageNumber="@(Model.Result.PageNumber - 1)" asp-route-PageSize="@Model.Result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status" asp-route-CourseId="@Model.Query.CourseId">← Trang trước</a> }
            <span class="muted">Trang @Model.Result.PageNumber / @Model.Result.TotalPages</span>
            @if (Model.Result.PageNumber < Model.Result.TotalPages)
            { <a class="button secondary" asp-action="Index" asp-route-PageNumber="@(Model.Result.PageNumber + 1)" asp-route-PageSize="@Model.Result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status" asp-route-CourseId="@Model.Query.CourseId">Trang sau →</a> }
        }
        else
        { <a class="button secondary" asp-action="Index" asp-route-PageNumber="1" asp-route-PageSize="@Model.Result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status" asp-route-CourseId="@Model.Query.CourseId">Về trang đầu</a> }
    </nav>
}
