@model EnglishLearningPlatform.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActiveSection"] = "profile";
}
@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="profile-page">
    <div style="margin-bottom: 20px;">
        <a class="button secondary exam-back-btn" asp-controller="Learning" asp-action="Dashboard">
            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            <span>Về bàn học</span>
        </a>
    </div>

    <div class="profile-heading">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <span class="v2-pill-tag">Tài khoản</span>
            <span class="v2-pill-tag" style="background: #FAF9FE; color: var(--v2-text-muted);">Estudy ID</span>
        </div>
        <h1 id="profile-title">Hồ sơ cá nhân</h1>
        <p>Xem và cập nhật thông tin tài khoản học viên của bạn.</p>
    </div>

    <div class="profile-grid">
        <!-- Identity Summary Card -->
        <aside class="profile-card profile-identity">
            <span class="avatar-large" aria-hidden="true">@Model.Initial</span>
            <h2>@Model.FullName</h2>
            <span class="v2-pill-tag" style="background: var(--v2-pastel-periwinkle); color: var(--v2-dark);">@Model.RoleLabel</span>
            <p>@Model.Email</p>
            <div class="profile-status">
                <span class="status-dot"></span>
                <span>@Model.StatusLabel</span>
            </div>
        </aside>

        <!-- Edit Profile Details Card -->
        <div class="profile-card profile-details">
            <h2>Thông tin cá nhân</h2>
            <p class="card-description">Cập nhật họ và tên hiển thị trên chứng chỉ và bảng điểm.</p>
            
            @if (TempData["ProfileSuccessMessage"] is string message)
            {
                <div class="notice" style="margin-bottom: 18px;" role="status">@message</div>
            }

            <form class="account-form" asp-controller="Profile" asp-action="Index" method="post">
                <div class="validation-summary" asp-validation-summary="ModelOnly" role="alert"></div>
                
                <div class="form-field">
                    <label asp-for="FullName">Họ và tên</label>
                    <input asp-for="FullName" autocomplete="name" maxlength="200" aria-describedby="name-error" required />
                    <span asp-validation-for="FullName" id="name-error" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label for="profile-email">Địa chỉ Email (Đăng nhập)</label>
                    <input id="profile-email" type="email" value="@Model.Email" readonly style="background: #F8FAFC; color: var(--v2-text-muted);" />
                </div>

                <dl class="profile-facts">
                    <div>
                        <dt>Vai trò</dt>
                        <dd>@Model.RoleLabel</dd>
                    </div>
                    <div>
                        <dt>Trạng thái</dt>
                        <dd>@Model.StatusLabel</dd>
                    </div>
                    <div>
                        <dt>Tham gia từ</dt>
                        <dd><time datetime="@Model.CreatedAtUtc.ToString("O")" data-local-date>@Model.CreatedAtUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy")</time></dd>
                    </div>
                </dl>

                <div class="profile-form-actions">
                    <button class="button" type="submit" style="padding: 10px 24px;">Lưu thay đổi hồ sơ</button>
                </div>
            </form>
        </div>
    </div>
</div>
