@model EnglishLearningPlatform.Web.Models.QuestionBank.QuestionFormViewModel
@{
    ViewData["Title"] = "Tạo câu hỏi";
    ViewData["PageClass"] = "question-bank-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/question-bank.css" asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <h1>Tạo câu hỏi</h1>
        <p>Soạn câu hỏi, các lựa chọn và phần giải thích đáp án.</p>
    </div>
    <a class="button secondary" asp-controller="TeacherQuestionBank" asp-action="Index"><svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>Quay lại ngân hàng câu hỏi</a>
</div>

<partial name="_Form" model="Model" />

@section Scripts {
    <script src="~/js/question-bank.js" asp-append-version="true" defer></script>
}
