@model EnglishLearningPlatform.Web.Models.QuestionBank.QuestionBankIndexModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
    ViewData["ActiveSection"] = "questionbank";
    ViewData["PageClass"] = "question-bank-page question-bank-index-page";
    var result = Model.Result;
    var firstItem = result.Items.Count == 0 ? 0L : ((long)result.PageNumber - 1) * result.PageSize + 1;
    var lastItem = result.Items.Count == 0 ? 0L : firstItem + result.Items.Count - 1;
    var firstPage = Math.Max(1, Math.Min(result.PageNumber - 2, result.TotalPages - 4));
    var lastPage = Math.Min(result.TotalPages, firstPage + 4);
    int[] pageSizes = [10, 20, 50, 100];
}

@section Styles {
    <link rel="stylesheet" href="~/css/question-bank.css" asp-append-version="true" />
}

<nav class="teacher-breadcrumb" aria-label="Đường dẫn điều hướng"><span>Giảng dạy</span><span aria-hidden="true">/</span><span aria-current="page">Ngân hàng câu hỏi</span></nav>
<div class="page-heading question-bank-heading">
    <div>
        <h1>Ngân hàng câu hỏi</h1>
        <p>Soạn, phân loại và tái sử dụng câu hỏi trong các bài luyện tập và kiểm tra.</p>
    </div>
    <div class="actions">
        <a class="button" asp-controller="TeacherQuestionBank" asp-action="Create"><span aria-hidden="true">+</span> Tạo câu hỏi</a>
        <a class="button secondary" asp-controller="TeacherStimuli" asp-action="Create">Tạo bài đọc và âm thanh</a>
    </div>
</div>

<section class="teacher-intro" aria-labelledby="question-intro-title">
    <span class="teacher-intro-emblem" aria-hidden="true"><svg class="icon"><use href="@Url.Content("~/images/icons.svg#clipboard-check")"></use></svg></span>
    <div><h2 id="question-intro-title">Một thư viện câu hỏi, nhiều cách ôn luyện</h2><p>Soạn nội dung rõ ràng, phân loại theo kỹ năng và trình độ để dễ tìm lại.</p></div>
</section>

<section class="panel question-bank-filters" aria-labelledby="question-filter-title">
    <h2 id="question-filter-title" class="visually-hidden">Tìm và lọc câu hỏi</h2>
    <form asp-controller="TeacherQuestionBank" asp-action="Index" method="get" class="question-bank-filter-form">
        <input type="hidden" name="PageNumber" value="1" />
        <div class="question-filter-search">
            <label for="Search">Từ khóa trong nội dung</label>
            <input type="search" id="Search" name="Search" value="@Model.Query.Search" placeholder="Nhập nội dung cần tìm" />
        </div>
        <div>
            <label for="PrimarySkill">Kỹ năng</label>
            <select id="PrimarySkill" name="PrimarySkill">
                <option value="">Tất cả</option>
                @foreach (var skill in Enum.GetValues<EnglishSkill>())
                {
                    <option value="@skill" selected="@(Model.Query.PrimarySkill == skill)"><partial name="_UiText" model="skill" /></option>
                }
            </select>
        </div>
        <div>
            <label for="Level">Trình độ</label>
            <select id="Level" name="Level">
                <option value="">Tất cả</option>
                @foreach (var level in QuestionLevels.All)
                {
                    <option value="@level" selected="@(Model.Query.Level == level)">@level</option>
                }
            </select>
        </div>
        <div>
            <label for="Status">Trạng thái</label>
            <select id="Status" name="Status">
                <option value="">Tất cả</option>
                @foreach (var status in Enum.GetValues<QuestionStatus>())
                {
                    <option value="@status" selected="@(Model.Query.Status == status)"><partial name="_UiText" model="status" /></option>
                }
            </select>
        </div>
        <div>
            <label for="PageSize">Số câu/trang</label>
            <select id="PageSize" name="PageSize">
                @if (!pageSizes.Contains(Model.Query.PageSize))
                {
                    <option value="@Model.Query.PageSize" selected>@Model.Query.PageSize</option>
                }
                @foreach (var size in pageSizes)
                {
                    <option value="@size" selected="@(Model.Query.PageSize == size)">@size</option>
                }
            </select>
        </div>
        <div class="actions question-filter-actions">
            <button type="submit" class="button">Tìm / lọc</button>
            <a class="button secondary" asp-controller="TeacherQuestionBank" asp-action="Index">Xóa bộ lọc</a>
        </div>
    </form>
</section>

<div class="teacher-results-heading"><h2>Danh sách câu hỏi <span class="teacher-count">@result.TotalCount</span></h2><p class="question-bank-total">@result.Items.Count câu trên trang này</p></div>

@if (result.Items.Count == 0)
{
    <section class="panel question-bank-empty">
        @if (result.TotalCount == 0)
        {
            <h2>Chưa có câu hỏi phù hợp</h2>
            <p>Thử thay đổi bộ lọc hoặc tạo câu hỏi đầu tiên của bạn.</p>
        }
        else
        {
            <h2>Trang này chưa có câu hỏi</h2>
            <p>Kết quả hiện có @result.TotalPages trang. Chọn một trang bên dưới để tiếp tục.</p>
        }
    </section>
}
else
{
    <div class="question-bank-table-wrap" role="region" aria-label="Danh sách câu hỏi" tabindex="0">
        <table class="question-bank-table">
            <caption class="visually-hidden">Nội dung và thuộc tính câu hỏi trong ngân hàng câu hỏi</caption>
            <thead>
                <tr>
                    <th scope="col">Nội dung câu hỏi</th>
                    <th scope="col">Kỹ năng</th>
                    <th scope="col">Trình độ</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="question-option-count">Lựa chọn</th>
                    <th scope="col"><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in result.Items)
                {
                    var statusClass = question.Status switch
                    {
                        QuestionStatus.Published => "is-published",
                        QuestionStatus.Archived => "is-archived",
                        _ => "is-draft"
                    };
                    <tr data-question-row>
                        <td class="question-bank-text"><p class="preserve">@question.Content</p></td>
                        <td><span class="question-skill-badge"><partial name="_UiText" model="question.PrimarySkill" /></span></td>
                        <td class="question-level">@QuestionLevels.Display(question.Level)</td>
                        <td><span class="question-status-badge @statusClass"><partial name="_UiText" model="question.Status" /></span></td>
                        <td class="question-option-count">@question.OptionCount</td>
                        <td>
                            <div class="question-bank-row-actions">
                                <a class="button secondary" asp-controller="TeacherQuestionBank" asp-action="Details" asp-route-id="@question.Id">Xem</a>
                                <a class="button secondary" asp-controller="TeacherQuestionBank" asp-action="Edit" asp-route-id="@question.Id">Sửa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="question-bank-list-footer">
    <p>Hiển thị @firstItem–@lastItem / @result.TotalCount</p>
    @if (result.TotalPages > 0)
    {
        <nav class="question-bank-pagination" aria-label="Phân trang câu hỏi">
            @if (result.PageNumber > 1 && result.PageNumber <= result.TotalPages)
            {
                <a class="button secondary" asp-action="Index" asp-route-PageNumber="@(result.PageNumber - 1)" asp-route-PageSize="@result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-PrimarySkill="@Model.Query.PrimarySkill" asp-route-Level="@Model.Query.Level" asp-route-Status="@Model.Query.Status" aria-label="Trang trước">‹</a>
            }
            @if (firstPage > 1)
            {
                <a class="button secondary" asp-action="Index" asp-route-PageNumber="1" asp-route-PageSize="@result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-PrimarySkill="@Model.Query.PrimarySkill" asp-route-Level="@Model.Query.Level" asp-route-Status="@Model.Query.Status" aria-label="Trang 1">1</a>
                @if (firstPage > 2) { <span class="question-pagination-gap" aria-hidden="true">…</span> }
            }
            @for (var number = firstPage; number <= lastPage; number++)
            {
                if (number == result.PageNumber)
                {
                    <span class="button is-current" aria-current="page" aria-label="Trang @number">@number</span>
                }
                else
                {
                    <a class="button secondary" asp-action="Index" asp-route-PageNumber="@number" asp-route-PageSize="@result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-PrimarySkill="@Model.Query.PrimarySkill" asp-route-Level="@Model.Query.Level" asp-route-Status="@Model.Query.Status" aria-label="Trang @number">@number</a>
                }
            }
            @if (lastPage < result.TotalPages)
            {
                @if (lastPage < result.TotalPages - 1) { <span class="question-pagination-gap" aria-hidden="true">…</span> }
                <a class="button secondary" asp-action="Index" asp-route-PageNumber="@result.TotalPages" asp-route-PageSize="@result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-PrimarySkill="@Model.Query.PrimarySkill" asp-route-Level="@Model.Query.Level" asp-route-Status="@Model.Query.Status" aria-label="Trang @result.TotalPages">@result.TotalPages</a>
            }
            @if (result.PageNumber < result.TotalPages)
            {
                <a class="button secondary" asp-action="Index" asp-route-PageNumber="@(result.PageNumber + 1)" asp-route-PageSize="@result.PageSize" asp-route-Search="@Model.Query.Search" asp-route-PrimarySkill="@Model.Query.PrimarySkill" asp-route-Level="@Model.Query.Level" asp-route-Status="@Model.Query.Status" aria-label="Trang sau">›</a>
            }
        </nav>
    }
</div>
