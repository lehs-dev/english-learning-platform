@model QuestionDetail
@{
    ViewData["Title"] = "Chi tiết câu hỏi";
    ViewData["ActiveSection"] = "questionbank";
    ViewData["PageClass"] = "question-bank-page question-bank-detail-page question-bank-focus-page";
    var statusClass = Model.Status switch
    {
        QuestionStatus.Published => "is-published",
        QuestionStatus.Archived => "is-archived",
        _ => "is-draft"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/question-bank.css" asp-append-version="true" />
}

<div class="page-heading question-detail-heading">
    <div>
        <h1>Chi tiết câu hỏi</h1>
        <p>Thông tin, lựa chọn và đáp án của câu hỏi.</p>
    </div>
    <div class="actions">
        <a class="button" asp-controller="TeacherQuestionBank" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa câu hỏi</a>
        <a class="button secondary" asp-controller="TeacherQuestionBank" asp-action="Index">
            <svg class="icon icon-back" aria-hidden="true"><use href="@Url.Content("~/images/icons.svg#arrow-right")"></use></svg>
            Quay lại ngân hàng câu hỏi
        </a>
    </div>
</div>

<dl class="question-bank-metadata question-detail-summary" aria-label="Thông tin câu hỏi">
    <div>
        <dt>Kỹ năng</dt>
        <dd><span class="question-skill-badge"><partial name="_UiText" model="Model.PrimarySkill" /></span></dd>
    </div>
    <div>
        <dt>Trình độ</dt>
        <dd>@QuestionLevels.Display(Model.Level)</dd>
    </div>
    <div>
        <dt>Trạng thái</dt>
        <dd><span class="question-status-badge @statusClass"><partial name="_UiText" model="Model.Status" /></span></dd>
    </div>
</dl>

<div class="question-detail-grid">
    <div class="question-detail-column">
        <section class="panel question-detail-card question-bank-detail" aria-labelledby="question-content-title">
            <h2 id="question-content-title">Nội dung</h2>
            <p class="preserve question-bank-content">@Model.Content</p>
        </section>

        <section class="panel question-detail-card" aria-labelledby="question-options-title">
            <h2 id="question-options-title">Các lựa chọn</h2>
            <ol class="question-bank-options" type="A" role="list">
                @foreach (var option in Model.Options)
                {
                    <li class="question-bank-option @(option.IsCorrect ? "is-correct" : "")">
                        <span class="question-option-letter" aria-hidden="true"></span>
                        <span class="preserve question-bank-option-content">@option.Content</span>
                        @if (option.IsCorrect)
                        {
                            <strong class="question-bank-correct-label">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>
                                Đáp án đúng
                            </strong>
                        }
                    </li>
                }
            </ol>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Explanation))
        {
            <section class="panel question-detail-card question-bank-explanation" aria-labelledby="question-explanation-title">
                <h2 id="question-explanation-title">Giải thích đáp án</h2>
                <p class="preserve">@Model.Explanation</p>
            </section>
        }
    </div>

    <div class="question-detail-column">
        @if (Model.Stimulus != null)
        {
            <section class="panel question-detail-card question-bank-stimulus" aria-labelledby="question-stimulus-title">
                <h2 id="question-stimulus-title">Bài đọc và âm thanh</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Stimulus.Title))
                {
                    <p class="question-stimulus-title"><strong>Tiêu đề:</strong> @Model.Stimulus.Title</p>
                }
                @if (Model.Stimulus.StimulusType == StimulusType.Passage)
                {
                    <p class="preserve question-stimulus-passage">@Model.Stimulus.ContentText</p>
                }
                else if (Model.Stimulus.StimulusType == StimulusType.Audio)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.Stimulus.ResourceUrl))
                    {
                        <audio controls preload="none" aria-label="@(string.IsNullOrWhiteSpace(Model.Stimulus.Title) ? "Âm thanh của câu hỏi" : Model.Stimulus.Title)" src="@Model.Stimulus.ResourceUrl">
                            Trình duyệt không hỗ trợ phát âm thanh.
                        </audio>
                        <partial name="_ExternalStimulusAudioNotice" model="Model.Stimulus.ResourceUrl" />
                    }
                    else
                    {
                        <p class="question-stimulus-empty">Chưa có đường dẫn âm thanh.</p>
                    }
                }
            </section>
        }

        <section class="panel question-detail-card question-detail-archive" aria-labelledby="question-archive-title">
            <h2 id="question-archive-title">Lưu trữ câu hỏi</h2>
            @if (Model.Status == QuestionStatus.Archived)
            {
                <p>Câu hỏi đã được lưu trữ. Nội dung và dữ liệu lịch sử vẫn được giữ nguyên.</p>
            }
            else
            {
                <p>Sau khi lưu trữ, câu hỏi không được chọn cho bài luyện tập hoặc bài kiểm tra mới. Câu hỏi, các lựa chọn và dữ liệu làm bài đã có không bị xóa.</p>
                <form asp-controller="TeacherQuestionBank" asp-action="Archive" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
                    <button type="submit" class="button secondary">Lưu trữ câu hỏi</button>
                </form>
            }
        </section>
    </div>
</div>
