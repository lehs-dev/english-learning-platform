{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "EnglishLearningPlatform.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "dotnet: test solution",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "EnglishLearningPlatform.sln"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "dotnet: run web",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/EnglishLearningPlatform.Web"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
        "label": "build",
        "command": "dotnet",
        "type": "process",
        "args": [
            "build",
            "${workspaceFolder}/scripts/HandoverExport/HandoverExport.csproj",
            "/property:GenerateFullPaths=true",
            "/consoleloggerparameters:NoSummary;ForceNoAlign"
        ],
        "problemMatcher": "$msCompile"
    },
    {
        "label": "publish",
        "command": "dotnet",
        "type": "process",
        "args": [
            "publish",
            "${workspaceFolder}/scripts/HandoverExport/HandoverExport.csproj",
            "/property:GenerateFullPaths=true",
            "/consoleloggerparameters:NoSummary;ForceNoAlign"
        ],
        "problemMatcher": "$msCompile"
    },
    {
        "label": "watch",
        "command": "dotnet",
        "type": "process",
        "args": [
            "watch",
            "run",
            "--project",
            "${workspaceFolder}/scripts/HandoverExport/HandoverExport.csproj"
        ],
        "problemMatcher": "$msCompile"
    }
  ]
}
