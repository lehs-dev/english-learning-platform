# Copy to .env (ignored), then replace placeholders before startup.
MSSQL_SA_PASSWORD=<set-a-unique-strong-password>
# For dotnet run outside Compose, supply your own connection string via user-secrets/environment.
ConnectionStrings__DefaultConnection=
ELP_SQL_PORT=1433
ELP_WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
LearningDemo__Enabled=false
LearningDemo__Password=
Payments__Enabled=false
CheckoutSandbox__Enabled=false
# VNPay Sandbox: obtain merchant credentials first; never commit the real HashSecret.
Vnpay__Enabled=false
Vnpay__UseIpn=false
Vnpay__TmnCode=
Vnpay__HashSecret=
Vnpay__PublicBaseUrl=
Vnpay__CheckoutMinutes=15
# Keep the browser on the same cookie origin after returning from VNPay.
Vnpay__BrowserBaseUrls__0=http://localhost:8080
Vnpay__BrowserBaseUrls__1=http://127.0.0.1:8080
